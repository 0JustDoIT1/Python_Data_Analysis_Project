:[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["### 월별 히트맵\n","\n","# 연도/월 변수 생성\n","df['year'] = df.index.year\n","df['month'] = df.index.month\n","\n","# 피벗테이블 생성\n","pivot = df.pivot_table(\n","    values = 'violent_rate_working',\n","    index = 'year',\n","    columns = 'month',\n","    aggfunc = 'mean'\n",")\n","# 시각화\n","plt.figure(figsize = (12, 6))\n","\n","sns.heatmap(pivot, annot = True, cmap = 'YlOrRd')\n","plt.title('폭력범죄율 히트맵')\n","plt.xlabel('월')\n","plt.ylabel('연도')\n","\n","plt.yticks(rotation=0)\n","plt.show()\n","\n","# 결과\n","# 여름철 폭력범죄율이 상대적으로 높음 -> 계절성 확인\n","# 2021년 이후 전체 수준이 감소하는 패턴 -> 코로나 이후 구조적 변화 가능성"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":570},"id":"Q1EiPRdWRBP6","executionInfo":{"status":"ok","timestamp":1780285377199,"user_tz":-540,"elapsed":649,"user":{"displayName":"민지영","userId":"10641560045864404899"}},"outputId":"b755cbe5-3391-480c-cb73-66be8663069f"},"execution_count":14,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["### 계절별 범죄율 비교(boxplot)\n","\n","# 계절 변수 생성 (봄:3~5월, 여름:6~8월, 가을 : 9~11월, 겨울: 12~2월)\n","def get_season(month):\n","  if month in [3, 4, 5]:\n","    return '봄'\n","  elif month in [6, 7, 8]:\n","    return '여름'\n","  elif month in [9, 10, 11]:\n","    return '가을'\n","  else:\n","    return '겨울'\n","# 계절 컬럼 생성\n","df['season'] = df['month'].apply(get_season)\n","\n","# 시각화\n","plt.figure(figsize = (10, 6))\n","\n","sns.boxplot(x = 'season', y = 'violent_rate_working', data = df, order = ['봄', '여름', '가을', '겨울'])\n","\n","plt.title('계절별 폭력범죄율 비교')\n","plt.xlabel('계절')\n","plt.ylabel('폭력범죄율')\n","plt.show()\n","\n","\n","# 결과\n","# 여름철의 폭력범죄율이 가장 높음, 겨울철은 전체적으로 낮은 수준 ->고온 환경에서 폭력범죄 발생 가능성이 증가할 수 있음을 시사\n","# 여름철의 경우 분포 범위 또한 상대적으로 넓음 -> 변동성이 큼(폭염, 휴가철, 야외활동 증가 등 다양한 요