  r = df[col].corr(df[TARGET])\n","        else:\n","            r = df[col].shift(lag).corr(df[TARGET])\n","        ccf_vals.append(r)\n","\n","    # 신뢰구간\n","    n = len(df)\n","    conf = 1.96 / np.sqrt(n)\n","\n","    # 막대그래프\n","    colors = ['tomato' if abs(v) > conf else 'steelblue' for v in ccf_vals]\n","    ax.bar(list(lags), ccf_vals, color=colors, alpha=0.7)\n","\n","    # 신뢰구간 선\n","    ax.axhline(conf,  color='gray', linestyle='--', linewidth=1, alpha=0.7)\n","    ax.axhline(-conf, color='gray', linestyle='--', linewidth=1, alpha=0.7)\n","    ax.axhline(0, color='black', linewidth=0.8)\n","    ax.axvline(0, color='black', linewidth=0.5, alpha=0.3)\n","\n","    # 최대 상관 시차 표시\n","    max_lag = list(lags)[np.argmax(np.abs(ccf_vals))]\n","    max_val = ccf_vals[np.argmax(np.abs(ccf_vals))]\n","    ax.annotate(f'최대: lag {max_lag}\\nr={max_val:.3f}',\n","                xy=(max_lag, max_val),\n","                xytext=(max_lag + 2, max_val - 0.1),\n","                fontsize=8,\n","                arrowprops=dict(arrowstyle='->', color='black'))\n","\n","    ax.set_title(f'{label} × 흉악범죄율 CCF', fontsize=10)\n","    ax.set_xlabel('Lag (개월)', fontsize=9)\n","    ax.set_ylabel('교차상관계수', fontsize=9)\n","    ax.grid(True, alpha=0.3)\n","\n","plt.suptitle('기상변수 × 흉악범죄율 CCF 교차상관 분석',\n","             fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":851},"id":"NztjLFGH0G05","executionInfo":{"status":"ok","timestamp":1780133049798,"user_tz":-540,"elapsed":1255,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"251b6f2f-54ed-4a88-e615-5f704d8aff2e"},"execution_count":35,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1200 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#*3-3 교란변수 X 범죄율 관계*"],"metadata":{"id":"ir4OhNyXIiHo"}},{"cell_type":"markdown","source":["### 실업률 vs 범죄율 산점도 | 코로나 전·