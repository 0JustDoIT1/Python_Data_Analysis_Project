rt numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import statsmodels.formula.api as smf\n","\n","# ============================================\n","# STEP 09. 분위수 회귀 (Quantile Regression)\n","# ============================================\n","\n","quantiles = [0.10, 0.25, 0.50, 0.75, 0.90]\n","features  = ['temp_avg', 'unemp_rate', 'covid_dummy']\n","\n","# 데이터 준비\n","data = df[features + [TARGET]].dropna().copy()\n","formula = f\"{TARGET} ~ temp_avg + unemp_rate + covid_dummy\"\n","\n","# 분위수별 회귀 실행\n","qr_results = {}\n","coef_table = []\n","\n","for q in quantiles:\n","    model = smf.quantreg(formula, data).fit(q=q)\n","    qr_results[q] = model\n","    coef_table.append({\n","        '분위수':        f'Q{int(q*100)}',\n","        'temp_avg':     round(model.params['temp_avg'], 4),\n","        'unemp_rate':   round(model.params['unemp_rate'], 4),\n","        'covid_dummy':  round(model.params['covid_dummy'], 4),\n","        'const':        round(model.params['Intercept'], 4),\n","    })\n","\n","coef_df = pd.DataFrame(coef_table).set_index('분위수')\n","print(\"=\" * 60)\n","print(\"📊 분위수별 회귀계수 비교\")\n","print(\"=\" * 60)\n","print(coef_df.to_string())\n","\n","# ============================================\n","# 시각화 1: 분위수별 계수 변화\n","# ============================================\n","fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n","\n","vars_plot = [\n","    ('temp_avg',    '월평균 기온',  'tomato'),\n","    ('unemp_rate',  '실업률',      'steelblue'),\n","    ('covid_dummy', '코로나 더미', 'seagreen'),\n","]\n","\n","q_labels = [f'Q{int(q*100)}' for q in quantiles]\n","\n","for i, (var, label, color) in enumerate(vars_plot):\n","    ax = axes[i]\n","    coefs = [qr_results[q].params[var] for q in quantiles]\n","    cis_low  = [qr_results[q].conf_int().loc[var, 0] for q in quantiles]\n","    cis_high = [qr_results[q].conf_int().loc[var, 1] for q in quantiles]\n","\n","    ax.plot(q_labels, coefs, marker='o', color=color,\n","            linewidth=2, markersize=8, label='계수')\n","    ax.fill_between(q_labels, cis_low, cis_high,\n","                    alpha=0.2, color=color, label='95% CI')\n","    ax.axhline(0, color='black', linestyle='--', linewidth=0.8)\n","\n","    # OLS 계수 비교선\n","    ols_model = smf.ols(formula, data).fit()\n","    ax.axhline(ols_model.params[var], color='gray',\n","               linestyle=':', linewidth=1.5, label='OLS 계수')\n","\n","    ax.set_title(f'{label} 분위수별 계수', fontsize=10)\n","    ax.set_xlabel('분위수')\n","    ax.set_ylabel('회귀계수')\n","    ax.legend(fontsize=8)\n","    ax.grid(True, alpha=0.3)\n","\n","plt.suptitle('분위수 회귀 계수 변화 (Q10~Q90)',\n","             fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()\n","\n","# ============================================\n","# 시각화 2: 분위수별 temp_avg 효과 크기\n","# ============================================\n","fig, ax = plt.subplots(figsize=(10, 5))\n","\n","coefs     = [qr_results[q].params['temp_avg'] for q in quantiles]\n","cis_low   = [qr_results[q].conf_int().loc['temp_avg', 0] for q in quantiles]\n","cis_high  = [qr_results[q].conf_int().loc['temp_avg', 1] for q in quantiles]\n","pvals     = [qr_results[q].pvalues['temp_avg'] for q in quantiles]\n","\n","colors = ['tomato' if p < 0.05 else 'lightgray' for p in pvals]\n","bars = ax.bar(q_labels, coefs, color=colors, alpha=0.8)\n","\n","ax.errorbar(q_labels, coefs,\n","            yerr=[np.array(coefs) - np.array(cis_low),\n","                  np.array(cis_high) - np.array(coefs)],\n","            fmt='none', color='black', capsize=5)\n","\n","# 수치 표기\n","for bar, val, p in zip(bars, coefs, pvals):\n","    sig = '★' if p < 0.05 else ''\n","    ax.text(bar.get_x() + bar.get_width()/2,\n","            val + 0.002,\n","            f'{val:.4f}{sig}',\n","            ha='center', fontsize=9)\n","\n","ax.axhline(0, color='black', linewidth=0.8)\n","ax.axhline(ols_model.params['temp_avg'], color='gray',\n","           linestyle=':', linewidth=1.5, label='OLS 계수')\n","ax.set_title('분위수별 기온(temp_avg) 효과 크기\\n(빨간색=유의 p<0.05, ★=유의)',\n","             fontsize=11)\n","ax.set_xlabel('분위수')\n","ax.set_ylabel('회귀계수')\n","ax.legend(fontsize=9)\n","ax.grid(True, alpha=0.3, axis='y')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# ============================================\n","# 시각화 3: 분위수별 예측값 vs 실제값\n","# ============================================\n","fig, ax = plt.subplots(figsize=(14, 5))\n","\n","ax.scatter(df['date'][data.index], data[TARGET],\n","           color='lightgray', s=15, alpha=0.6, label='실제값')\n","\n","colors_q = ['steelblue', 'seagreen', 'tomato', 'orange', 'purple']\n","for q, color in zip(quantiles, colors_q):\n","    ax.plot(df['date'][data.index],\n","            qr_results[q].fittedvalues,\n","            color=color, linewidth=1.2,\n","            label=f'Q{int(q*100)}')\n","\n","covid = df[df['covid_dummy'] == 1]['date']\n","ax.axvspan(covid.min(), covid.max(),\n","           alpha=0.08, color='gray', label='코로나 구간')\n","\n","ax.set_title('분위수별 예측값 vs 실제 흉악범죄율',\n","             fontsize=11, fontweight='bold')\n","ax.set_xlabel('날짜')\n","ax.set_ylabel(TARGET_LABEL)\n","ax.legend(fontsize=8, loc='upper left')\n","ax.grid(True, alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"lRP-A41TpyBW","executionInfo":{"status":"ok","timestamp":1780133076251,"user_tz":-540,"elapsed":1887,"user":{"displayName":"hee","userId":"11893382154411689325"}},"colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"bac7d417-4a08-4bb5-c381-69fdbd7ba535"},"execution_count":51,"outputs":[{"output_type":"stream","name":"stdout","text":["============================================================\n","📊 분위수별 회귀계수 비교\n","============================================================\n","     temp_avg  unemp_rate  covid_dummy    const\n","분위수                                            \n","Q10    0.1465      0.0960      -0.0085   4.6694\n","Q25    0.1431     -0.0209      -0.1364   5.5336\n","Q50    0.