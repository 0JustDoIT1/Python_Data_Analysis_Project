t print results\n","  warnings.warn(\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["### VAR 기반 Granger 검정"],"metadata":{"id":"-e-1RmJX6R3_"}},{"cell_type":"code","source":["from statsmodels.tsa.api import VAR\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# ============================================\n","# STEP 10-2. VAR 기반 Granger 인과 검정\n","# ============================================\n","# 목적:\n","# 단변량 Granger 이후,\n","# 여러 기상변수를 동시에 고려했을 때도\n","# 기상변수 → 흉악범죄율 예측 관계가 유의한지 확인\n","# ============================================\n","\n","print(\"=\" * 70)\n","print(\"📊 STEP 10-2. VAR 기반 Granger 인과 검정\")\n","print(\"=\" * 70)\n","\n","# --------------------------------------------\n","# 1. VAR 분석용 변수 설정\n","# --------------------------------------------\n","\n","target_diff = 'heinous_diff'\n","\n","final_weather = [\n","    ('temp_avg',        '월평균 기온'),\n","    ('heatwave_days',   '폭염일수'),\n","    ('humidity_avg',    '월평균 습도'),\n","    ('sunshine_hours',  '일조시간'),\n","    ('solar_radiation', '일사량'),\n","    ('precip_mm',       '월 총강수량'),\n","]\n","\n","# 원본 df 복사\n","df_var = df.sort_values('date').copy()\n","\n","# 흉악범죄율 1차 차분\n","df_var[target_diff] = pd.to_numeric(df_var[TARGET], errors='coerce').diff(1)\n","\n","# 기상변수 1차 차분\n","for col, label in final_weather:\n","    df_var[f'{col}_diff'] = pd.to_numeric(df_var[col], errors='coerce').diff(1)\n","\n","# VAR에 사용할 컬럼\n","weather_diff_cols = [f'{col}_diff' for col, _ in final_weather]\n","var_cols = [target_diff] + weather_diff_cols\n","\n","# 결측치 제거\n","df_var_model = df_var[var_cols].replace([np.inf, -np.inf], np.nan).dropna()\n","\n","print(\"VAR 분석 데이터 크기:\", df_var_model.shape)\n","print(\"사용 변수:\", df_var_model.columns.tolist())\n","\n","# --------------------------------------------\n","# 2. 상수 컬럼 제거\n","# --------------------------------------------\n","\n","drop_cols = []\n","\n","for col in df_var_model.columns:\n","    if df_var_model[col].nunique() <= 1:\n","        drop_cols.append(col)\n","\n","if len(drop_cols) > 0:\n","    print(\"상수 컬럼 제거:\", drop_cols)\n","    df_var_model = df_var_model.drop(columns=drop_cols)\n","\n","# 제거 후 변수 재설정\n","weather_diff_cols = [c for c in weather_diff_cols if c in df_var_model.columns]\n","\n","print(\"최종 VAR 변수:\", df_var_model.columns.tolist())\n","\n","# --------------------------------------------\n","# 3. VAR 최적 lag 선택\n","# --------------------------------------------\n","\n","max_lag = 4\n","\n","model = VAR(df_var_model)\n","\n","lag_result = model.select_order(maxlags=max_lag)\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"📌 VAR Lag 선택 결과\")\n","print(\"=\" * 70)\n","print(lag_result.summary())\n","\n","# AIC 기준 lag 선택\n","selected_lag = lag_result.selected_orders['aic']\n","\n","# selected_lag가 0 또는 None이면 1로 보정\n","if selected_lag is None or selected_lag < 1:\n","    selected_lag = 1\n","\n","print(f\"\\n선택된 lag(AIC 기준): {selected_lag}\")\n","\n","# --------------------------------------------\n","# 4. VAR 모델 적합\n","# --------------------------------------------\n","\n","var_result = model.fit(selected_lag)\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"📌 VAR 모델 적합 완료\")\n","print(\"=\" * 70)\n","print(var_result.summary())\n","\n","# --------------------------------------------\n","# 5. 기상변수 전체 묶음 → 흉악범죄율 검정\n","# --------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"📊 VAR Granger 검정: 기상변수 전체 → 흉악범죄율\")\n","print(\"=\" * 70)\n","\n","try:\n","    overall_test = var_result.test_causality(\n","        caused=target_diff,\n","        causing=weather_diff_cols,\n","        kind='f'\n","    )\n","\n","    print(overall_test.summary())\n","    print(f\"\\n기상변수 전체 → 흉악범죄율 p-value: {overall_test.pvalue:.4f}\")\n","\n","    if overall_test.pvalue < 0.05:\n","        print(\"✅ 기상변수 전체는 흉악범죄율 예측에 유의함\")\n","    else:\n","        print(\"❌ 기상변수 전체의 추가 예측력은 유의하지 않음\")\n","\n","except Exception as e:\n","    print(\"전체 기상변수 검정 실패:\", e)\n","\n","# --------------------------------------------\n","# 6. 변수별 VAR Granger 검정\n","# 기상변수 → 흉악범죄율\n","# --------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"📊 변수별 VAR Granger 검정: 기상변수 → 흉악범죄율\")\n","print(\"=\" * 70)\n","\n","var_forward_results = []\n","\n","for col, label in final_weather:\n","    diff_col = f'{col}_diff'\n","\n","    if diff_col not in df_var_model.columns:\n","        continue\n","\n","    try:\n","        test = var_result.test_causality(\n","            caused=target_diff,\n","            causing=[diff_col],\n","            kind='f'\n","        )\n","\n","        p_val = test.pvalue\n","\n","        var_forward_results.append({\n","            '방향': f'{label} → 흉악범죄율',\n","            '변수': label,\n","            'lag': selected_lag,\n","            'p-value': round(p_val, 4),\n","            '판정': '✅ 유의' if p_val < 0.05 else '❌ 비유의'\n","        })\n","\n","        print(f\"{label:15s} → 흉악범죄율  p={p_val:.4f} {'✅' if p_val < 0.05 else '❌'}\")\n","\n","    except Exception as e:\n","        print(f\"{label} 검정 실패:\", e)\n","\n","var_forward_df = pd.DataFrame(var_forward_results)\n","var_forward_df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Y2WvvGkP_Y4-","executionInfo":{"status":"ok","timestamp":1780133077168,"user_tz":-540,"elapsed":361,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"7861955f-62e2-4d2e-df1d-19e305ff4eea"},"execution_count":53,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","📊 STEP 10-2. VAR 기반 Granger 인과 검정\n","======================================================================\n","VAR 분석 데이터 크기: (131, 7)\n","사용 변수: ['heinous_diff', 'temp_avg_diff', 'heatwave_days_diff', 'humidity_avg_diff', '