emp_avg', 'solar_radiation', 'unemp_rate', 'holiday_cnt', 'covid_dummy'],\n","    'Model E (기온+폭염)':\n","        ['temp_avg', 'heatwave_yn', 'unemp_rate', 'holiday_cnt', 'covid_dummy'],\n","    'Model F (전체)':\n","        ['temp_avg', 'humidity_avg', 'solar_radiation',\n","         'precip_mm', 'heatwave_yn', 'temp_above15',\n","         'unemp_rate', 'holiday_cnt', 'covid_dummy'],\n","}\n","\n","y = df[TARGET]\n","results = []\n","\n","for name, features in models.items():\n","    X = df[features].dropna()\n","    y_clean = y[X.index]\n","\n","    X_const = sm.add_constant(X)\n","    model = sm.OLS(y_clean, X_const).fit()\n","\n","    results.append({\n","        '모델':     name,\n","        'R²':      round(model.rsquared, 4),\n","        'Adj R²':  round(model.rsquared_adj, 4),\n","        'AIC':     round(model.aic, 2),\n","        'BIC':     round(model.bic, 2),\n","        'RMSE':    round(np.sqrt(mean_squared_error(y_clean, model.fittedvalues)), 4),\n","        'MAE':     round(mean_absolute_error(y_clean, model.fittedvalues), 4),\n","    })\n","\n","result_df = pd.DataFrame(results).set_index('모델')\n","print(\"=\" * 70)\n","print(\"📊 모델 성능 비교\")\n","print(\"=\" * 70)\n","print(result_df.to_string())\n","\n","# 최적 모델 선정\n","best_model_name = result_df['Adj R²'].idxmax()\n","print(f\"\\n✅ 최적 모델: {best_model_name}\")\n","print(f\"   Adj R² = {result_df.loc[best_model_name, 'Adj R²']}\")\n","\n","# 최적 모델 상세 결과\n","best_features = models[best_model_name]\n","X_best = df[best_features].dropna()\n","y_best = y[X_best.index]\n","X_best_const = sm.add_constant(X_best)\n","best_model = sm.OLS(y_best, X_best_const).fit()\n","print(\"\\n\" + \"=\" * 70)\n","print(f\"📋 {best_model_name} 상세 결과\")\n","print(\"=\" * 70)\n","print(best_model.summary())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"X8ZO56nTUHbY","executionInfo":{"status":"ok","timestamp":1780133062187,"user_tz":-540,"elapsed":1902,"user":{"displayName":"hee","userId":"11893382154411689325"