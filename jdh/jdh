088044338,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          0.19736567088044338,\n          0.1916201656765516,\n          0.010523628000608938\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":77}]},{"cell_type":"markdown","source":["- 흉악 범죄율 예측 -> 계절성이 가장 강하게 작동\n","- 기상변수 : 일사량, 폭염일수, 기온이 상대적으로 중요한 변수로 확인됨"],"metadata":{"id":"wxkmEjrbJ2Ct"}},{"cell_type":"markdown","source":["#*13 예측 모델링*"],"metadata":{"id":"f45I8iQ1KCoZ"}},{"cell_type":"code","source":["# ============================================\n","# STEP 13. 예측 모델링\n","# ARIMA / SARIMAX / Prophet\n","# 폭력·흉악·재산범죄 각각 총 9개 모델\n","# ============================================\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","from statsmodels.tsa.statespace.sarimax import SARIMAX\n","from sklearn.metrics import mean_absolute_error, mean_squared_error\n","\n","print(\"=\" * 70)\n","print(\"📊 STEP 13. 예측 모델링\")\n","print(\"=\" * 70)\n","\n","df_pred = df.sort_values('date').copy()\n","df_pred['date'] = pd.to_datetime(df_pred['date'])\n","df_pred = df_pred.set_index('date')\n","\n","# 월별 데이터 주기 설정\n","df_pred = df_pred.asfreq('MS')\n","\n","# 예측 대상 3개\n","target_list = [\n","    ('violent_rate_working', '폭력범죄율'),\n","    ('heinous_rate_working', '흉악범죄율'),\n","    ('property_rate_working', '재산범죄율')\n","]\n","\n","# SARIMAX / Prophet에 사용할 외생변수\n","exog_vars = [\n","    'temp_avg',\n","    'heatwave_days',\n","    'humidity_avg',\n","    'sunshine_hours',\n","    'solar_radiation',\n","    'precip_mm',\n","    'unemp_rate',\n","    'holiday_cnt',\n","    'covid_dummy'\n","]\n","\n","# 실제 존재하는 변수만 사용\n","exog_vars = [col for col in exog_vars if col in df_pred.columns]\n","\n","print(\"예측 대상:\", [x[1] for x in target_list])\n","print(\"외생변수:\", exog_vars)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bPUxJ53FKBAL","executionInfo":{"status":"ok","timestamp":1780133091039,"user_tz":-540,"elapsed":5,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"53c4d5f9-531b-4f68-bed9-88e556a0582a"},"execution_count":78,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","📊 STEP 13. 예측 모델링\n","======================================================================\n","예측 대상: ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","외생변수: ['temp_avg', 'heatwave_days', 'humidity_avg', 'sunshine_hours', 'solar_radiation', 'precip_mm', 'unemp_rate', 'holiday_cnt', 'covid_dummy']\n"]}]},{"cell_type":"code","source":["# ============================================\n","# 성능지표 함수\n","# ============================================\n","\n","def mean_absolute_percentage_error(y_true, y_pred):\n","    y_true = np.array(y_true)\n","    y_pred = np.array(y_pred)\n","\n","    # 0 나눗셈 방지\n","    mask = y_true != 0\n","    return np.mean(np.abs((y_true[mask] - y_pred[mask]) / y_true[mask])) * 100\n","\n","\n","def get_metrics(y_true, y_pred):\n","    mae = mean_absolute_error(y_true, y_pred)\n","    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n","    mape = mean_absolute_percentage_error(y_true, y_pred)\n","\n","    return mae, rmse, mape"],"metadata":{"id":"gt3kk8roKJje","executionInfo":{"status":"ok","timestamp":1780133091042,"user_tz":-540,"elapsed":2,"user":{"displayName":"hee","userId":"11893382154411689325"}}},"execution_count":79,"outputs":[]},{"cell_type":"code","source":["!pip install prophet -q"],"metadata":{"id":"WCdJCeXXKMPW","executionInfo":{"status":"ok","timestamp":1780133095636,"user_tz":-540,"elapsed":4595,"user":{"displayName":"hee","userId":"11893382154411689325"}}},"execution_count":80,"outputs":[]},{"cell_type":"code","source":["from prophet import Prophet"],"metadata":{"id":"-EOJpbjmKMgP","executionInfo":{"status":"ok","timestamp":1780133096049,"user_tz":-540,"elapsed":412,"user":{"displayName":"hee","userId":"11893382154411689325"}}},"execution_count":81,"outputs":[]},{"cell_type":"code","source":["# ============================================\n","# STEP 13-1. 3개 범죄유형 × 3개 모델 예측\n","# ============================================\n","\n","model_results = []\n","forecast_store = {}\n","\n","for target_col, target_label in target_list:\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(f\"📌 예측 대상: {target_label}\")\n","    print(\"=\" * 70)\n","\n","    # 분석 데이터 구성\n","    use_cols = [target_col] + exog_vars\n","    temp = df_pred[use_cols].replace([np.inf, -np.inf], np.nan).dropna()\n","\n","    y = temp[target_col]\n","    X = temp[exog_vars]\n","\n","    # train/test 분리: 앞 80%, 뒤 20%\n","    split_idx = int(len(temp) * 0.8)\n","\n","    y_train = y.iloc[:split_idx]\n","    y_test = y.iloc[split_idx:]\n","\n","    X_train = X.iloc[:split_idx]\n","    X_test = X.iloc[split_idx:]\n","\n","    test_index = y_test.index\n","\n","    # --------------------------------------------\n","    # 1) ARIMA\n","    # --------------------------------------------\n","    try:\n","        arima_model = SARIMAX(\n","            y_train,\n","            order=(1, 1, 1),\n","            seasonal_order=(0, 0, 0, 0),\n","            enforce_stationarity=False,\n","            enforce_invertibility=False\n","        )\n","\n","        arima_fit = arima_model.fit(disp=False)\n","        arima_pred = arima_fit.forecast(steps=len(y_test))\n","\n","        mae, rmse, mape = get_metrics(y_test, arima_pred)\n","\n","        model_results.append({\n","            '범죄유형': target_label,\n","            '모델': 'ARIMA',\n","            'MAE': round(mae, 4),\n","            'RMSE': round(rmse, 4),\n","            'MAPE': round(mape, 2)\n","        })\n","\n","        forecast_store[(target_label, 'ARIMA')] = pd.DataFrame({\n","            'date': test_index,\n","            'actual': y_test.values,\n","            'pred': arima_pred.values\n","        })\n","\n","        print(f\"ARIMA 완료 | MAE={mae:.4f}, RMSE={rmse:.4f}, MAPE={mape:.2f}%\")\n","\n","    except Exception as e:\n","        print(\"ARIMA 실패:\", e)\n","\n","    # --------------------------------------------\n","    # 2) SARIMAX\n","    # --------------------------------------------\n","    try:\n","        sarimax_model = SARIMAX(\n","            y_train,\n","            exog=X_train,\n","            order=(1, 1, 1),\n","            seasonal_order=(1, 0, 1, 12),\n","            enforce_stationarity=False,\n","            enforce_invertibility=False\n","        )\n","\n","        sarimax_fit = sarimax_model.fit(disp=False)\n","        sarimax_pred = sarimax_fit.forecast(\n","            steps=len(y_test),\n","            exog=X_test\n","        )\n","\n","        mae, rmse, mape = get_metrics(y_test, sarimax_pred)\n","\n","        model_results.append({\n","            '범죄유형': target_label,\n","            '모델': 'SARIMAX',\n","            'MAE': round(mae, 4),\n","            'RMSE': round(rmse, 4),\n","            'MAPE': round(mape, 2)\n","        })\n","\n","        forecast_store[(target_label, 'SARIMAX')] = pd.DataFrame({\n","            'date': test_index,\n","            'actual': y_test.values,\n","            'pred': sarimax_pred.values\n","        })\n","\n","        print(f\"SARIMAX 완료 | MAE={mae:.4f}, RMSE={rmse:.4f}, MAPE={mape:.2f}%\")\n","\n","    except Exception as e:\n","        print(\"SARIMAX 실패:\", e)\n","\n","    # --------------------------------------------\n","    # 3) Prophet\n","    # --------------------------------------------\n","    try:\n","        prophet_train = temp.iloc[:split_idx].reset_index()\n","        prophet_test = temp.iloc[split_idx:].reset_index()\n","\n","        prophet_train = prophet_train.rename(columns={\n","            'date': 'ds',\n","            target_col: 'y'\n","        })\n","\n","        prophet_test = prophet_test.rename(columns={\n","            'date': 'ds',\n","            target_col: 'y'\n","        })\n","\n","        prophet_model = Prophet(\n","            yearly_seasonality=True,\n","            weekly_seasonality=False,\n","            daily_seasonality=False\n","        )\n","\n","        # 외생변수 추가\n","        for reg in exog_vars:\n","            prophet_model.add_regressor(reg)\n","\n","        prophet_model.fit(prophet_train[['ds', 'y'] + exog_vars])\n","\n","        prophet_pred_df = prophet_model.predict(\n","            prophet_test[['ds'] + exog_vars]\n","        )\n","\n","        prophet_pred = prophet_pred_df['yhat'].values\n","\n","        mae, rmse, mape = get_metrics(prophet_test['y'], prophet_pred)\n","\n","        model_results.append({\n","            '범죄유형': target_label,\n","            '모델': 'Prophet',\n","            'MAE': round(mae, 4),\n","            'RMSE': round(rmse, 4),\n","            'MAPE': round(mape, 2)\n","        })\n","\n","        forecast_store[(target_label, 'Prophet')] = pd.DataFrame({\n","            'date': prophet_test['ds'],\n","            'actual': prophet_test['y'].values,\n","            'pred': prophet_pred\n","        })\n","\n","        print(f\"Prophet 완료 | MAE={mae:.4f}, RMSE={rmse:.4f}, MAPE={mape:.2f}%\")\n","\n","    except Exception as e:\n","        print(\"Prophet 실패:\", e)\n","\n","# 결과표\n","model_result_df = pd.DataFrame(model_results)\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"📌 예측 모델 성능 비교표\")\n","print(\"=\" * 70)\n","\n","model_result_df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":791},"id":"YtIzmNVOKOto","executionInfo":{"status":"ok","timestamp":1780133103332,"user_tz":-540,"elapsed":7281,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"9185a2b2-3427-46e5-9761-e6158ff7449f"},"execution_count":82,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================================================\n","📌 예측 대상: 폭력범죄율\n","======================================================================\n","ARIMA 완