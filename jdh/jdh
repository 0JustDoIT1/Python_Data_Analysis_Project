,"        if 'temp_avg' in exog_vars:\n","            scenarios['+1℃']['temp_avg'] = scenarios['+1℃']['temp_avg'] + 1\n","            scenarios['+2℃']['temp_avg'] = scenarios['+2℃']['temp_avg'] + 2\n","\n","        for scenario_name, scenario_X in scenarios.items():\n","\n","            pred = sarimax_fit.forecast(\n","                steps=len(y_test),\n","                exog=scenario_X\n","            )\n","\n","            scenario_results.append({\n","                '범죄유형': target_label,\n","                '시나리오': scenario_name,\n","                '평균예측범죄율': round(pred.mean(), 4),\n","                '최대예측범죄율': round(pred.max(), 4),\n","                '최소예측범죄율': round(pred.min(), 4)\n","            })\n","\n","            print(f\"{scenario_name}: 평균예측={pred.mean():.4f}\")\n","\n","    except Exception as e:\n","        print(f\"{target_label} 시나리오 분석 실패:\", e)\n","\n","scenario_df = pd.DataFrame(scenario_results)\n","\n","scenario_df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":717},"id":"BSTNuWGfKU1u","executionInfo":{"status":"ok","timestamp":1780133111208,"user_tz":-540,"elapsed":4021,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"85665a90-9859-4bd0-c47f-40dee6a82b9d"},"execution_count":87,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================================================\n","📌 폭염 심화 시나리오: 폭력범죄율\n","======================================================================\n","평년: 평균예측=43.5645\n","+1℃: 평균예측=43.7557\n","+2℃: 평균예측=43.9468\n","\n","======================================================================\n","📌 폭염 심화 시나리오: 흉악범죄율\n","======================================================================\n","평년: 평균예측=11.6045\n","+1℃: 평균예측=11.6598\n","+2℃: 평균예측=11.7151\n","\n","======================================================================\n","📌 폭염 심화 시나리오: 재산범죄율\n","======================================================================\n","