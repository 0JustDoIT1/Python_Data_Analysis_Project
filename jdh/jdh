lag=max_lag,\n","            verbose=False\n","        )\n","\n","        # lag별 p-value 추출\n","        for lag in range(1, max_lag+1):\n","            p_val = gc_result[lag][0]['ssr_ftest'][1]\n","            results.append({\n","                '변수':    label,\n","                'lag':    lag,\n","                'p-value': round(p_val, 4),\n","                '판정':   '✅ 유의' if p_val < 0.05 else '❌ 기각'\n","            })\n","\n","        # 최소 p-value 출력\n","        min_p = min([gc_result[l][0]['ssr_ftest'][1] for l in range(1, max_lag+1)])\n","        print(f\"{label:15s} → 흉악범죄율  최소 p={min_p:.4f} {'✅' if min_p < 0.05 else '❌'}\")\n","\n","    except Exception as e:\n","        print(f\"{label} 실패: {e}\")\n","\n","# 역방향 검정 (범죄 → 기상)\n","print(\"\\n\" + \"=\" * 65)\n","print(\"📊 역방향 Granger 검정 (흉악범죄율 → 기상변수)\")\n","print(\"=\" * 65)\n","\n","for col, label in final_weather:\n","    diff_col = f'{col}_diff'\n","    data_pair = df[[diff_col, 'heinous_diff']].dropna()\n","\n","    try:\n","        gc_result = grangercausalitytests(\n","            data_pair[[diff_col, 'heinous_diff']],\n","            maxlag=max_lag,\n","            verbose=False\n","        )\n","        min_p = min([gc_result[l][0]['ssr_ftest'][1] for l in range(1, max_lag+1)])\n","        print(f\"흉악범죄율 → {label:15s}  최소 p={min_p:.4f} {'✅ 역방향 유의!' if min_p < 0.05 else '❌ 역방향 기각'}\")\n","\n","    except Exception as e:\n","        print(f\"{label} 실패: {e}\")\n","\n","# ============================================\n","# 시각화: lag별 p-value 히트맵\n","# ============================================\n","result_df = pd.DataFrame(results)\n","pivot = result_df.pivot(index='변수', columns='lag', values='p-value')\n","pivot.columns = [f'lag {c}' for c in pivot.columns]\n","\n","fig, ax = plt.subplots(figsize=(10, 6))\n","import seaborn as sns\n","\n","sns.heatmap(\n","    pivot,\n","    annot=True,\n","    fmt='.3f',\n","    cmap='RdYlGn_r',\n","    center=0.05,\n","    vmin=0, vmax=0.2,\n","    linewidths=0.5,\n