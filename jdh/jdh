 5))\n","\n","# --- 왼쪽: Histogram + KDE + 정규분포 비교 ---\n","ax1 = axes[0]\n","sns.histplot(data=df, x=TARGET, kde=True, ax=ax1,\n","             color='steelblue', alpha=0.6, bins=15)\n","\n","# 정규분포 이론선 추가\n","mu, std = df[TARGET].mean(), df[TARGET].std()\n","x = np.linspace(df[TARGET].min(), df[TARGET].max(), 100)\n","p = stats.norm.pdf(x, mu, std) * len(df) * (df[TARGET].max() - df[TARGET].min()) / 15\n","ax1.plot(x, p, 'r--', linewidth=2, label='정규분포 이론선')\n","\n","# 왜도/첨도 텍스트 삽입\n","skew = df[TARGET].skew()\n","kurt = df[TARGET].kurt()\n","ax1.text(0.97, 0.95, f'왜도: {skew:.3f}\\n첨도: {kurt:.3f}',\n","         transform=ax1.transAxes, ha='right', va='top',\n","         bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))\n","\n","ax1.axvline(mu, color='red', linestyle='-', alpha=0.7, label=f'평균 {mu:.2f}')\n","ax1.legend()\n","ax1.set_title('흉악범죄율 분포 (정규성 확인)')\n","ax1.set_xlabel('흉악범죄율')\n","ax1.set_ylabel('빈도')\n","\n","# --- 오른쪽: Q-Q Plot ---\n","ax2 = axes[1]\n","(osm, osr), (slope, intercept, r) = stats.probplot(df[TARGET])\n","ax2.scatter(osm, osr, color='steelblue', alpha=0.6, s=20)\n","ax2.plot(osm, slope * np.array(osm) + intercept, 'r--', linewidth=2)\n","ax2.set_title(f'Q-Q Plot (R²={r**2:.4f})')\n","ax2.set_xlabel('이론적 분위수')\n","ax2.set_ylabel('실제 분위수')\n","ax2.grid(True, alpha=0.3)\n","\n","plt.suptitle('흉악범죄율 정규성 검토', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":363},"id":"WFE2F1NKQppL","executionInfo":{"status":"ok","timestamp":1780133037582,"user_tz":-540,"elapsed":522,"user":{"displayName":"hee","userId":"11893382154411689325"}},"outputId":"0a06f2cf-816d-4626-9124-949d11551323"},"execution_count":15,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#*STEP 1-2 기상변수 (독립변수)*"],"metadata":{"id":"r-yUGhouetak"}},{"cell_type":"markd