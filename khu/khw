.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":471},"id":"r7eHnZfbboKO","executionInfo":{"status":"ok","timestamp":1780133647047,"user_tz":-540,"elapsed":496,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"2e451e0d-5c40-44bd-b800-9bc605e5bf02"},"execution_count":24,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# 시계열 데이터의 안정성 검정 (Stationarity Test)\n","from statsmodels.tsa.stattools import adfuller, kpss\n","import warnings\n","warnings.filterwarnings('ignore') # KPSS 시차 관련 경고문 숨기기\n","\n","# 수정된 교차 검정 함수\n","def stationarity_cross_test(series, name):\n","    # 1. ADF 검정 (귀무가설: 비정상 시계열 / 단위근 존재)\n","    adf_res = adfuller(series.dropna())\n","    adf_stat = adf_res[0]\n","    adf_p = adf_res[1]\n","\n","    # 2. KPSS 검정 (귀무가설: 정상 시계열 / 단위근 없음)\n","    kpss_res = kpss(series.dropna(), regression='c', nlags=\"auto\")\n","    kpss_stat = kpss_res[0]\n","    kpss_p = kpss_res[1]\n","\n","    print(f'\\n=== {name} 정상성 교차 검정 ===')\n","    print(f'1) ADF Test  -> Statistic: {adf_stat:.4f} | p-value: {adf_p:.4f}')\n","    print(f'2) KPSS Test -> Statistic: {kpss_stat:.4f} | p-value: {kpss_p:.4f}')\n","    print('-' * 45)\n","\n","    # 3. 계획서 기반 교차 판정 알고리즘\n","    if adf_p < 0.05 and kpss_p >= 0.05:\n","        print(\"➡ 판정: 확실한 정상 시계열 (Stationary)\")\n","    elif adf_p >= 0.05 and kpss_p < 0.05:\n","        print(\"➡ 판정: 확실한 비정상 시계열 (Non-Stationary) -> [3-2단계 차분 필요]\")\n","    elif adf_p < 0.05 and kpss_p < 0.05:\n","        print(\"➡ 판정: 추세 정상성 (Trend Stationary) -> [3-3단계 STL 분해 권장]\")\n","    else:\n","        print(\"➡ 판정: 의사 정상성 / 판정 불가 (Indeterminate)\")\n","\n","\n","# =========================================================\n","# 계획서 지정 4대 핵심 변수 검정 실행\n","# =========================================================\n","\n","target_vars = {\n","    'property_rate_working': 'property_rate_working (재산범죄율)',\n","    'heat_index': 'heat_index (불쾌지수)',\n","    'precip_mm': 'precip_mm (강수량)',\n","    'unemp_rate': 'unemp_rate (실업률)'\n","}\n","\n","for col, display_name in target_vars.items():\n","    if col in df.columns:\n","        stationarity_cross_test(df[col], display_name)\n","    else:\n","        print(f\"\\n⚠️ 경고: 데이터프레임에 [{col}] 변수가 없습니다.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"okGYbh08boO1","executionInfo":{"status":"ok","timestamp":1780133647274,"user_tz":-540,"elapsed":225,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"0702fd75-1aa7-4b36-afea-2f3759585122"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","=== property_rate_working (재산범죄율) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: 0.2241 | p-value: 0.9736\n","2) KPSS Test -> Statistic: 1.0632 | p-value: 0.0100\n","---------------------------------------------\n","➡ 판정: 확실한 비정상 시계열 (Non-Stationary) -> [3-2단계 차분 필요]\n","\n","=== heat_index (불쾌지수) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -0.2594 | p-value: 0.9311\n","2) KPSS Test -> Statistic: 0.0266 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 의사 정상성 / 판정 불가 (Indeterminate)\n","\n","=== precip_mm (강수량) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -2.3687 | p-value: 0.1508\n","2) KPSS Test -> Statistic: 0.1277 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 의사 정상성 / 판정 불가 (Indeterminate)\n","\n","=== unemp_rate (실업률) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -1.0698 | p-value: 0.7270\n","2) KPSS Test -> Statistic: 1.0130 | p-value: 0.0100\n","---------------------------------------------\n","➡ 판정: 확실한 비정상 시계열 (Non-Stationary) -> [3-2단계 차분 필요]\n"]}]},{"cell_type":"code","source":["# 차분(Differencing) 연산을 통한 추세 제거\n","df['property_diff']     = df['property_rate_working'].diff()\n","df['heat_index_diff']   = df['heat_index'].diff()\n","df['precip_diff']       = df['precip_mm'].diff()\n","df['unemp_diff']        = df['unemp_rate'].diff()\n","\n","\n","# =========================================================\n","# 2. 원계열 vs 차분 계열 데이터 시각화 (추세 및 변동성 제거 확인)\n","# =========================================================\n","# 4대 변수의 원데이터와 1차 차분 데이터의 트렌드 변화를 비교합니다.\n","\n","diff_pairs = [\n","    ('property_rate_working', 'property_diff', 'Property Crime Rate', 'orange'),\n","    ('heat_index', 'heat_index_diff', 'Heat Index', 'red'),\n","    ('precip_mm', 'precip_diff', 'Precipitation', 'blue'),\n","    ('unemp_rate', 'unemp_diff', 'Unemployment Rate', 'purple')\n","]\n","\n","fig, axes = plt.subplots(4, 2, figsize=(18, 16), sharex=False)\n","\n","for i, (orig_col, diff_col, title_name, color) in enumerate(diff_pairs):\n","    # 왼쪽 컬럼: 원계열 (Original Series)\n","    axes[i, 0].plot(df.index, df[orig_col], color='gray', alpha=0.8, linewidth=1.5)\n","    axes[i, 0].set_title(f'{title_name} - Original')\n","    axes[i, 0].grid(alpha=0.3)\n","\n","    # 오른쪽 컬럼: 1차 차분 계열 (1st Differencing Series)\n","    axes[i, 1].plot(df.index, df[diff_col], color=color, linewidth=1.5)\n","    axes[i, 1].axhline(0, color='black', linestyle='--', alpha=0.5) # 기준선 0 추가\n","    axes[i, 1].set_title(f'{title_name} - 1st Difference ({diff_col})')\n","    axes[i, 1].grid(alpha=0.3)\n","\n","plt.suptitle('Comparison of Original and 1st Differenced Series', y=1.01, fontsize=16, fontweight='bold')\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================================================\n","# 3. 차분 후 정상성 확보 여부 재확인 (ADF + KPSS 교차 검정)\n","# =========================================================\n","# 앞선 3-1단계에서 정의한 stationarity_cross_test 함수를 재호출합니다.\n","# 차분으로 인해 발생한 첫 행의 NaN 값은 함수 내부의 .dropna()에 의해 자동 처리됩니다.\n","\n","print(\"\\n\" + \"=\"*60)\n","print(\"⚙️ 1차 차분 변수 대상 정상성 재검정 (Re-testing Stationarity)\")\n","print(\"=\"*60)\n","\n","diff_target_vars = {\n","    'property_diff': 'Property Crime Rate Diff (재산범죄율 차분)',\n","    'heat_index_diff': 'Heat Index Diff (불쾌지수 차분)',\n","    'precip_diff': 'Precipitation Diff (강수량 차분)',\n","    'unemp_diff': 'Unemployment Rate Diff (실업률 차분)'\n","}\n","\n","for col, display_name in diff_target_vars.items():\n","    if col in df.columns:\n","        stationarity_cross_test(df[col], display_name)\n","    else:\n","        print(f\"⚠️ [{col}] 변수가 데이터프레임에 존재하지 않습니다.\")"],"metadata":{"id":"vf3xcyRBboTN","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1780133651256,"user_tz":-540,"elapsed":3979,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"a212f19b-3055-41b3-a2b4-ea4cb890378a"},"execution_count":26,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1600 with 8 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","============================================================\n","⚙️ 1차 차분 변수 대상 정상성 재검정 (Re-testing Stationarity)\n","============================================================\n","\n","=== Property Crime Rate Diff (재산범죄율 차분) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -2.6844 | p-value: 0.0768\n","2) KPSS Test -> Statistic: 0.0199 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 의사 정상성 / 판정 불가 (Indeterminate)\n","\n","=== Heat Index Diff (불쾌지수 차분) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -10.7641 | p-value: 0.0000\n","2) KPSS Test -> Statistic: 0.0305 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n","\n","=== Precipitation Diff (강수량 차분) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -10.4768 | p-value: 0.0000\n","2) KPSS Test -> Statistic: 0.0236 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n","\n","=== Unemployment Rate Diff (실업률 차분) 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -2.8896 | p-value: 0.0466\n","2) KPSS Test -> Statistic: 0.0378 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n"]}]},{"cell_type":"code","source":["# STL 분해(Seasonal-Trend Decomposition)\n","from statsmodels.tsa.seasonal import STL\n","\n","# =========================================================\n","# 1. STL 분해 대상 변수 및 가독성 레이블 지정\n","# =========================================================\n","# 계획서에 명시된 재산범죄율과 주요 기상 변수들을 매핑합니다.\n","stl_target_vars = {\n","    'property_rate_working': 'Property Crime Rate (재산범죄율)',\n","    'heat_index': 'Heat Index (불쾌지수)',\n","    'precip_mm': 'Precipitation (강수량)'\n","}\n","\n","# =========================================================\n","# 2. 변수별 STL 분해 실행 및 결과 저장 (Looping)\n","# =========================================================\n","print(\"⚙️ 변수별 STL 분해(Seasonal-Trend Decomposition) 및 파생변수 생성 중...\")\n","\n","for col, display_name in stl_target_vars.items():\n","    if col not in df.columns:\n","        print(f\"⚠️ 경고: 데이터프레임에 [{col}] 변수가 없습니다. 건너뜁니다.\")\n","        continue\n","\n","    # 결측치 처리 후 STL 분해 실행 (월별 데이터이므로 period=12 고정)\n","    series_clean = df[col].dropna()\n","\n","    # robust=True 옵션은 이상치(Outlier)의 영향을 줄여 결합 구조를 안정화합니다.\n","    stl = STL(series_clean, period=12, robust=True)\n","    res = stl.fit()\n","\n","    # 계획서 요구사항에 맞춘 파생변수 자동 할당\n","    df[f'{col}_trend']    = res.trend     # 장기 증가·감소 추세\n","    df[f'{col}_seasonal'] = res.seasonal  # 월별 반복 계절 패턴\n","    df[f'{col}_residual'] = res.resid     # 추세 및 계절성 제거 후 순수 변동 (Residual series)\n","\n","    # -----------------------------------------------------\n","    # 3. 개별 변수 분해 결과 시각화 (Trend, Seasonal, Residual)\n","    # -----------------------------------------------------\n","    fig, axes = plt.subplots(4, 1, figsize=(14, 10), sharex=True)\n","\n","    # 원데이터 (Observed)\n","    axes[0].plot(series_clean.index, series_clean, color='black', linewidth=1.5)\n","    axes[0].set_title(f'Original Series: {display_name}')\n","    axes[0].grid(alpha=0.3)\n","\n","    # 장기 추세 (Trend)\n","    axes[1].plot(res.trend.index, res.trend, color='blue', linewidth=1.5)\n","    axes[1].set_title('Trend Component (장기 추세)')\n","    axes[1].grid(alpha=0.3)\n","\n","    # 계절성 (Seasonal)\n","    axes[2].plot(res.seasonal.index, res.seasonal, color='green', linewidth=1.5)\n","    axes[2].set_title('Seasonal Component (월별 계절 패턴)')\n","    axes[2].grid(alpha=0.3)\n","\n","    # 순수 변동 잔차 (Residual)\n","    axes[3].plot(res.resid.index, res.resid, color='red', linewidth=1.5)\n","    axes[3].axhline(0, color='black', linestyle='--', alpha=0.5)\n","    axes[3].set_title('Residual Component (순수 변동)')\n","    axes[3].grid(alpha=0.3)\n","\n","    plt.suptitle(f'STL Decomposition - {display_name}', fontsize=16, fontweight='bold', y=1.01)\n","    plt.tight_layout()\n","    plt.show()\n","\n","# =========================================================\n","# 4. 순수 변동(Residual Series) 대상 정상성 재검정 (ADF + KPSS)\n","# =========================================================\n","# 계획서에 따라 CCF 및 시차 분석에 사용될 residual 변수들의 정상성을 증명합니다.\n","print(\"\\n\" + \"=\"*60)\n","print(\"⚙️ STL 잔차 계열(Residual Series) 대상 정상성 교차 검정\")\n","print(\"=\"*60)\n","\n","for col, display_name in stl_target_vars.items():\n","    resid_col = f'{col}_residual'\n","    if resid_col in df.columns:\n","        # 앞선 3-1단계에서 수정한 복합 정상성 검정 함수를 재호출합니다.\n","        stationarity_cross_test(df[resid_col], f'{display_name} Residual')"],"metadata":{"id":"qSi3_RXwboVe","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1780133657748,"user_tz":-540,"elapsed":6490,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"da3e45b5-0954-4b1b-d2a1-2e381ee9f77b"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["⚙️ 변수별 STL 분해(Seasonal-Trend Decomposition) 및 파생변수 생성 중...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","============================================================\n","⚙️ STL 잔차 계열(Residual Series) 대상 정상성 교차 검정\n","============================================================\n","\n","=== Property Crime Rate (재산범죄율) Residual 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -7.2625 | p-value: 0.0000\n","2) KPSS Test -> Statistic: 0.0569 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n","\n","=== Heat Index (불쾌지수) Residual 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -12.0569 | p-value: 0.0000\n","2) KPSS Test -> Statistic: 0.1958 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n","\n","=== Precipitation (강수량) Residual 정상성 교차 검정 ===\n","1) ADF Test  -> Statistic: -7.4108 | p-value: 0.0000\n","2) KPSS Test -> Statistic: 0.0378 | p-value: 0.1000\n","---------------------------------------------\n","➡ 판정: 확실한 정상 시계열 (Stationary)\n"]}]},{"cell_type":"code","source":["# 시차 효과 탐색을 위한 교차상관분석(CCF)\n","from statsmodels.tsa.stattools import ccf\n","\n","# =========================================================\n","# 1. STL 분해 잔차 데이터 추출 및 결측치 처리\n","# =========================================================\n","# 3-3단계에서 저장된 순수 변동(residual) 시리즈를 활용합니다.\n","# 상관분석 특성상 두 변수가 매칭되는 동일 기간의 데이터만 사용합니다.\n","\n","valid_df = df[['property_rate_working_residual', 'heat_index_residual']].dropna()\n","\n","y_residual = valid_df['property_rate_working_residual'] # 종속변수 잔차 (범죄율)\n","x_residual = valid_df['heat_index_residual']          # 독립변수 잔차 (열지수)\n","\n","# =========================================================\n","# 2. 계획서 기반 Lag 0~3 범위의 교차상관함수(CCF) 연산\n","# =========================================================\n","# ccf(x, y) 함수는 x가 y보다 선행하는 시차(Positive Lags)를 기본 계산합니다.\n","# 원 데이터 배열 전체에 대한 CCF 값이 반환되므로, 계획서에서 지정한 lag 0~3 구간만 슬라이싱합니다.\n","\n","max_lag = 3\n","ccf_values = ccf(x_residual, y_residual, adjusted=False)[:max_lag + 1]\n","\n","# 통계적 유의미성 판단을 위한 95% 신뢰구간(Confidence Interval) 계산\n","# N은 시계열 데이터의 총 샘플 수입니다.\n","n = len(valid_df)\n","conf_level = 1.96 / np.sqrt(n)\n","\n","# 결과를 데이터프레임으로 구조화\n","ccf_summary = pd.DataFrame({\n","    'Lag (시차)': [f'Lag {i} ({i}개월 후)' for i in range(max_lag + 1)],\n","    'Correlation (상관계수)': ccf_values,\n","    'Significant (유의성 여부)': np.abs(ccf_values) > conf_level\n","})\n","\n","print(\"==================================================\")\n","print(\" 📊 [불쾌지수 ➡ 재산범죄율] 교차상관분석(CCF) 결과 보고\")\n","print(\"==================================================\")\n","print(ccf_summary.to_string(index=False))\n","print(f\"--------------------------------------------------\")\n","print(f\"💡 95% 유의수준 임계치: ±{conf_level:.4f}\")\n","print(\"==================================================\\n\")\n","\n","# =========================================================\n","# 3. CCF 결과 시각화 (교차상관 도표 렌더링)\n","# =========================================================\n","plt.figure(figsize=(10, 5))\n","\n","# 시차별 상관계수 막대 그래프\n","lags = np.arange(max_lag + 1)\n","bars = plt.bar(lags, ccf_values, color='teal', alpha=0.8, width=0.4, edgecolor='black', label='CCF Value')\n","\n","# 95% 신뢰구간 점선 추가 (이 선을 넘어가야 통계적으로 의미 있는 시차 효과임)\n","plt.axhline(y=conf_level, color='red', linestyle='--', linewidth=1.5, label='95% Confidence Interval')\n","plt.axhline(y=-conf_level, color='red', linestyle='--', linewidth=1.5)\n","plt.axhline(y=0, color='gray', linestyle='-', linewidth=0.8)\n","\n","# 그래프 디테일 세팅\n","plt.title('Cross-Correlation Function (CCF) Analysis\\n[Heat Index Residual ➡ Property Crime Residual]', fontsize=13, fontweight='bold')\n","plt.xlabel('Time Lag (Months)', fontsize=11)\n","plt.ylabel('Cross-Correlation Coefficient', fontsize=11)\n","plt.xticks(lags, [f'Lag {i}\\n({i}M 後)' for i in lags])\n","plt.ylim(-1.0, 1.0) # 상관계수 범위 고정\n","plt.grid(axis='y', alpha=0.3)\n","plt.legend(loc='upper right')\n","\n","# 막대 상단에 수치 표시\n","for bar in bars:\n","    yval = bar.get_height()\n","    plt.text(bar.get_x() + bar.get_width()/2.0, yval + (0.02 if yval >= 0 else -0.06), f'{yval:.4f}', ha='center', va='bottom', fontsize=10, fontweight='bold')\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"ilSRxn0FboX-","colab":{"base_uri":"https://localhost:8080/","height":723},"executionInfo":{"status":"ok","timestamp":1780133658445,"user_tz":-540,"elapsed":695,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"3bd16fba-a6b6-491a-89cd-8c4e3eeafbc8"},"execution_count":28,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n"," 📊 [불쾌지수 ➡ 재산범죄율] 교차상관분석(CCF) 결과 보고\n","==================================================\n","     Lag (시차)  Correlation (상관계수)  Significant (유의성 여부)\n","Lag 0 (0개월 후)            0.063436                 False\n","Lag 1 (1개월 후)           -0.049751                 False\n","Lag 2 (2개월 후)           -0.065028                 False\n","Lag 3 (3개월 후)           -0.002701                 False\n","--------------------------------------------------\n","💡 95% 유의수준 임계치: ±0.1706\n","==================================================\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# 다중공선성(Multicollinearity) 진단\n","from statsmodels.stats.outliers_influence import variance_inflation_factor\n","\n","# =========================================================\n","# 1. 분석 대상 전체 기상 변수 정의 및 데이터프레임 추출\n","# =========================================================\n","# 계획서에 언급된 모든 기상 지표 리스트를 정의합니다.\n","all_weather_vars = [\n","    'temp_avg', 'heat_index', 'humidity_avg', 'precip_mm',\n","    'heatwave_days', 'tropical_nights', 'sunshine_hours', 'solar_radiation'\n","]\n","\n","# 데이터프레임에 존재하는 컬럼만 안전하게 슬라이싱한 후 결측치를 처리합니다.\n","vif_df_all = df[all_weather_vars].dropna()\n","\n","\n","# =========================================================\n","# 2. Pearson 상관행렬(Correlation Matrix) 산출 및 히트맵 시각화\n","# =========================================================\n","corr_matrix = vif_df_all.corr(method='pearson')\n","\n","plt.figure(figsize=(10, 8))\n","sns.heatmap(\n","    corr_matrix,\n","    annot=True,          # 격자 내부에 실제 상관계수 수치 표시\n","    fmt=\".2f\",           # 소수점 둘째 자리까지 출력\n","    cmap='RdBu_r',       # 양의 상관관계는 붉은색, 음의 상관관계는 푸른색 매핑\n","    vmin=-1, vmax=1,     # 상관계수 범위 고정\n","    linewidths=0.5,\n","    cbar_kws={\"shrink\": .8}\n",")\n","plt.title('날씨 변수의 피어슨 상관 행렬', fontsize=14, fontweight='bold', y=1.02)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# =========================================================\n","# 3. VIF(분산팽창인자) 계산 공통 함수 정의\n","# =========================================================\n","def calculate_vif(dataframe):\n","    # 1. 상수항(Constant) 추가: VIF 계산 시 필수\n","    df_with_const = sm.add_constant(dataframe)\n","\n","    vif_data = pd.DataFrame()\n","    vif_data[\"Variable (변수명)\"] = df_with_const.columns\n","\n","    # 2. VIF 계산\n","    vif_data[\"VIF 수치\"] = [\n","        variance_inflation_factor(df_with_const.values, i) for i in range(df_with_const.shape[1])\n","    ]\n","\n","    # 3. 상수항은 제외하고 결과 반환\n","    vif_result = vif_data[vif_data[\"Variable (변수명)\"] != \"const\"]\n","\n","    # 상태 진단 로직 추가\n","    status_conditions = [\n","        (vif_result[\"VIF 수치\"] < 5),\n","        (vif_result[\"VIF 수치\"] >= 5) & (vif_result[\"VIF 수치\"] < 10),\n","        (vif_result[\"VIF 수치\"] >= 10)\n","    ]\n","    status_labels = [\"안정\", \"주의\", \"제거 권장\"]\n","    vif_result[\"상태 진단\"] = np.select(status_conditions, status_labels, default=\"판정 불가\")\n","\n","    return vif_result.sort_values(by=\"VIF 수치\", ascending=False).reset_index(drop=True)\n","\n","# ===