_diff      -0.3589      0.296     -1.212      0.228      -0.945       0.227\n","precip_diff              0.0210      0.009      2.227      0.028       0.002       0.040\n","sunshine_hours_diff      0.0576      0.063      0.914      0.363      -0.067       0.182\n","solar_radiation_diff     0.0335      0.029      1.163      0.247      -0.023       0.090\n","unemp_diff              -5.1216      3.580     -1.431      0.155     -12.209       1.965\n","covid_dummy             -0.2899      1.315     -0.220      0.826      -2.893       2.313\n","holiday_cnt             -0.4567      0.967     -0.472      0.638      -2.372       1.458\n","========================================================================================\n","========================================================================\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Granger 인과성 검정 (Granger Causality Test)\n","from statsmodels.tsa.stattools import grangercausalitytests\n","\n","# =========================================================\n","# 1. Granger 인과성 검정용 변수 세팅 (정상성 확보된 차분 데이터)\n","# =========================================================\n","# 3-2단계에서 생성한 1차 차분 변수를 활용합니다.\n","# statsmodels의 grangercausalitytests 함수는 [종속변수, 독립변수] 순서의 2차원 배열을 요구합니다.\n","\n","# 데이터프레임 내 결측치를 제거하여 온전한 시계열 쌍을 확보합니다.\n","granger_df = df[['property_diff', 'heat_index_diff']].dropna()\n","\n","max_lag = 3  # 계획서 지정 시차 (1~3개월)\n","\n","# =========================================================\n","# 2. 방향 ①: 기온 ➡ 재산범죄 인과성 검정\n","# =========================================================\n","# 종속변수 자리에 'property_diff', 독립변수 자리에 'heat_index_diff'를 배치합니다.\n","data_direction_1 = granger_df[['property_diff', 'heat_index_diff']]\n","\n","print(\"========================================================================\")\n","print(\" 🔥 [방향 ①] 기온이 재산범죄의 선행 신호인가? (Heat Index ➡ Property Crime)\")\n","print(\"========================================================================\")\n","# verbose=False로 설정하여 로우 데이터 로그를 숨기고 핵심만 파싱합니다.\n","results_1 = grangercausalitytests(data_direction_1, maxlag=max_lag, verbose=False)\n","\n","summary_1 = []\n","for lag in range(1, max_lag + 1):\n","    # SSR 기반 F-test, SSR 기반 Chi2-test 등 여러 검정 지표 중\n","    # 시계열 분석에서 가장 범용적으로 쓰이는 'ssr_ftest'의 p-value를 추출합니다.\n","    p_val = results_1[lag][0]['ssr_ftest'][1]\n","    is_causal = \"유의함 (인과성 존재)\" if p_val < 0.05 else \"유의하지 않음\"\n","    summary_1.append({\"시차(Lag)\": f\"{lag}개월\", \"p-value\": f\"{p_val:.4f}\", \"결과\": is_causal})\n","\n","print(pd.DataFrame(summary_1).to_string(index=False))\n","print(\"========================================================================\\n\")\n","\n","\n","# =========================================================\n","# 3. 방향 ②: 재산범죄 ➡ 기온 인과성 검정 (역방향 통제 검정)\n","# =========================================================\n","# 종속변수 자리에 'heat_index_diff', 독립변수 자리에 'property_diff'를 배치합니다.\n","data_direction_2 = granger_df[['heat_index_diff', 'property_diff']]\n","\n","print(\"========================================================================\")\n","print(\" 🔄 [방향 ②] 재산범죄가 기온에 영향을 주는가? (Property Crime ➡ Heat Index)\")\n","print(\"========================================================================\")\n","results_2 = grangercausalitytests(data_direction_2, maxlag=max_lag, verbose=False)\n","\n","summary_2 = []\n","for lag in range(1, max_lag + 1):\n","    p_val = results_2[lag][0]['ssr_ftest'][1]\n","    is_causal = \"유의함 (인과성 존재)\" if p_val < 0.05 else \"유의하지 않음\"\n","    summary_2.append({\"시차(Lag)\": f\"{lag}개월\", \"p-value\": f\"{p_val:.4f}\", \"결과\": is_causal})\n","\n","print(pd.DataFrame(summary_2).to_string(index=False))\n","print(\"========================================================================\\n\")\n","\n","\n","# =========================================================\n","# 4. 계획서 기반 최종 단방향 인과 관계 종합 해석 엔진\n","# =========================================================\n","print(\"========================================================================\")\n","print(\" 📝 Granger 인과성 검정 최종 결과 종합 판정\")\n","print(\"========================================================================\")\n","\n","p_1 = [results_1[l][0]['ssr_ftest'][1] for l in range(1, max_lag + 1)]\n","p_2 = [results_2[l][0]['ssr_ftest'][1] for l in range(1, max_lag + 1)]\n","\n","has_dir1 = any(p < 0.05 for p in p_1)\n","has_dir2 = any(p < 0.05 for p in p_2)\n","\n","if has_dir1 and not has_dir2:\n","    print(\"➡ 결론: [확실한 단방향 인과관계 도출] 기온 변화가 재산범죄를 선행 예측합니다.\")\n","elif not has_dir1 and has_dir2:\n","    print(\"➡ 결론: [역방향 인과관계 피드백] 범죄율이 기온 변동을 예측하는 모순이 발생했습니다. 모델 재검토가 필요합니다.\")\n","elif has_dir1 and has_dir2:\n","    print(\"➡ 결론: [쌍방향 피드백 관계] 두 변수가 서로 밀접하게 영향을 주고받는 피드백 구조입니다.\")\n","else:\n","    print(\"➡ 결론: [인과관계 없음] 기온과 재산범죄 간에는 선행 시차적 예측력이 존재하지 않습니다.\")\n","print(\"========================================================================\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HfO020JOX4pL","executionInfo":{"status":"ok","timestamp":1780133661387,"user_tz":-540,"elapsed":9,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"92e0f625-cd9b-4a0d-8efb-335d3c285d40"},"execution_count":34,"outputs":[{"output_type":"stream","name":"stdout","text":["========================================================================\n"," 🔥 [방향 ①] 기온이 재산범죄의 선행 신호인가? (Heat Index ➡ Property Crime)\n","========================================================================\n","시차(Lag) p-value           결과\n","    1개월  0.0005 유의함 (인과성 존재)\n","    2개월  0.0003 유의함 (인과성 존재)\n","    3개월  0.0000 유의함 (인과성 존재)\n","========================================================================\n","\n","========================================================================\n"," 🔄 [방향 ②] 재산범죄가 기온에 영향을 주는가? (Property Crime ➡ Heat Index)\n","========================================================================\n","시차(Lag) p-value      결과\n","    1개월  0.6274 유의하지 않음\n","    2개월  0.9473 유의하지 않음\n","    3개월  0.0979 유의하지 않음\n","========================================================================\n","\n","========================================================================\n"," 📝 Granger 인과성 검정 최종 결과 종합 판정\n","========================================================================\n","➡ 결론: [확실한 단방향 인과관계 도출] 기온 변화가 재산범죄를 선행 예측합니다.\n","========================================================================\n"]}]},{"cell_type":"code","source":["# SARIMAX 기반 시계열 예측모형 구축\n","from sklearn.metrics import mean_absolute_error, mean_squared_error\n","\n","# =========================================================\n","# 1. 데이터 분할 (Train / Test Split) 및 변수 정의\n","# =========================================================\n","# 시계열의 후반부 12개월을 검증용 Test 데이터셋으로 분리합니다.\n","test_periods = 12\n","train_df = df.iloc[:-test_periods]\n","test_df = df.iloc[-test_periods:]\n","\n","# 계획서 지정 변수 정의\n","endog_var = 'property_rate_working'\n","exog_vars = ['heat_index', 'precip_mm', 'unemp_rate']\n","\n","y_train = train_df[endog_var]\n","X_train = train_df[exog_vars]\n","\n","y_test = test_df[endog_var]\n","X_test = test_df[exog_vars]\n","\n","\n","# =========================================================\n","# 2. SARIMAX 모형 빌드 및 학습 (Fit)\n","# =========================================================\n","# 계획서 지침: 'd=1' 설정을 통해 내부적으로 1차 차분을 수행하며,\n","# 차수는 ACF/PACF 및 앞선 검정(월별 데이터 주기 12)을 반영한 예시 파라미터(1,1,1)(1,0,1,12)를 적용합니다.\n","# (실제 데이터 특성에 따라 order 및 seasonal_order 차수는 수정 가능합니다)\n","\n","print(\"⚙️ SARIMAX 예측 모형\")\n","model_sarimax = sm.tsa.statespace.SARIMAX(\n","    endog=y_train,\n","    exog=X_train,\n","    order=(1, 1, 1),              # (p, d, q) -> d=1 내부 차분 지정\n","    seasonal_order=(1, 0, 1, 12),  # (P, D, Q, s) -> 월별 계절성 반영\n","    enforce_stationarity=False,\n","    enforce_invertibility=False\n",")\n","\n","sarimax_fit = model_sarimax.fit(disp=False)\n","print(sarimax_fit.summary().tables[1]) # 모형 추정치 요약 출력\n","\n","\n","# =========================================================\n","# 3. 모델 성능 평가 (Test Set 검증 및 MAE, RMSE 산출)\n","# =========================================================\n","# Test 기간의 외부 변수(X_test)를 투입하여 실제 범죄율 구간 예측을 수행합니다.\n","predictions = sarimax_fit.forecast(steps=test_periods, exog=X_test)\n","\n","# 계획서 요구 성능 지표 계산\n","mae = mean_absolute_error(y_test, predictions)\n","rmse = np.sqrt(mean_squared_error(y_test, predictions))\n","\n","print(\"\\n==================================================\")\n","print(\" 📊 SARIMAX 모형 예측 성능 평가 결과 (Test Set)\")\n","print(\"==================================================\")\n","print(f\"• MAE  (Mean Absolute Error) : {mae:.4f}\")\n","print(f\"• RMSE (Root Mean Squared Error): {rmse:.4f}\")\n","print(\"==================================================\\n\")\n","\n","\n","# =========================================================\n","# 4. 폭염 심화 시나리오(Heatwave Scenario) 시뮬레이션\n","# =========================================================\n","# 미래 Test 기간 동안 폭염이 심화되어 '열지수(heat_index)가 일률적으로 10% 상승'했다고 가정합니다.\n","X_test_scenario = X_test.copy()\n","X_test_scenario['heat_index'] = X_test_scenario['heat_index'] * 1.10 # 10% 가중 충격 부여\n","\n","# 시나리오 기반 가상 미래 범죄율 예측 수행\n","scenario_predictions = sarimax_fit.forecast(steps=test_periods, exog=X_test_scenario)\n","\n","\n","# =========================================================\n","# 5. 최종 시뮬레이션 결과 대조 시각화\n","# =========================================================\n","plt.figure(figsize=(15, 6))\n","\n","# 과거 학습 데이터 흐름\n","plt.plot(train_df.index[-24:], y_train[-24:], color='black', label='Historical Data (과거 데이터)')\n","\n","# 실제 테스트 데이터 대 예측값 대조\n","plt.plot(test_df.index, y_test, color='gray', linestyle='-', marker='o', alpha=0.7, label='Actual Data (실제 범죄율)')\n","plt.plot(test_df.index, predictions, color='blue', linestyle='--', marker='s', label='Baseline Forecast (기존 예측)')\n","\n","# 폭염 심화 시나리오 반영 가상 결과선\n","plt.plot(test_df.index, scenario_predictions, color='red', linestyle='-', marker='^',\n","         label='Heatwave Scenario Forecast (폭염 10% 심화 시나리오)')\n","\n","plt.title('SARIMAX 예보 및 기후 변화 폭염 시나리오 시뮬레이션', fontsize=14, fontweight='bold')\n","plt.xlabel('Date', fontsize=12)\n","plt.ylabel('Property Crime Rate', fontsize=12)\n","plt.grid(True, linestyle='--', alpha=0.5)\n","plt.legend(loc='upper left', fontsize=11)\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":991},"id":"cZVlXv9pX4ul","executionInfo":{"status":"ok","timestamp":1780133662858,"user_tz":-540,"elapsed":1470,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"a6a9ab70-51f7-4597-9bc2-a7ecaf26c00f"},"execution_count":35,"outputs":[{"output_type":"stream","name":"stdout","text":["⚙️ SARIMAX 예측 모형\n","==============================================================================\n","                 coef    std err          z      P>|z|      [0.025      0.975]\n","------------------------------------------------------------------------------\n","heat_index     0.6549      0.218      3.008      0.003       0.228       1.082\n","precip_mm     -0.0168      0.008     -2.053      0.040      -0.033      -0.001\n","unemp_rate     0.0296      2.175      0.014      0.989      -4.234       4.293\n","ar.L1          0.3716      0.357      1.040      0.299      -0.329       1.072\n","ma.L1         -0.5617      0.340     -1.652      0.099      -1.228       0.105\n","ar.S.L12       0.9380      0.022     43.237      0.000       0.896       0.981\n","ma.S.L12      -0.6635      0.101     -6.543      0.000      -0.862      -0.465\n","sigma2        23.6768      3.225      7.341      0.000      17.355      29.998\n","==============================================================================\n","\n","=