solar_radiation_diff', 'unemp_diff',\n","    'covid_dummy', 'holiday_cnt'\n","]\n","\n","# 결측치 발생을 방지하기 위해 각 모델별 서브셋을 안전하게 정형화합니다.\n","# 3-2단계 등에서 누락된 차분 features가 있다면 사전에 정의되어 있어야 합니다.\n","for f in ['heatwave_days_diff', 'sunshine_hours_diff', 'solar_radiation_diff']:\n","    if f not in df.columns and f.replace('_diff', '') in df.columns:\n","        df[f] = df[f.replace('_diff', '')].diff()\n","\n","\n","# =========================================================\n","# 2. [모델 A] 원계열 기반 OLS 회귀분석 실행\n","# =========================================================\n","df_model_a = df[['property_rate_working'] + all_features].dropna()\n","\n","X_a = df_model_a[all_features]\n","X_a = sm.add_constant(X_a) # 절편(Intercept) 추가\n","y_a = df_model_a['property_rate_working']\n","\n","model_a_fit = sm.OLS(y_a, X_a).fit()\n","\n","\n","# =========================================================\n","# 3. [모델 B] 차분 계열 기반 OLS 회귀분석 실행\n","# =========================================================\n","# 3-2단계에서 생성한 property_diff를 종속변수로 삼습니다.\n","df_model_b = df[['property_diff'] + all_features_diff].dropna()\n","\n","X_b = df_model_b[all_features_diff]\n","X_b = sm.add_constant(X_b) # 절편(Intercept) 추가\n","y_b = df_model_b['property_diff']\n","\n","model_b_fit = sm.OLS(y_b, X_b).fit()\n","\n","\n","# =========================================================\n","# 4. 분석 결과 통합 비교 및 가독성 리포팅\n","# =========================================================\n","print(\"========================================================================\")\n","print(\" 🎯 [모델 A: 원계열 OLS] 분석 요약 보고서 (Original Series Model)\")\n","print(\"========================================================================\")\n","print(f\"• 종속변수: 재산범죄율(property_rate_working) | 관측치 개수: {int(model_a_fit.nobs)}개\")\n","print(f\"• 모델 설명력 (R-squared): {model_a_fit.rsquared:.4f} | 수정된 R2: {model_a_fit.rsquared_adj:.4f}\")\n","print(f\"• F-통계량 p-value: {model_a_fit.f_pvalue:.4e}\")\n","print(\"-\" * 72)\n","print(model_a_fit.summary().tables[1]) # 회귀계수 테이블만 압축 출력\n","print(\"========================================================================\\n\")\n","\n","print(\"========================================================================\")\n","print(\" 🎯 [모델 B: 차분 OLS] 분석 요약 보고서 (1st Differenced Model)\")\n","print(\"========================================================================\")\n","print(f\"• 종속변수: 재산범죄율 증감 폭(property_diff) | 관측치 개수: {int(model_b_fit.nobs)}개\")\n","print(f\"• 모델 설명력 (R-squared): {model_b_fit.rsquared:.4f} | 수정된 R2: {model_b_fit.rsquared_adj:.4f}\")\n","print(f\"• F-통계량 p-value: {model_b_fit.f_pvalue:.4e}\")\n","print(\"-\" * 72)\n","print(model_b_fit.summary().tables[1]) # 회귀계수 테이블만 압축 출력\n","print(\"========================================================================\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PZ3G5cILW1F9","executionInfo":{"status":"ok","timestamp":1780133659748,"user_tz":-540,"elapsed":37,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"be5dec97-d05a-4ea3-9e1e-94b7f2d9c42b"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stdout","text":["========================================================================\n"," 🎯 [모델 A: 원계열 OLS] 분석 요약 보고서 (Original Series Model)\n","========================================================================\n","• 종속변수: 재산범죄율(property_rate_working) | 관측치 개수: 132개\n","• 모델 설명력 (R-squared): 0.5130 | 수정된 R2: 0.4813\n","• F-통계량 p-value: 3.6518e-16\n","------------------------------------------------------------------------\n","===================================================================================\n","                      coef    std err          t      P>|t|      [0.025      0.975]\n","-----------------------------------------------------------------------------------\n","const             217.6870     13.902     15.659      0.000     190.169     245.205\n","heat_index         -0.7626      0.205     -3.713      0.000  