    0.0335      0.033      1.019      0.310      -0.032       0.098\n","unemp_diff              -5.1216      3.303     -1.550      0.124     -11.661       1.418\n","covid_dummy             -0.2899      2.240     -0.129      0.897      -4.724       4.145\n","holiday_cnt             -0.4567      0.734     -0.622      0.535      -1.910       0.997\n","========================================================================================\n","========================================================================\n"]}]},{"cell_type":"code","source":["# 오차항의 자기상관(Autocorrelation) 검정\n","from statsmodels.stats.stattools import durbin_watson\n","from statsmodels.stats.diagnostic import acorr_breusch_godfrey\n","\n","# =========================================================\n","# 1. 오차항 자기상관 검정 및 Newey-West HAC 보정 함수 정의\n","# =========================================================\n","def residual_autocorr_diagnostics(model_fit, model_name, X_matrix):\n","    \"\"\"\n","    Durbin-Watson, Breusch-Godfrey 검정을 수행하고\n","    자기상관을 보정하는 Newey-West HAC 표준오차 모델을 반환하는 함수\n","    \"\"\"\n","    print(f\"========================================================================\")\n","    print(f\" 🔍 [{model_name}] 오차항 자기상관 검정 및 HAC 보정\")\n","    print(f\"========================================================================\")\n","\n","    # [Action 1] Durbin-Watson 검정 (2에 가까울수록 자기상관 없음)\n","    dw_stat = durbin_watson(model_fit.resid)\n","    print(f\"• Durbin-Watson 통계량: {dw_stat:.4f}\")\n","    if 1.5 <= dw_stat <= 2.5:\n","        print(\"  ➡ 판정: 오차항에 일차(AR(1)) 자기상관이 존재하지 않을 가능성이 큽니다.\")\n","    else:\n","        print(\"  ➡ [주의]: 오차항에 자기상관이 의심됩니다. (0에 가까우면 양, 4에 가까우면 음)\")\n","\n","    # [Action 2] Breusch-Godfrey 고차 자기상관 검정 (시차=1~3개월 통합 검정)\n","    # 귀무가설(H0): 자기상관이 존재하지 않는다.\n","    bg_lm, bg_lmp, bg_f, bg_fp = acorr_breusch_godfrey(model_fit, nlags=3)\n","    print(f\"• Breusch-Godfrey 검정 (Lag 3) p-value: {bg_lmp:.4f}\")\n","    if bg_lmp < 0.05:\n","        print(\"  ➡ 판정: 오차항에 고차 자기상관이 존재합니다. (귀무가설 기각) ★HAC 보정 필수\")\n","    else:\n","        print(\"  ➡ 판정: 오차항에 시차 3 이내의 자기상관이 존재하지 않습니다. (귀무가설 채택)\")\n","\n","    print(\"-\" * 72)\n","\n","    # [Action 3] Newey-West HAC(이분산 및 자기상관 강건 표준오차) 적용\n","    # 시계열의 장기 의존성을 반영하기 위해 자동 시차(maxlags)를 계산하여 보정합니다.\n","    hac_model = model_fit.get_robustcov_results(cov_type='HAC', maxlags=3)\n","\n","    print(f\"💡 [Newey-West HAC 보정 후 회귀계수 요약]\")\n","    print(hac_model.summary().tables[1])\n","    print(\"========================================================================\\n\")\n","\n","    return hac_model\n","\n","\n","# =========================================================\n","# 2. 모델 A 및 모델 B 대상 자기상관 검정 & HAC 실행\n","# =========================================================\n","# X_a와 X_b는 5-1단계에서 생성된 sm.add_constant(X) 행렬 변수여야 합니다.\n","hac_model_a = residual_autocorr_diagnostics(model_a_fit, \"모델 A: 원계열 OLS\", X_a)\n","hac_model_b = residual_autocorr_diagnostics(model_b_fit, \"모델 B: 차분 OLS\", X_b)\n","\n","\n","# =========================================================\n","# 3. [추가 액션] 잔차 진단 3종 그래프 시각화 (Residual, Histogram, QQ Plot)\n","# =========================================================\n","models_to_plot = [\n","    (model_a_fit, \"Model A (Original Series) Residuals\", \"blue\"),\n","    (model_b_fit, \"Model B (1st Differenced) Residuals\", \"orange\")\n","]\n","\n","for model_fit, title_prefix, color in models_to_plot:\n","    residuals = model_fit.resid\n","\n","    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n","\n","    # [시각화 1] Residual Plot (시간 흐름에 따른 잔차 변동성 - 이분산성 확인)\n","    axes[0].plot(residuals.index, residuals, color=color, alpha=0.7, linewidth=1.5)\n","    axes[0].axhline(0, color='black', linestyle='--', alpha=0.6)\n","    axes[0].set_title(f'1) Residual Plot')\n","    axes[0].set_xlabel('Timeline')\n","    axes[0].set_ylabel('Residuals')\n","    axes[0].grid(alpha=0.3)\n","\n","    # [시각화 2] Histogram with Kernel Density (잔차의 정규성 분포 확인)\n","    axes[1].hist(residuals, bins=15, density=True, color=color, alpha=0.5, edgecolor='black')\n","    # 정규분포 곡선 오버레이\n","    mu, std = residuals.mean(), residuals.std()\n","    xmin, xmax = axes[1].get_xlim()\n","    x_axis = np.linspace(xmin, xmax, 100)\n","    axes[1].plot(x_axis, stats.norm.pdf(x_axis, mu, std), color='red', linestyle='-', linewidth=2, label='Normal Dist')\n","    axes[1].set_title(f'2) Residual Histogram')\n","    axes[1].grid(alpha=0.3)\n","    axes[1].legend()\n","\n","    # [시각화 3] Q-Q Plot (이론적 정규분포 분위수와 대조)\n","    stats.probplot(residuals, dist=\"norm\", plot=axes[2])\n","    axes[2].get_lines()[0].set_color(color)\n","    axes[2].get_lines()[0].set_alpha(0.6)\n","    axes[2].set_title(f'3) Normal Q-Q Plot')\n","    axes[2].grid(alpha=0.3)\n","\n","    plt.suptitle(f'포괄적 잔여 진단: {title_prefix}', fontsize=14, fontweight='bold', y=1.02)\n","    plt.tight_layout()\n","    plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"7YjAetPMX4j8","executionInfo":{"status":"ok","timestamp":1780133661375,"user_tz":-540,"elapsed":1626,"user":{"displayName":"강희욱","userId":"01087088657244175194"}},"outputId":"cbdf7008-36ef-466d-d37e-76ea520bc041"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["========================================================================\n"," 🔍 [모델 A: 원계열 OLS] 오차항 자기상관 검정 및 HAC 보정\n","========================================================================\n","• Durbin-Watson 통계량: 0.8869\n","  ➡ [주의]: 오차항에 자기상관이 의심됩니다. (0에 가까우면 양, 4에 가까우면 음)\n","• Breusch-Godfrey 검정 (Lag 3) p-value: 0.0000\n","  ➡ 판정: 오차항에 고차 자기상관이 존재합니다. (귀무가설 기각) ★HAC 보정 필수\n","------------------------------------------------------------------------\n","💡 [Newey-West HAC 보정 후 회귀계수 요약]\n","===================================================================================\n","                      coef    std err          t      P>|t|      [0.025      0.975]\n","----------------------------