pical_nights', 'precip_mm', 'sunshine_hours']\n","weather_names = ['불쾌지수', '열대야일수', '강수량(mm)', '일조시간(hr)']\n","\n","sarima_orders = {\n","    'heat_index':       ((1, 0, 0), (1, 1, 0, 12)),\n","    'tropical_nights':  ((1, 0, 0), (1, 1, 0, 12)),\n","    'precip_mm':        ((1, 1, 0), (1, 1, 0, 12)),\n","    'sunshine_hours':   ((1, 0, 0), (1, 1, 0, 12)),\n","}\n","\n","forecast_dict = {}\n","fig, axes = plt.subplots(2, 2, figsize=(16, 10))\n","axes = axes.flatten()\n","\n","for i, (wvar, wname) in enumerate(zip(weather_vars, weather_names)):\n","\n","    series = df[wvar].dropna()\n","    order, seasonal_order = sarima_orders[wvar]\n","\n","    model  = SARIMAX(series,\n","                     order=order,\n","                     seasonal_order=seasonal_order,\n","                     enforce_stationarity=False,\n","                     enforce_invertibility=False)\n","    fitted = model.fit(disp=False)\n","\n","    forecast      = fitted.get_forecast(steps=24)\n","    forecast_mean = forecast.predicted_mean\n","    forecast_ci   = forecast.conf_int()\n","\n","    forecast_dict[wvar] = forecast_mean\n","\n","    ax = axes[i]\n","    ax.plot(series.index, series,\n","            color='gray', linewidth=1.2, alpha=0.6, label='실제값')\n","    ax.plot(forecast_mean.index, forecast_mean,\n","            color='darkorange', linewidth=2, label='예측값')\n","    ax.fill_between(forecast_mean.index,\n","                    forecast_ci.iloc[:, 0],\n","                    forecast_ci.iloc[:, 1],\n","                    color='darkorange', alpha=0.2, label='95% CI')\n","    ax.axvline(pd.Timestamp('2025-01-01'),\n","               color='red', linestyle='--', linewidth=1.2)\n","    ax.set_title(f'{wname} 예측 (2025~2026)')\n","    ax.set_ylabel(wname)\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('기상변수 SARIMA 예측 (2025~2026)', fontsize=15)\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"✅ STEP 12-1 완료\")\n","for wvar, wname in zip(weather_vars,