ARIMAX 7.97% vs Prophet 9.25%\n","# · SARIMAX만 10% 기준선 아래\n","# · 차이 1.28%p로 미미하나 SARIMAX 소폭 우세\n","# · 강한 상승 추세는 SARIMAX 차분 기반이 더 잘 포착\n","\n","# [최종 모델 선택]\n","# · 폭력: Prophet (3.90%)\n","# · 흉악: Prophet (16.34%, 불량이나 상대적 우세)\n","# · 재산: SARIMAX (7.97%)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":410},"id":"zjNhcdj0YdnE","executionInfo":{"status":"ok","timestamp":1780285701415,"user_tz":-540,"elapsed":177,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"7e58ada8-0a19-4f74-9b33-fd46f38f3eb2"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["✅ model_comparison.png 저장 완료\n"]}]},{"cell_type":"code","source":["# STEP 분위수 회귀 (Quantile Regression)\n","import statsmodels.formula.api as smf\n","\n","crime_vars   = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names  = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","crime_colors = ['steelblue', 'crimson', 'seagreen']\n","\n","quantiles = [0.10, 0.25, 0.50, 0.75, 0.90]\n","\n","X_vars = ['heat_index', 'precip_mm', 'sunshine_hours',\n","          'unemp_rate', 'covid_dummy']\n","\n","fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n","\n","for ax, cvar, cname, color in zip(axes, crime_vars, crime_names, crime_colors):\n","\n","    coefs = []\n","    ci_lo = []\n","    ci_hi = []\n","\n","    for q in quantiles:\n","        formula = f\"{cvar} ~ heat_index + precip_mm + \" \\\n","                  f\"sunshine_hours + unemp_rate + covid_dummy\"\n","        model  = smf.quantreg(formula, df.dropna()).fit(q=q)\n","        coef   = model.params['heat_index']\n","        lo, hi = model.conf_int().loc['heat_index']\n","        coefs.append(coef)\n","        ci_lo.append(lo)\n","        ci_hi.append(hi)\n","\n","    # OLS 기준선\n","    ols_formula = f\"{cvar} ~ heat_index + precip_mm + \" \\\n","                  f\"sunshine_hours + unemp_rate + covid_dummy\"\n","    ols_model = smf.ols(ols_formula, df.dropna()).fit(cov_type='HC3')\n","    ols_coef  = ols_model.params['heat_index']\n","    ols_lo    = ols_model.conf_int().loc['heat_index', 0]\n","    ols_hi    = ols_model.conf_int().loc['heat_index', 1]\n","\n","    # 시각화\n","    ax.plot(quantiles, coefs, color=color, linewidth=2.5,\n","            marker='o', markersize=7, label='분위수 회귀계수')\n","    ax.fill_between(quantiles, ci_lo, ci_hi,\n","                    color=color, alpha=0.15, label='95% CI')\n","\n","    # OLS 기준선\n","    ax.axhline(ols_coef, color='black', linewidth=1.5,\n","               linestyle='--', label=f'OLS 계수 ({ols_coef:.3f})')\n","    ax.fill_between([0.05, 0.95], ols_lo, ols_hi,\n","                    color='gray', alpha=0.1)\n","\n","    ax.axhline(0, color='gray', linewidth=0.8, linestyle=':')\n","    ax.set_xticks(quantiles)\n","    ax.set_xticklabels([f'Q{int(q*100)}' for q in quantiles])\n","    ax.set_title(f'{cname}\\n불쾌지수 분위수 회귀계수', fontsize=11)\n","    ax.set_xlabel('분위수')\n","    ax.set_ylabel('불쾌지수 회귀계수')\n","    ax.legend(fontsize=8)\n","    ax.grid(alpha=0.3)\n","\n","    # 수치 출력\n","    print(f\"\\n{'─'*45}\")\n","    print(f\"  {cname} 불쾌지수 분위수 회귀계수\")\n","    print(f\"{'─'*45}\")\n","    print(f\"  OLS 기준: {ols_coef:.4f}\")\n","    for q, c, lo, hi in zip(quantiles, coefs, ci_lo, ci_hi):\n","        sig = '✅' if lo > 0 or hi < 0 else '  '\n","        print(f\"  {sig} Q{int(q*100):2d}: {c:+.4f} \"\n","              f\"[{lo:.4f}, {hi:.4f}]\")\n","\n","plt.suptitle('분위수 회귀 — 불쾌지수 효과의 범죄율 분포별 차이\\n'\n","             '(검정 점선=OLS 평균 효과, 색선=분위수별 효과)',\n","             fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 분위수 회귀 결과 — 불쾌지수 효과의 범죄율 분포별 차이\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# [분위수 회귀란?]\n","# OLS는 평균에서의 효과를 추정\n","# 분위수 회귀는 분포의 특정 지점에서의 효과를 추정\n","# Q10: 