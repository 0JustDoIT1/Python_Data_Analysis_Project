CCF에서 사용\n","\n","fig, axes = plt.subplots(3, 1, figsize=(14, 10))\n","\n","for ax, var, name, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    stl = STL(df[var], period=12, robust=True)\n","    res = stl.fit()\n","\n","    stl_residuals[var] = res.resid  # CCF 입력값으로 저장\n","\n","    ax.plot(df.index, res.resid, color=color, linewidth=1.2)\n","    ax.axhline(0, color='black', linewidth=0.8, linestyle='--')\n","    ax.set_title(f'{name} — STL 잔차 (추세·계절성 제거 후 순수 변동)')\n","    ax.set_ylabel('잔차')\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('STL 잔차 (Residual) — CCF 분석 입력값', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"STL 잔차 저장 완료 →  stl_residuals 딕셔너리\")\n","print({k: f\"n={len(v)}, std={v.std():.3f}\" for k, v in stl_residuals.items()})\n","\n","# [잔차란?]\n","# 원계열에서 추세와 계절성을 모두 뺀 나머지\n","# \"계절이 같아서 상관이 있는 게 아니라 계절 외 순수 변동에서도 관계가 있는가\"를 검정 가능\n","\n","# · 폭력·흉악은 잔차가 작고 랜덤 → CCF 결과 신뢰도 높음\n","# · 재산범죄는 잔차 변동성이 커서 → CCF 결과 해석 시 주의\n","\n","# [폭력범죄 잔차]\n","# · 진폭: ±4~6 수준, std=1.X\n","# · 대체로 랜덤하게 0 주변 등락\n","# · 2021~2022년 구간에서 큰 음의 스파이크(-6)\n","#   → 코로나 구간에서 추세·계절성으로 설명 안 되는\n","#     추가적 억제 효과가 잔차로 포착\n","# · STL 분해 품질 양호\n","\n","# [흉악범죄 잔차]\n","# · 진폭: ±1.5~2.5 수준으로 세 범죄 중 가장 작음\n","# · 2021~2022년 큰 음의 스파이크(-2.5)\n","#   → 구조 변화(급등) 시점에서 STL이 추세를 따라가지 못한 잔재\n","# · 잔차가 작다는 건 원계열의 대부분이\n","#   추세+계절성으로 잘 설명된다는 의미\n","# · CCF에서 유의한 시차 효과 찾기 유리한 구조\n","\n","# [재산범죄 잔차]\n","# · 진폭: ±20 수준으로 세 범죄 중 압도적으로 큼\n","# · 2019~2022년 구간에서 대형 스파이크 집중\n","#   → 추세 상승 속도가 너무 빨라 STL이 완전히 흡수 못함\n","# · 잔차 자체에 구조적 패턴이 남아있음\n","#   → CCF 분석 시 재산범죄 결과는 신중하게 해석 필요\n","#   → 기상변수 효과보다 구조적 요인의 잔재일 가능성\n","\n","# [CCF 분석을 위한 핵심 포인트]\n","# · 세 잔차 모두 stl_residuals 딕셔너리에 저장 완료\n","# · 기상변수도 동일하게 STL 잔차 추출 후 CCF 적용 예정\n","# · 폭력·흉악은 잔차가 작고 랜덤 → CCF 결과 신뢰도 높음\n","# · 재산범죄는 잔차 변동성이 커서 → CCF 결과 해석 시 주의"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":614},"id":"whuYfyb0EbeG","executionInfo":{"status":"ok","timestamp":1780285636307,"user_tz":-540,"elapsed":1118,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"0bf1f071-fbee-4b4a-a07d-382b19772727"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["STL 잔차 저장 완료 →  stl_residuals 딕셔너리\n","{'violent_rate_working': 'n=132, std=1.507', 'heinous_rate_working': 'n=132, std=0.500', 'property_rate_working': 'n=132, std=5.677'}\n"]}]},{"cell_type":"code","source":["# STEP 6 CCF 매트릭스 (STL 잔차 기반)\n","from statsmodels.tsa.seasonal import STL\n","from statsmodels.tsa.stattools import ccf\n","from scipy.stats import norm\n","\n","crime_vars   = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names  = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","weather_vars = ['heat_index', 'precip_mm', 'tropical_nights', 'sunshine_hours']\n","weather_names= ['불쾌지수', '강수량', '열대야일수', '일조시간']\n","crime_colors = ['steelblue', 'crimson', 'seagreen']\n","\n","# STL 잔차 추출\n","resid_crime   = {}\n","resid_weather = {}\n","\n","for var in crime_vars:\n","    stl = STL(df[var], period=12, robust=True)\n","    resid_crime[var] = stl.fit().resid\n","\n","for var in weather_vars:\n","    stl = STL(df[var], period=12, robust=True)\n","    resid_weather[var] = stl.fit().resid\n","\n","# CCF 플롯 (weather → crime, lag 0~12)\n","fig, axes = plt.subplots(4, 3, figsize=(18, 16))\n","\n","for j, (wvar, wname) in enumerate(zip(weather_vars, weather_names)):\n","    for i, (cvar, cname, color) in enumerate(zip(crime_vars, crime_names, crime_colors)):\n","\n","        ax = axes[j, i]\n","\n","        # CCF: weather 잔차가 crime 잔차를 얼마나 선행하는지\n","        ccf_vals = ccf(resid_weather[wvar], resid_crime[cvar], nlags=12, alpha=0.05)\n","        ccf_coef = ccf_vals[0]\n","        conf     = ccf_vals[1]\n","\n","        lags = range(len(ccf_coef))\n","        ax.bar(lags, ccf_coef, color=color, alpha=0.6, width=0.4)\n","        ax.fill_between(lags,  conf[:, 0] - ccf_coef,\n","                                conf[:, 1] - ccf_coef,\n","                        alpha=0.2, color='gray', label='95% CI')\n","        ax.axhline(0, color='black', linewidth=0.8)\n","        ax.set_title(f'{wname} → {cname}', fontsize=9)\n","        ax.set_xlabel('Lag (월)')\n","        ax.set_ylabel('CCF')\n","        ax.grid(alpha=0.3)\n","\n","plt.suptitle('CCF 매트릭스 (STL 잔차 기반, 기상 → 범죄)', fontsize=15)\n","plt.tight_layout()\n","plt.show()\n","\n","n = len(df)\n","records = []\n","\n","for wvar, wname in zip(weather_vars, weather_names):\n","    for cvar, cname in zip(crime_vars, crime_names):\n","        ccf_coef = ccf(resid_weather[wvar], resid_crime[cvar], nlags=12, alpha=None)\n","        for lag, coef in enumerate(ccf_coef):\n","            se = 1 / np.sqrt(n)\n","            z  = coef / se\n","            p  = 2 * (1 - norm.cdf(abs(z)))\n","            records.append({\n","                '기상변수': wname, '범죄변수': cname,\n","                'Lag': lag, 'CCF': round(coef, 4),\n","                'p값': round(p, 4),\n","                '유의': '✅' if p < 0.05 else ''\n","            })\n","\n","ccf_df = pd.DataFrame(records)\n","sig_df = ccf_df[ccf_df['유의'] == '✅'].reset_index(drop=True)\n","print(\"=== 유의한 CCF (p<0.05) ===\")\n","print(sig_df.to_string(index=False))\n","\n","# 불쾌지수 → 흉악범죄 lag 2가 이론적으로 가장 의미 있는 결과. 열스트레스 누적 후 2개월 지연 효과\n","# 강수량 lag 4~5는 여름 장마(7~8월) 이후 겨울(11~12월) 범죄 패턴과 연결될 수 있음\n","# lag 8~10 유의값들은 계절 주기(12개월) 근처라 기상 직접 효과보다 계절성 잔재일 가능성 → 회귀에서 lag 0~3만 주력으로 사용하는 게 맞음\n","# 열대야 → 폭력 lag 8 음수는 이론적 해석이 어려워 노이즈로 처리하는 게 나을 것 같아요\n","\n","## 회귀 모델 시사점\n","## 실질적으로 의미 있는 단기 시차는 불쾌지수 lag 2 하나"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":834},"id":"3GGYlyHaFsDO","executionInfo":{"status":"ok","timestamp":1780285639054,"user_tz":-540,"elapsed":2744,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"348d1fc7-f84c-43fa-f6b0-377ac9dd050a"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1600 with 12 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["=== 유의한 CCF (p<0.05) ===\n"," 기상변수  범죄변수  Lag     CCF     p값 유의\n"," 불쾌지수 흉악범죄율    2  0.1786 0.0402  ✅\n"," 불쾌지수 흉악범죄율   10  0.1837 0.0349  ✅\n","  강수량 폭력범죄율    5  0.1926 0.0269  ✅\n","  강수량 흉악범죄율    4 -0.2143 0.0138  ✅\n","  강수량 흉악범죄율   10  0.1964 0.0240  ✅\n","열대야일수 폭력범죄율    8 -0.2161 0.0130  ✅\n"]}]},{"cell_type":"code","source":["# STEP 7 비선형 임계점 분석\n","# 불쾌지수: Piecewise Regression\n","# ── Piecewise Regression 저장 ──\n","from scipy import stats\n","\n","crime_vars   = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names  = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","crime_colors = ['steelblue', 'crimson', 'seagreen']\n","threshold    = 68\n","\n","fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n","\n","for i, (cvar, cname, color) in enumerate(zip(crime_vars, crime_names, crime_colors)):\n","\n","    ax = axes[i]\n","    x  = df['heat_index'].values\n","    y  = df[cvar].values\n","\n","    mask_low  = x <= threshold\n","    mask_high = x >  threshold\n","\n","    ax.scatter(x[mask_low],  y[mask_low],\n","               color=color, alpha=0.3, s=20, label=f'불쾌지수 ≤{threshold}')\n","    ax.scatter(x[mask_high], y[mask_high],\n","               color='darkorange', alpha=0.5, s=20, label=f'불쾌지수 >{threshold}')\n","\n","    for mask, c in [(mask_low, color), (mask_high, 'darkorange')]:\n","        if mask.sum() >= 5 and len(np.unique(x[mask])) > 1:\n","            m, b, r, p, _ = stats.linregress(x[mask], y[mask])\n","            x_line = np.linspace(x[mask].min(), x[mask].max(), 100)\n","            ax.plot(x_line, m * x_line + b, color=c, linewidth=2)\n","\n","    ax.axvline(threshold, color='red', linestyle='--', linewidth=1.2,\n","               label=f'임계점={threshold}')\n","    ax.set_title(f'불쾌지수 × {cname}\\n임계점={threshold}', fontsize=10)\n","    ax.set_xlabel('불쾌지수')\n","    ax.set_ylabel(cname)\n","    ax.legend(fontsize=7)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('불쾌지수 Piecewise Regression (임계점=68)', fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# [폭력범죄]\n","# · 68 이하(파랑): 양의 기울기 → 불쾌지수 오를수록 폭력범죄 증가\n","# · 68 초과(주황): 기울기 역전 → 오히려 감소\n","# · 해석: 불쾌지수가 임계점을 넘으면 너무 더워서\n","#         외출 자체가 줄어들고 사회접촉이 감소\n","#         → 야외 폭력범죄 기회가 줄어드는 효과\n","# · 의미: 기상-범죄 관계가 단순 선형이 아님을 보여주는 근거\n","#         \"더울수록 무조건 범죄 증가\"는 과단순화\n","\n","# [흉악범죄]\n","# · 68 이하·초과 모두 양의 기울기 유지\n","# · 임계점 전후 기울기 변화 거의 없음\n","# · 해석: 흉악범죄는 불쾌지수의 임계점 효과가 없음\n","#         낮 시간 체감 온도보다 야간 고온(열대야)이\n","#         더 직접적인 경로로 작용하기 때문\n","#         → 불쾌지수 전 구간에서 선형 증가가 지배적\n","\n","# [재산범죄]\n","# · 68 이하(초록): 완만한 양의 기울기\n","# · 68 초과(주황): 기울기 가파르게 증가 → 가속 효과\n","# · 해석: 불쾌지수 임계점 초과 시 재산범죄가 더 빠르게 증가\n","#         극도의 더위에서 사람들이 야외에 물건을 두거나\n","#         창문을 열어두는 등 범죄 노출 기회 증가 가능성\n","\n","# [가설 검증 기여]\n","# · H6 (임계점 초과 시 범죄 급증):\n","#   폭력: 역전(감소) → 급증 아님 → H6 기각\n","#   흉악: 선형 유지 → 임계점 효과 없음 → H6 기각\n","#   재산: 가속 → 부분적으로 H6 지지\n","#   → 세 범죄 모두에서 일관된 급증 패턴 없음\n","#   → 불쾌지수의 효과는 임계점보다 연속 선형 효과가 지배적\n","#   판정: H6 부분 지지 (범죄 유형별 상이, 전반적으로 기각에 가까움)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":254},"id":"dXucYlx2IMT-","executionInfo":{"status":"ok","timestamp":1780285639732,"user_tz":-540,"elapsed":668,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"67d8cf84-1d1e-47a0-e964-8033e5fed844"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ── 열대야 그룹 비교 저장 ──\n","from scipy.stats import ttest_ind\n","\n","group_no  = df[df['tropical_nights'] == 0]\n","group_yes = df[df['tropical_nights'] >  0]\n","\n","fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n","\n","for i, (cvar, cname, color) in enumerate(zip(crime_vars, crime_names, crime_colors)):\n","\n","    ax = axes[i]\n","\n","    data = [group_no[cvar].values, group_yes[cvar].values]\n","    bp   = ax.boxplot(data, patch_artist=True,\n","                      labels=['열대야 없음', '열대야 있음'])\n","\n","    bp['boxes'][0].set_facecolor(color)\n","    bp['boxes'][0].set_alpha(0.4)\n","    bp['boxes'][1].set_facecolor('darkorange')\n","    bp['boxes'][1].set_alpha(0.6)\n","\n","    t_stat, p_val = ttest_ind(group_no[cvar], group_yes[cvar])\n","    sig = '***' if p_val < 0.001 else '**' if p_val < 0.01 else '*' if p_val < 0.05 else 'n.s.'\n","    ax.set_title(f'열대야 유무 × {cname}\\nt={t_stat:.2f}, p={p_val:.3f} {sig}',\n","                 fontsize=10)\n","    ax.set_ylabel(cname)\n","    ax.grid(axis='y', alpha=0.3)\n","\n","plt.suptitle('열대야 유무 그룹 비교 (t검정)', fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# [폭력범죄] t=-2.36, p=0.020 *\n","# · 열대야 없음 중앙값: 약 47\n","# · 열대야 있음 중앙값: 약 50\n","# · 유의한 차이 존재 (p<0.05)\n","# · 단, 박스 겹치는 구간이 넓어 차이가 크지는 않음\n","# · 열대야 있는 달에 폭력범죄가 높은 경향\n","#   → 야간 고온이 폭력범죄에도 영향을 주나\n","#     낮 시간 사회접촉 증가 효과가 더 주된 경로\n","\n","# [흉악범죄] t=-7.25, p=0.000 *** ← 압도적\n","# · 열대야 없음 중앙값: 약 8.0\n","# · 열대야 있음 중앙값: 약 9.8\n","# · 약 22% 높음 → 세 범죄 중 가장 강한 열대야 효과\n","# · 박스가 거의 겹치지 않음 → 두 그룹의 차이가 뚜렷\n","# · t값 절댓값이 7.25로 매우 큼 → 우연일 가능성 극히 낮음\n","# · 해석: 야간 고온(열대야) → 수면 부족 → 충동 조절 저하\n","#         → 흉악범죄 증가 경로가 가장 직접적으로 작용\n","# · 선행연구(Anderson 2001) 고온-공격성 관계와 일치\n","\n","# [재산범죄] t=-3.05, p=0.003 **\n","# · 열대야 없음 중앙값: 약 135\n","# · 열대야 있음 중앙값: 약 148\n","# · 유의한 차이 존재 (p<0.01)\n","# · 열대야 있는 달에 재산범죄도 높음\n","# · 단, 재산범죄는 장기 추세가 강해서\n","#   열대야 효과인지 연도 효과인지 완전히 분리하기 어려움\n","#   → 회귀에서 교란변수 통제 후 재확인 필요\n","\n","# [가설 검증 기여]\n","# · H1 (기상변수↑ → 범죄↑):\n","#   열대야 있는 달이 없는 달보다 세 범죄 모두 유의하게 높음\n","#   → H1 추가 지지. 특히 흉악범죄에서 가장 강한 신호\n","#   판정: H1 지지 (열대야 관점)\n","#\n","# · H3 (폭력범죄가 기상에 더 민감):\n","#   흉악범죄 t=-7.25 >> 폭력범죄 t=-2.36\n","#   → 폭력보다 흉악이 열대야에 더 민감\n","#   → H3 기각 근거 추가 (흉악이 더 민감)\n","#   판정: H3 기각 방향 강화"],"metadata":{"colab":{"base_