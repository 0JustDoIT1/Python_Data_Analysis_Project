rol_vars = ['unemp_rate', 'covid_dummy']\n","\n","results_compare = []\n","\n","for cvar, cname in zip(crime_vars, crime_names):\n","\n","    y = df[cvar]\n","\n","    for weather_var, label in [('temp_avg', '단순기온'),\n","                                ('heat_index', '불쾌지수')]:\n","\n","        X = df[[weather_var] + control_vars].copy()\n","        valid   = X.notna().all(axis=1) & y.notna()\n","        X, y_   = X[valid], y[valid]\n","        X_const = sm.add_constant(X)\n","        model   = sm.OLS(y_, X_const).fit(cov_type='HC3')\n","\n","        results_compare.append({\n","            '범죄유형': cname,\n","            '변수': label,\n","            'R²': round(model.rsquared, 4),\n","            'Adj.R²': round(model.rsquared_adj, 4),\n","            'AIC': round(model.aic, 2),\n","            '기상계수': round(model.params[weather_var], 4),\n","            'p값': round(model.pvalues[weather_var], 4),\n","            '유의': '✅' if model.pvalues[weather_var] < 0.05 else '❌'\n","        })\n","\n","compare_df = pd.DataFrame(results_compare)\n","\n","print(\"=== 불쾌지수 vs 단순기온 회귀 비교 ===\\n\")\n","for cname in crime_names:\n","    sub = compare_df[compare_df['범죄유형'] == cname]\n","    print(f\"[{cname}]\")\n","    print(sub[['변수', 'R²', 'Adj.R²', 'AIC', '기상계수', 'p값', '유의']].to_string(index=False))\n","    r2_temp = sub[sub['변수']=='단순기온']['R²'].values[0]\n","    r2_heat = sub[sub['변수']=='불쾌지수']['R²'].values[0]\n","    print(f\"  → R² 개선: {r2_temp:.4f} → {r2_heat:.4f} ({(r2_heat-r2_temp)*100:+.2f}%p)\\n\")\n","\n","# 시각화\n","fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n","colors_bar = ['steelblue', 'crimson', 'seagreen']\n","x = np.arange(2)\n","\n","for i, (cname, color) in enumerate(zip(crime_names, colors_bar)):\n","    sub    = compare_df[compare_df['범죄유형'] == cname]\n","    r2vals = sub['R²'].values\n","    labels = sub['변수'].values\n","    pvals  = sub['p값'].values\n","\n","    bars = axes[i].bar(labels, r2vals, color=[color, 'darkorange'],\n","                       alpha=0.7, width=0.4)\n","\n","    for bar, pval in zip(bars, pvals):\n","        sig = '***' if pval < 0.001 else '**' if pval < 0.01 else '*' if pval < 0.05 else 'n.s.'\n","        axes[i].text(bar.get_x() + bar.get_width()/2,\n","                     bar.get_height() + 0.003,\n","                     sig, ha='center', fontsize=11)\n","\n","    axes[i].set_title(f'{cname}\\nR² 비교', fontsize=11)\n","    axes[i].set_ylabel('R²')\n","    axes[i].set_ylim(0, max(r2vals) * 1.2)\n","    axes[i].grid(axis='y', alpha=0.3)\n","\n","plt.suptitle('불쾌지수 vs 단순기온 — 범죄율 설명력(R²) 비교', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# 추가 분석 4 — 불쾌지수 vs 단순기온 비교 결과 해석\n","#\n","# [결과 요약]\n","# · 세 범죄 모두 단순기온 R²가 불쾌지수보다 미세하게 높음\n","#   폭력: 0.6563 vs 0.6509 (-0.54%p)\n","#   흉악: 0.6170 vs 0.6150 (-0.20%p)\n","#   재산: 0.2795 vs 0.2757 (-0.38%p)\n","# · 두 변수 모두 p=0.000으로 유의\n","# · AIC도 단순기온이 소폭 낮음 (모델 적합도 미세하게 우수)\n","#\n","# [해석]\n","# · R² 차이가 최대 0.54%p로 사실상 두 변수의 설명력은 동등\n","# · 단순기온이 미세하게 앞서는 이유:\n","#   → 불쾌지수는 기온+습도 합성이라 변수가 복잡해지면서\n","#     습도의 노이즈가 일부 포함될 수 있음\n","#   → 단순 회귀(교란변수 2개만 통제)에서는\n","#     기온의 직접 효과가 더 깔끔하게 추정됨\n","#\n","# [그러면 왜 불쾌지수를 선택했는가?]\n","# · R² 차이가 통계적으로 유의미한 수준이 아님 (0.5%p 미만)\n","#   → 두 변수의 설명력은 실질적으로 동등\n","# · 불쾌지수는 기온+습도를 합성하여 다중공선성 문제를 해결\n","#   (temp_avg와 humidity_avg를 동시에 넣으면 r=0.76 공선성 발생)\n","# · 이론적 근거: 불쾌지수는 인간이 실제로 느끼는 열 불쾌감을\n","#   반영하는 지표로, 단순 기온보다 행동·심리에 더 직접적\n","#   (Thom 1957, Anderson 2001)\n","# · 실용적 근거: 기상청이 불쾌지수를 실시간 예보하므로\n","#   정책 연동(치안 경보) 시 즉시 활용 가능\n","#\n","# [결론]\n","# · 예측력(R²) 기준으로는 단순기온과 불쾌지수가 동등\n","# · 불쾌지수 선택은 R² 우위가 아닌\n","#   다중공선성 해결 + 이론적 타당성 + 정책 활용성 근거\n","# · 발표 서술:\n","#   \"단순기온과 불쾌지수의 설명력(R²)은 통계적으로 동등하나,\n","#    불쾌지수는 기온·습도를 합성하여 다중공선성 문제를 해결하고\n","#    인체 체감 열스트레스를 직접 반영한다는 이론적 우위와\n","#    기상청 실시간 예보 연동 가능성으로 채택하였다.\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":637},"id":"5ef4AUxU8FLA","executionInfo":{"status":"ok","timestamp":1780285705938,"user_tz":-540,"elapsed":2154