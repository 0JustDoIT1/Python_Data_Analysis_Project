개선 — 반사실선 추가\n","fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n","\n","for ax, cvar, cname, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    model   = results_its[cvar]\n","    df_plot = df_its[df_its[cvar].notna()].copy()\n","\n","    # ── 실제 ITS 적합값 ──\n","    X_plot = sm.add_constant(df_plot[['time', 'intervention', 'time_after']])\n","    fitted = model.predict(X_plot)\n","\n","    # ── 반사실선: 코로나가 없었다면? ──\n","    # intervention=0, time_after=0으로 설정\n","    df_counter = df_plot.copy()\n","    df_counter['intervention'] = 0\n","    df_counter['time_after']   = 0\n","    X_counter  = sm.add_constant(df_counter[['time', 'intervention', 'time_after']])\n","    counterfactual = model.predict(X_counter)\n","\n","    # 코로나 전/후 구간 분리\n","    pre  = df_plot.index < covid_start\n","    post = df_plot.index >= covid_start\n","\n","    ax.plot(df_plot.index, df_plot[cvar],\n","            color=color, alpha=0.3, linewidth=1.2, label='실제값')\n","\n","    # 코로나 전 적합선\n","    ax.plot(df_plot.index[pre], fitted[pre],\n","            color=color, linewidth=2.5, label='코로나 전 추세')\n","\n","    # 코로나 후 실제 적합선\n","    ax.plot(df_plot.index[post], fitted[post],\n","            color=color, linewidth=2.5)\n","\n","    # 반사실선 (코로나가 없었다면)\n","    ax.plot(df_plot.index[post], counterfactual[post],\n","            color=color, linewidth=2.0,\n","            linestyle=':', alpha=0.6, label='반사실 (코로나 없었다면)')\n","\n","    # 수준 변화 화살표 (intervention)\n","    intervention_time = df_plot.index[df_plot.index >= covid_start][0]\n","    actual_val   = fitted[df_plot.index == intervention_time].values[0]\n","    counter_val  = counterfactual[df_plot.index == intervention_time].values[0]\n","\n","    if abs(actual_val - counter_val) > 0.5:\n","        ax.annotate('',\n","                    xy=(intervention_time, actual_val),\n","                    xytext=(intervention_time, counter_val),\n","                    arrowprops=dict(arrowstyle='<->', color='black',\n","                                   lw=1.5))\n","        mid_val = (actual_val + counter_val) / 2\n","        coef_i  = model.params['intervention']\n","        p_i     = model.pvalues['intervention']\n","        sig     = '***' if p_i < 0.001 else '**' if p_i < 0.01 \\\n","                  else '*' if p_i < 0.05 else 'n.s.'\n","        ax.text(intervention_time + pd.DateOffset(months=2), mid_val,\n","                f'Δ={coef_i:.2f}{sig}',\n","                fontsize=9, color='black', va='center')\n","\n","    ax.axvline(covid_start, color='red', linestyle='--',\n","               linewidth=1.5, label='코로나 시작(2020.03)')\n","    ax.axvline(covid_end, color='orange', linestyle='--',\n","               linewidth=1.5, label='코로나 종료(2022.04)')\n","    ax.axvspan(covid_start, covid_end, color='gray', alpha=0.1)\n","\n","    # time_after 계수 표시\n","    coef_ta = model.params['time_after']\n","    p_ta    = model.pvalues['time_after']\n","    sig_ta  = '***' if p_ta < 0.001 else '**' if p_ta < 0.01 \\\n","              else '*' if p_ta < 0.05 else 'n.s.'\n","    ax.text(0.72, 0.08,\n","            f'추세 변화: {coef_ta:+.3f}/월 {sig_ta}',\n","            transform=ax.transAxes,\n","            fontsize=9, color=color,\n","            bbox=dict(boxstyle='round,pad=0.3',\n","                      facecolor='white', alpha=0.8))\n","\n","    ax.set_title(f'{cname} — ITS 분석 (반사실선 포함)')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=8, loc='upper right')\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('ITS 분석 — 코로나 전후 구조 변화\\n(점선=반사실, 실선=실제 추세)',\n","             fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","print(\"✅ ITS_result.png 저장 완료\")\n","\n","# [ITS 변수 의미]\n","# · const:        코로나 이전 기저 수준\n","# · time:         코로나 이전 월별 추세 기울기\n","# · intervention: 코로나 시작 시점의 즉각적 수준 변화\n","# · time_after:   코로나 이후 추세 기울기 변화\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [폭력범죄] R²=0.516\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · intervention: -2.10 (p=0.557) ❌ 유의하지 않음\n","# · time_after:   -0.05 (p=0.261) ❌ 유의하지 않음\n","# · 해석: 코로나가 폭력범죄에 구조적 변화를 만들지 않음\n","#   코로나 이전부터 하락 추세(time=-0.042)가 있었고\n","#   코로나는 그 추세를 바꾸지 않았음\n","#   → 그래프에서 ITS 적합선이 전후 자연스럽게 이어지는 것 확인\n","#   → 폭력범죄는 코로나와 무관한 독자적 하락 추세\n","#\n","# · STEP 8 회귀에서 covid_dummy가 유의했던 것과 차이 주목\n","#   회귀는 코로나 구간의 수준 차이를 포착\n","#   ITS는 추세 기울기 변화를 포착 → 다른 질문에 답하는 것\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [흉악범죄] R²=0.178\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · time:         +0.001 (p=0.929) ❌\n","#   → 코로나 이전 흉악범죄 추세 없음 (수평 유지 재확인)\n","# · intervention: -2.327 (p=0.029) ✅\n","#   → 코로나 시작 시점 즉각 2.33 감소\n","#   → 거리두기로 사회접촉 감소 → 흉악범죄 기회 감소\n","# · time_after:   +0.034 (p=0.009) ✅\n","#   → 코로나 이후 매달 0.034씩 증가하는 상승 기울기로 전환\n","#   → 해제까지 26개월 × 0.034 = 약 0.88 누적 상승\n","# · 해석: 억제(-2.33) → 반동 상승(+0.034/월) 패턴\n","#   코로나가 흉악범죄의 구조 자체를 바꾼 것\n","#   → 그래프에서 2020년 꺾임 후 우상향 적합선 확인\n","# · R²=0.178로 낮음 → ITS 모델이 흉악범죄 변동을\n","#   충분히 설명하지 못함. 기상·계절 변동이 크기 때문\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [재산범죄] R²=0.504\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · time:         -0.034 (p=0.593) ❌\n","#   → 코로나 이전 추세 포착 안 됨\n","#   (2017~2019 상승 추세가 모델에 반영되지 않음)\n","# · intervention: -50.742 (p=0.000) ✅\n","#   → 코로나 시작 시점 즉각 50.7 급락\n","#   → 세 범죄 중 가장 큰 즉각 억제 효과\n","#   → 오프라인 활동 급감 → 재산범죄 기회 소멸\n","# · time_after:   +0.702 (p=0.000) ✅\n","#   → 코로나 이후 매달 0.70씩 강한 상승 기울기\n","#   → 26개월 × 0.70 = 약 18.2 누적 상승\n","# · 해석: 가장 크게 억제(-50.74) → 가장 빠른 반등(+0.702/월)\n","#   현재까지 상승 지속 중\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [기상 분석 관점 함의]\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 흉악·재산범죄의 2022년 이후 급등은\n","#   기상 효과가 아닌 코로나 해제 반동으로 설명됨\n","# · 이 구간의 기상-범죄 분석 시 코로나 효과를\n","#   반드시 통제해야 하는 근거\n","# · STEP 8 회귀에서 covid_dummy를 포함한 이유이자\n","#   코로나 전후 분리 분석의 필요성 재확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [가설 검증 기여]\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · H1 (기상변수↑ → 범죄↑) 보완:\n","# 