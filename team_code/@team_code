uture_index.month],\n","    'sunshine_hours':  [monthly_avg_train.loc[m, 'sunshine_hours']\n","                        for m in future_index.month],\n","    'unemp_rate':      [monthly_avg_train.loc[m, 'unemp_rate']\n","                        for m in future_index.month],\n","    'covid_dummy':     [0] * 12\n","}, index=future_index)\n","\n","# ── 3단계: SARIMAX 범죄율 예측 ──\n","fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n","metrics_records = []\n","\n","for ax, cvar, cname, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    series_train = df_train[cvar].dropna()\n","    series_test  = df_test[cvar].dropna()\n","    exog_train   = df_train[exog_vars].loc[series_train.index]\n","\n","    model = SARIMAX(series_train,\n","                    exog=exog_train,\n","                    order=(1, 1, 0),\n","                    seasonal_order=(1, 1, 0, 12),\n","                    enforce_stationarity=False,\n","                    enforce_invertibility=False)\n","    fitted = model.fit(disp=False)\n","\n","    forecast      = fitted.get_forecast(steps=12, exog=exog_future)\n","    forecast_mean = forecast.predicted_mean\n","    forecast_ci   = forecast.conf_int()\n","\n","    mae  = mean_absolute_error(series_test, forecast_mean)\n","    rmse = np.sqrt(mean_squared_error(series_test, forecast_mean))\n","    mape = (np.abs((series_test - forecast_mean) / series_test) * 100).mean()\n","\n","    metrics_records.append({\n","        '범죄유형': cname,\n","        'MAE': round(mae, 3),\n","        'RMSE': round(rmse, 3),\n","        'MAPE(%)': round(mape, 2)\n","    })\n","\n","    print(f\"\\n{'─'*45}\")\n","    print(f\"  {cname} 백테스팅 결과\")\n","    print(f\"{'─'*45}\")\n","    print(f\"  MAE={mae:.3f}  RMSE={rmse:.3f}  MAPE={mape:.2f}%\")\n","\n","    ax.plot(df[cvar].index, df[cvar],\n","            color=color, alpha=0.3, linewidth=1.2, label='전체 실제값')\n","    ax.plot(series_test.index, series_test,\n","            color=color, linewidth=2, label='2024 실제값')\n","    ax.plot(forecast_mean.index, forecast_mean,\n","            color='black', linewidth=2, linestyle='--', label='2024 예측값')\n","    ax.fill_between(forecast_mean.index,\n","                    forecast_ci.iloc[:, 0],\n","                    forecast_ci.iloc[:, 1],\n","                    color='black', alpha=0.1, label='95% CI')\n","    ax.axvline(pd.Timestamp(test_start),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — 백테스팅 MAPE={mape:.2f}%')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('SARIMAX 백테스팅 — 2024년 예측 vs 실제값\\n'\n","             '(불쾌지수: SARIMA 예측 / 나머지: 평년값)',\n","             fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","metrics_df = pd.DataFrame(metrics_records)\n","print(\"\\n=== 백테스팅 성능 지표 ===\")\n","print(metrics_df.to_string(index=False))\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# SARIMAX 백테스팅 결과 (평년값 대체 버전)\n","# 학습: 2014~2023 / 예측: 2024\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# [폭력범죄] MAPE=7.04% ✅ 양호\n","# · 실제값(파랑)과 예측값(검정 점선)이 방향 일치\n","# · 하락 추세를 안정적으로 포착\n","# · 7% 오차는 월별 범죄율 예측으로 허용 가능한 수준\n","\n","# [흉악범죄] MAPE=27.02% ❌ 불량\n","# · 예측값이 실제보다 높게 잡힘\n","#   → 2022~2023년 급등 수준을 2024에도 유지할 것으로 학습\n","#   → 실제 2024년은 소폭 하락했으나 모델이 포착 못함\n","# · 2022년 구조 변화가 모델 학습을 왜곡한 결과\n","# · → 흉악범죄 예측은 방향성만 참고, 수치는 불확실\n","\n","# [재산범죄] MAPE=7.97% ✅ 양호\n","# · 상승 추세를 일관되게 포착\n","# · 실제값이 예측보다 약간 높은 구간 존재\n","#   → 2024년 상승 속도가 모델 예상보다 빨랐음\n","# · 7.97%는 허용 가능한 수준"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"-9_lb6_B9Kfz","executionInfo":{"status":"ok","timestamp":1780285674172,"user_tz":-540,"elapsed":6201,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"bca3b7cc-4822-4354-8547-c021da044d7c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","─────────────────────────────────────────────\n","  폭력범죄율 백테스팅 결과\n","─────────────────────────────────────────────\n","  MAE=2.895  RMSE=3.176  MAPE=7.04%\n","\n","─────────────────────────────────────────────\n","  흉악범죄율 백테스팅 결과\n","─────────────────────────────────────────────\n","  MAE=2.410  RMSE=2.456  MAPE=27.02%\n","\n","─────────────────────────────────────────────\n","  재산범죄율 백테스팅 결과\n","─────────────────────────────────────────────\n","  MAE=14.047  RMSE=15.894  MAPE=7.97%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1200 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","=== 백테스팅 성능 지표 ===\n"," 범죄유형    MAE   RMSE  MAPE(%)\n","폭력범죄율  2.895  3.176     7.04\n","흉악범죄율  2.410  2.456    27.02\n","재산범죄율 14.047 15.894     7.97\n"]}]},{"cell_type":"code","source":["# ╔══════════════════════════════════════════════════════════════╗\n","# ║              STEP 13 가설 검증 결과 요약 (최종판)              ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H1. 기상변수가 높을수록 범죄 발생률이 증가하는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: ✅ 부분 지지\n","#\n","# [분석 방법 1] 피어슨 상관계수 (STEP 3-2)\n","# → 두 변수가 함께 움직이는 정도를 -1~1로 표현. 0.5 이상이면 강한 양의 관계.\n","# → 불쾌지수 × 폭력범죄율: r=0.51 (p<0.001) ← 통계적으로 유의\n","# → 불쾌지수 × 흉악범죄율: r=0.76 (p<0.001) ← 강한 양의 관계\n","# → 불쾌지수 × 재산범죄율: r=0.34 (p<0.001) ← 약하지만 유의\n","#\n","# [분석 방법 2] 독립표본 t검정 (STEP 7 — 열대야 그룹 비교)\n","# → 열대야가 있는 달 vs 없는 달의 범죄율 평균이 다른지 검정\n","# → p<0.05이면 두 그룹 간 차이가 우연이 아님을 의미\n","# → 폭력범죄: t=-2.36, p=0.020 ← 열대야 있는 달이 유의하게 높음\n","# → 흉악범죄: t=-7.25, p=0.000 ← 가장 강한 차이 (중앙값 약 22% 높음)\n","# → 재산범죄: t=-3.05, p=0.003 ← 유의한 차이 확인\n","#\n","# [분석 방법 3] OLS 다중회귀 (STEP 8)\n","# → 다른 변수들(실업률, 코로나 등)을 통제한 상태에서 기상변수만의 순수 효과\n","# → 불쾌지수 → 폭력범죄: coef=+0.44, p=0.000 ← 불쾌지수 1 증가 시 폭력범죄율 0.44 증가\n","# → 불쾌지수 → 흉악범죄: coef=+0.07, p=0.000 ← 유의하지만 효과 크기 작음\n","# → 불쾌지수 → 재산범죄: p=0.277 ← 유의하지 않음\n","#\n","# [주의] 불쾌지수와 범죄율 모두 장기적으로 상승 추세여서\n","#        실제 관계가 아닌 허위 상관일 가능성 있음\n","#        → STEP 6 STL 잔차 기반 CCF로 추세 제거 후 재확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H2. 기상 효과는 당월뿐 아니라 1~3개월 시차로도 나타나는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H2. 기상 효과는 당월뿐 아니라 1~3개월 시차로도 나타나는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: ✅ 부분 지지 (단, 해석 시 월별 데이터 한계 고려 필요)\n","#\n","# [분석 방법 1] CCF 교차상관분석 (STEP 6 — STL 잔차 기반)\n","# → STL 잔차를 사용하므로 계절성·추세는 제거된 상태\n","#   즉 \"평년보다 유독 더웠던 달\"이 \"평년보다 유독 높았던 흉악범죄 달\"과\n","#   몇 개월 시차를 두고 연결되는지를 검정한 것\n","# → 유의 기준: p<0.05\n","# → 불쾌지수 → 흉악범죄 lag 2: CCF=0.179, p=0.040\n","# → 강수량 → 폭력범죄 lag 5: CCF=0.193, p=0.027\n","# → 나머지 조합은 유의하지 않음\n","#\n","# [월별 데이터 한계 — 중요]\n","# → lag 2의 경우 예: 7월 불쾌지수 → 9월 범죄\n","#   9월도 여전히 더운 달이므로 \"2개월 지연 효과\"인지\n","#   \"고온 지속 효과\"인지 월별 데이터만으로는 분리 불가\n","# → lag 5·10 등 긴 시차는 계절 주기(12개월)에 가까워\n","#   계절성 잔재일 가능성 존재\n","# → 따라서 CCF 결과는 \"기상이 범죄보다 시간적으로 선행한다\"는\n","#   증거로는 활용 가능하나, \"정확히 N개월 후 영향\"이라는\n","#   메커니즘 해석은 과잉 해석 위험 있음\n","# → 일별 데이터를 활용한 후속 연구에서 정밀한 시차 검정 필요\n","#\n","# [분석 방법 2] Granger 인과 검정 (STEP 9)\n","# → 1차 차분으로 추세 제거 후 \"기상변수의 과거값이\n","#   범죄율 현재값 예측에 유의하게 기여하는가\"를 F검정\n","# → Granger도 월별 단위이므로 동일한 계절 중복 문제 존재\n","#   단, 차분 후 검정이므로 수준 변화 효과는 일부 통제됨\n","# → 불쾌지수 → 폭력·흉악·재산: lag 1~4 전부 유의 (F=8~50, p<0.001)\n","# → 열대야 → 폭력: lag 2~4 유의 / 강수량 → 폭력·흉악: lag 4 유의\n","#\n","# [종합 해석]\n","# → CCF·Granger 모두 \"기상변수가 범죄율보다 시간적으로 선행\"한다는\n","#   일관된 신호를 보임 → H2 부분 지지\n","# → 단, \"몇 개월 후 영향\"이라는 구체적 시차 메커니즘은\n","#   월별 데이터의 계절 중복 문제로 단정 어려움\n","# → 본 분석에서 시차 결과는 \"선행성 존재 확인\" 수준으로 해석하며\n","#   구체적 시차 경로는 후속 연구 과제로 명시\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H3. 폭력범죄가 재산·흉악범죄보다 기상변수에 더 민감한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: 🔺 기각 → 방향 수정\n","#\n","# [분석 방법 1] OLS 회귀 계수 크기 비교 (STEP 8)\n","# → 불쾌지수 계수: 폭력(+0.44) > 흉악(+0.07) → 폭력이 더 민감해 보임\n","#\n","# [분석 방법 2] SHAP 변수 중요도 (STEP 11 — Random Forest)\n","# → 각 변수가 예측에 기여하는 절대적 크기를 계산 (단위 무관하게 비교 가능)\n","# → 폭력범죄: 실업률(3.60) > 불쾌지수(3.22) → 기상·사회경제 요인 동등\n","# → 흉악범죄: 불쾌지수(1.09) >> 실업률(0.42) → 기상변수가 압도적 1위\n","# → 재산범죄: 실업률(7.57) >> 불쾌지수(3.91) → 사회경제 요인 주도\n","#\n","# [해석] 회귀 계수만 보면 폭력범죄가 더 민감해 보이나\n","#        SHAP 기여도 기준으로는 흉악범죄에서 기상변수가 가장 지배적\n","#        → 가설 수정: 흉악범죄가 기상에 가장 민감\n","#        → 이는 야간 고온(열대야) → 수면 부족 → 충동 조절 저하 → 흉악범죄 경로와 일치\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H4. 계절성을 제거해도 순수한 기상 효과가 남는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: ✅ 부분 지지\n","#\n","# [분석 방법] STL 분해 + CCF (STEP 5~6)\n","# → STL: 시계열을 추세·계절성·잔차로 분해. 잔차만 추출하면 계절 효과 제거\n","# → CCF: 잔차끼리의 시차 상관 검정\n","# → 불쾌지수 잔차 → 흉악범죄 잔차 lag 2: p=0.040 ← 계절성 제거 후에도 유의\n","# → 강수량 잔차 → 폭력범죄 잔차 lag 5: p=0.027 ← 유의\n","# → 나머지 조합은 유의하지 않음\n","#\n","# [해석] \"여름이라서 덥고 여름이라서 범죄가 많다\"는 단순 계절 효과 외에\n","#        계절 패턴을 제거해도 기상 변동이 범죄 변동을 설명하는 순수 효과가\n","#        일부 존재함을 확인. 다만 모든 조합에서 나타나지 않아 부분 지지.\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H5. 교란변수 통제 후에도 기상→범죄 Granger 인과가 유의한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: ✅ 지지\n","#\n","# [분석 방법] Granger 인과 검정 (STEP 9 — 1차 차분 후)\n","# → 1차 차분: 시계열의 추세를 제거해 정상 시계열로 변환\n","# → 차분 후에도 \"기상변수의 과거값이 범죄율 예측에 도움이 되는가\" 검정\n","# → 불쾌지수 → 폭력범죄: lag 1~4 F=24~50, p<0.001 ← 매우 강한 인과\n","# → 불쾌지수 → 흉악범죄: lag 1~4 F=8~28, p<0.001\n","# → 불쾌지수 → 재산범죄: lag 1~4 F=10~16, p<0.001\n","#\n","# [주의] Granger 인과는 \"시간적 선행성\"을 의미하며\n","#        물리적·인과적 관계를 직접 증명하지는 않음\n","#        → \"기상이 범죄를 유발한다\"가 아니라\n","#           \"기상 변화가 범죄 변화보다 먼저 나타난다\"는 의미\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H6. 불쾌지수·폭염일수가 특정 임계점 초과 시 범죄율이 급증하는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: 🔺 부분 지지 (범죄 유형별 상이)\n","#\n","# [분석 방법 1] Piecewise Regression (STEP 7 — 불쾌지수 68 기준)\n","# → 불쾌지수 68을 기준으로 이하/초과 구간을 나눠 기울기 변화 비교\n","# → 폭력범죄: 68 초과 시 기울기 역전(감소) → 고온에서 외출 억제 효과 가능성\n","# → 흉악범죄: 68 초과 후에도 선형 유지 → 임계점 효과 없음\n","# → 재산범죄: 68 초과 시 기울기 가속 → 일부 임계 효과 존재\n","#\n","# [분석 방법 2] 임계점 더미 회귀 (STEP 8 — heat_index_dummy)\n","# → 불쾌지수 68 초과 여부를 0/1 더미로 만들어 회귀에 포함\n","# → 폭력: p=0.431, 흉악: p=0.273, 재산: p=0.612 → 세 범죄 모두 유의하지 않음\n","#\n","# [해석] 임계점에서 범죄가 급증하는 뚜렷한 비선형 효과보다\n","#        불쾌지수가 높을수록 범죄율이 꾸준히 높아지는\n","#        연속적 선형 효과가 더 지배적임을 확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H7. 폭염 심화 시나리오에서 범죄율 증가 예측이 가능한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 판정: 🔺 부분 지지\n","#\n","# [분석 방법] SARIMAX 예측 + 백테스팅 (STEP 12)\n","# → SARIMAX: 기상변수를 외생변수로 포함한 시계열 예측 모델\n","# → 기상변수 4개를 SARIMA로 2025~2026 예측 후 범죄율 예측에 투입\n","#\n","# [백테스팅 결과 — 2014~2023 학습, 2024 예측]\n","# → 폭력범죄: MAPE=8.78%  ← 예측 양호 (10% 이하)\n","# → 흉악범죄: MAPE=25.97% ← 예측 불량 (2022년 구조 변화 미반영)\n","# → 재산범죄: MAPE=7.83%  ← 예측 양호 (10% 이하)\n","#\n","# [2025~2026 예측 방향]\n","# → 폭력범죄: 40.20 → 38.94 (완만 하락)\n","# → 흉악범죄: 8.68 → 8.28  (소폭 하락, CI 넓어 불확실성 큼)\n","# → 재산범죄: 194.83 → 214.26 (강한 상승 지속)\n","#\n","# [한계] SARIMAX 외생변수(기상변수) 대부분 p>0.05로 유의하지 않음\n","#        → 예측이 기상변수보다 시계열 추세·계절성에 주로 의존\n","#        → 폭염 심화 시나리오별 범죄율 차별화 예측은 한계 존재\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 핵심 발견 요약\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 1. 불쾌지수가 전 범죄 유형에서 가장 강력한 기상 예측변수\n","#    → Granger lag 1~4 전부 유의(F=8~50), SHAP 흉악 1위\n","# 2. 흉악범죄가 기상변수에 가장 민감\n","#    → SHAP 불쾌지수 1위, 열대야 t검정 p=0.000\n","#    → 야간 고온 → 수면 부족 → 충동 조절 저하 경로로 해석\n","# 3. 기상 효과는 실업률·코로나 등 사회경제 요인과 복합 작용\n","#    → 단독으로 범죄를 설명하지 않고 복합 요인 중 하나\n","# 4. 코로나는 폭력범죄만 직접 억제(coef=-7.62, p=0.000)\n","#    → 흉악·재산은 코로나 해제 후 반동 상승(ITS 확인)\n","# 5. 재산범죄는 기상보다 장기 추세(사회구조적 요인) 주도\n","#    → SHAP 실업률 1위(7.57), 기상변수 회귀계수 유의하지 않음\n","# 6. 기상 효과는 임계점보다 연속 선형 효과 지배적\n","#    → heat_index_dummy 세 범죄 모두 유의하지 않음\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 한계점\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 전국 단위 월별 집계 → 지역별·일별 패턴 반영 불가\n","#   (서울 도심과 농촌 지역의 기상-범죄 관계가 다를 수 있음)\n","# · 암수범죄(신고되지 않은 범죄) 미반영\n","#   → 실제 발생 건수와 통계상 발생 건수 간 괴리 가능\n","# · 인과 메커니즘 직접 증명 불가 (매개변수 부재)\n","#   → 기상 → 심리·행동 → 범죄 경로를 직접 측정하지 못함\n","# · SARIMAX 기상 외생변수 유의성 낮음\n","#   → 예측이 추세·계절성 주도, 기상 시나리오 차별화 한계\n","# · 흉악범죄 MAPE 25.97% → 2022년 구조 변화 미반영\n","#   → 선형 모델의 비선형 구조 변화 포착 한계\n","# · 코로나 기간 데이터 포함 → 모수 불안정 가능성\n","#   → 코로나 제외 강건성 검정 미실시 (후속 연구 과제)"],"metadata":{"id":"MI2TsSd9V9zA"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ╔══════════════════════════════════════════════════════════════╗\n","# ║              분석 방법별 결과 요약                             ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 1. EDA — 기술통계 및 시계열 탐색\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] 기술통계, 시계열 플롯, 연도별·월별 평균, Rolling Mean/Std\n","#\n","# [범죄율]\n","# · 폭력범죄: 평균 48.5, std 7.2 → 2016년 정점 후 지속 하락\n","#             코로나 이후 회복 없이 낮은 수준 유지\n","# · 흉악범죄: 평균 8.2, std 1.7 → 2014~2021 수평(7.5~8.0)\n","#             2022년 급등(최고 12.3) → 구조적 수준 이동\n","# · 재산범죄: 평균 140.1, std 16.9 → 2019년 이후 강한 우상향\n","#             2024년 역대 최고(189) → 계절성 약하고 추세 주도\n","#\n","# [기상변수]\n","# · 불쾌지수: 평균 56.3, 계절성 강함(사인파형), 첨도 -1.34\n","# · 폭염일수: 왜도 3.3, 첨도 11.5 → Q75=0.4인데 최대 16.9\n","#             여름 극단 집중, 영과잉 구조\n","# · 열대야:   왜도 2.8, 첨도 7.7 → Q75=0.0, 중앙값 0\n","#             폭염일수와 r=0.88 → 다중공선성으로 열대야 채택\n","# · 강수량:   왜도 1.6 → 장마철 집중, 연도별 편차 큼\n","# · 일조시간: 5~6월 피크 → 기온 피크(7~8월)보다 1~2개월 선행\n","#\n","# [Rolling 분석]\n","# · 흉악범죄 Rolling Std 2022년 2.3으로 급등 → 이분산성 심각\n","# · 재산범죄 Rolling Std 2019년 이후 확대(최대 14) → 이분산성 가장 심각\n","# · 폭력범죄 2020년 Rolling Std 급감 → 코로나로 계절 변동 억제\n","#\n","# [교란변수]\n","# · 실업률: 2021년 이후 구조적 하락(4.7%→2.1%) → 코로나 더미와 공선성\n","# · 공휴일: 범죄율과 무관(r≈0.00) → 회귀에서 제외\n","# · 코로나: 폭력범죄만 직접 억제 확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 2. 시계열 특성 분석\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] ACF/PACF, 월별 히트맵, 이상 시점 확인\n","#\n","# [ACF/PACF — ARIMA 차수 도출]\n","# · ACF: 자기상관함수. lag 12, 24에서 피크 → 계절성 존재\n","# · PACF: 편자기상관. lag 1~2에서 끊김 → AR(1~2) 구조\n","# · 폭력범죄: ACF 천천히 감쇠 + lag 12 피크 → SARIMA(1,1,0)(1,1,0)[12]\n","# · 흉악범죄: ACF 양/음 교차 진동 → SARIMA(2,1,0)(1,1,0)[12]\n","# · 재산범죄: ACF 완만 감쇠 → SARIMA(1,1,0)(0,1,0)[12]\n","# → 세 변수 모두 1차 차분(d=1) + 계절 차분(D=1) 신호\n","#\n","# [월별 히트맵]\n","# · 폭력·흉악: 5~9월 진하고 1~2월 옅음 → 여름 계절성 명확\n","# · 흉악범죄: 2022~2024년 행 전체 진함 → 구조적 수준 상승 시각 확인\n","# · 재산범죄: 열 방향 색 차이 거의 없음 → 계절성 매우 약함\n","#             2024년 행 압도적으로 진함(169~189) → 순수 추세 주도\n","#\n","# [이상 시점]\n","# · 코로나 구간(회색): 폭력범죄 급락, 흉악범죄 억제 후 해제 반동\n","# · 열대야 월(주황): 폭력·흉악 피크와 매년 반복적으로 겹침\n","# · 장마(파랑): 7~8월 열대야와 동시 발생 → 복합 효과 가능성\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 3. 변수 간 관계 탐색\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] 상관행렬, 산점도, 교란변수 × 범죄율\n","#\n","# [기상변수 간 다중공선성 확인]\n","# · heat_index ↔ temp_avg: r=1.00 → temp_avg 제거\n","# · heat_index ↔ humidity_avg: r=0.76 → humidity_avg 제거\n","# · heatwave_days ↔ tropical_nights: r=0.88 → tropical_nights 채택\n","#   (야간 고온 → 수면 부족 → 흉악범죄 경로 이론적 근거)\n","# · solar_radiation ↔ sunshine_hours: r=0.64 → sunshine_hours 유지\n","# → 최종 독립변수 4개: heat_index, tropical_nights, precip_mm, sunshine_hours\n","#\n","# [기상×범죄 상관행렬 (working 기준)]\n","# · heat_index × 흉악: r=0.76 ← 가장 강한 관계\n","# · heat_index × 폭력: r=0.51\n","# · heat_index × 재산: r=0.34\n","# · precip_mm × 흉악: r=0.50\n","# · sunshine_hours × 재산: r=0.06 (유의하지 않음)\n","#\n","# [교란변수 × 범죄 산점도]\n","# · 실업률 × 폭력: r=+0.39 (p=0.000) → 실업 증가 시 폭력 증가\n","# · 실업률 × 흉악: r=-0.28 (p=0.001) → 실업 낮을 때(경기 호황) 흉악 증가\n","# · 실업률 × 재산: r=-0.44 (p=0.000) → 실업 낮을 때 재산범죄 증가\n","# · 공휴일 × 전 범죄: r≈0.00, p>0.5 → 완전 무관 → 회귀에서 제외\n","# · 코로나 더미 × 폭력: r=-0.35 (p=0.000) → 코로나 기간 폭력 감소\n","# · 코로나 더미 × 흉악·재산: r≈0.01, p>0.8 → 무관\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 5. STL 분해 + ADF/KPSS 정상성 검정\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] STL(Seasonal-Trend decomposition using Loess) + ADF/KPSS\n","#\n","# [STL 분해]\n","# → 시계열을 추세(Trend) + 계절성(Seasonal) + 잔차(Residual)로 분리\n","# · 폭력범죄 추세: 2016 정점 → 완만 하락 → 2020 급락 → 낮은 수준 유지\n","# · 흉악범죄 추세: 2014~2020 수평(7.5) → 2021부터 가파른 상승 → 2022 정점(9.8)\n","# · 재산범죄 추세: 2017 저점(120) → 강한 우상향 → 2024 최고(180)\n","# · 재산범죄 계절 진폭 확대 → 승법 모형 또는 로그변환 신호\n","#\n","# [ADF/KPSS 정상성 검정]\n","# → ADF: p<0.05이면 정상(단위근 없음)\n","# → KPSS: p<0.05이면 비정상 (ADF와 방향 반대)\n","# · 폭력범죄: ADF p=0.891(비정상), KPSS p=0.10(정상) → 불일치 → 추세정상\n","# · 흉악범죄: ADF p=0.431(비정상), KPSS p=0.10(정상) → 불일치 → 추세정상\n","# · 재산범죄: ADF p=0.974(비정상), KPSS p=0.01(비정상) → 일치 → 차분 필요\n","# → 폭력·흉악: 추세 제거(STL)로 처리 / 재산: STL 또는 차분으로 처리\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 6. CCF 교차상관분석 (STL 잔차 기반)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] STL 잔차 추출 후 기상변수 잔차 → 범죄율 잔차 CCF\n","# → 계절성·추세 제거 후 순수 기상 변동이 범죄 변동을 선행하는지 검정\n","# → 판단 기준: p<0.05\n","#\n","# [유의한 결과만]\n","# · 불쾌지수 → 흉악범죄 lag 2: CCF=0.179, p=0.040\n","#   → 불쾌지수 높은 달 2개월 후 흉악범죄 증가\n","# · 불쾌지수 → 흉악범죄 lag 10: CCF=0.184, p=0.035\n","#   → 계절 주기(12개월) 근처 → 계절성 잔재 가능성\n","# · 강수량 → 폭력범죄 lag 5: CCF=0.193, p=0.027\n","#   → 강수 5개월 후 폭력범죄 증가 (여름 장마 → 겨울 효과)\n","# · 강수량 → 흉악범죄 lag 4: CCF=-0.214, p=0.014\n","#   → 강수 4개월 후 흉악범죄 감소 (외출 억제 효과 지연)\n","# · 열대야 → 폭력범죄 lag 8: CCF=-0.216, p=0.013\n","#   → lag 8은 이론적 해석 어려움 → 노이즈로 처리\n","#\n","# [결론]\n","# → 계절성 제거 후 유의한 단기 시차(lag 0~3)는\n","#   불쾌지수→흉악 lag 2만 확인\n","# → 나머지는 lag이 길거나 방향이 역설적 → 회귀에서 lag 0~2 주력\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 7. 비선형 임계점 분석\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] Piecewise Regression (불쾌지수) + 독립표본 t검정 (열대야)\n","#\n","# [Piecewise Regression — 불쾌지수 68 임계점]\n","# → 68 이하/초과 구간을 나눠 기울기 변화 확인\n","# · 폭력범죄: 68 초과 시 기울기 역전(감소)\n","#   → 극도의 더위에서 오히려 외출 억제로 범죄 감소 가능성\n","# · 흉악범죄: 68 초과 후에도 기울기 유지 → 임계점 효과 없음\n","# · 재산범죄: 68 초과 시 기울기 가속 → 일부 임계 효과 존재\n","#\n","# [독립표본 t검정 — 열대야 유무 그룹 비교]\n","# → 열대야 있는 달(tropical_nights>0) vs 없는 달(=0) 범죄율 평균 비교\n","# · 폭력범죄: t=-2.36, p=0.020 ← 유의. 열대야 있는 달 중앙값 높음\n","# · 흉악범죄: t=-7.25, p=0.000 ← 가장 강한 차이. 중앙값 약 22% 높음\n","# · 재산범죄: t=-3.05, p=0.003 ← 유의. 열대야 있는 달 높음\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 8. 다중회귀 분석 (OLS, HC3 로버스트 표준오차)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] OLS 회귀. HC3 로버스트 SE 적용(이분산성 대응)\n","# → 기상변수 4개 + 교란변수 3개 동시 투입\n","# → VIF로 다중공선성 확인 (모두 <5 → 문제 없음)\n","#\n","# [모델 설명력]\n","# · 폭력범죄: R²=0.687 → 독립변수들이 폭력범죄 변동의 68.7% 설명\n","# · 흉악범죄: R²=0.682\n","# · 재산범죄: R²=0.318 → 낮음. 장기 추세가 주도하는 구조\n","#\n","# [유의한 계수 (p<0.05)]\n","# 폭력범죄:\n","# · heat_index: +0.44 (p=0.000) → 불쾌지수 1 증가 시 폭력범죄율 0.44 증가\n","# · unemp_rate: +5.64 (p=0.000) → 실업률 1%p 증가 시 폭력범죄율 5.64 증가\n","# · covid_dummy: -7.62 (p=0.000) → 코로나 기간 폭력범죄율 7.62 감소\n","#\n","# 흉악범죄:\n","# · heat_index: +0.07 (p=0.000) → 유의하지만 효과 크기 작음\n","# · tropical_nights: -0.11 (p=0.018) → 다변량에서 음의 방향\n","#   (불쾌지수가 열대야 효과 흡수 → 부분 공선성)\n","# · precip_mm: +0.003 (p=0.035)\n","# · sunshine_hours: +0.015 (p=0.000)\n","# · unemp_rate: -0.79 (p=0.000) → 경기 호황 시 흉악 증가\n","#\n","# 재산범죄:\n","# · sunshine_hours: +0.11 (p=0.023)\n","# · unemp_rate: -12.76 (p=0.000) → 경기 호황 시 재산범죄 증가\n","# · 기상변수 대부분 유의하지 않음\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 9. Granger 인과 검정\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] 1차 차분 후 VAR 기반 Granger 인과 검정 (lag 1~4)\n","# → \"기상변수의 과거값이 범죄율 현재값 예측에 유의하게 기여하는가\"\n","# → F검정. p<0.05이면 Granger 인과 존재\n","#\n","# [유의한 결과]\n","# · 불쾌지수 → 폭력범죄: lag 1~4 전부 (F=24~50, p<0.001) ← 가장 강력\n","# · 불쾌지수 → 흉악범죄: lag 1~4 전부 (F=8~28, p<0.001)\n","# · 불쾌지수 → 재산범죄: lag 1~4 전부 (F=10~16, p<0.001)\n","# · 열대야 → 폭력범죄: lag 2~4 (F=4~5, p<0.01)\n","# · 열대야 → 흉악범죄: lag 4 (F=4.4, p=0.002)\n","# · 열대야 → 재산범죄: lag 4 (F=2.8, p=0.031)\n","# · 강수량 → 폭력범죄: lag 4 (F=3.5, p=0.009)\n","# · 강수량 → 흉악범죄: lag 4 (F=2.8, p=0.030)\n","# · 일조시간 → 흉악범죄: lag 3~4 (F=4.7~5.6, p<0.01)\n","#\n","# [주의] Granger 인과 ≠ 물리적 인과\n","#        \"기상이 범죄를 유발한다\"가 아니라\n","#        \"기상 변화가 범죄 변화보다 시간적으로 먼저 나타난다\"는 의미\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 10. ITS 중단시계열 분석 (코로나 전후 구조 변화)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] ITS(Interrupted Time Series) — 코로나 시작(2020.03) 전후\n","# → 개입 전후 수준 변화(level change)와 추세 변화(slope change) 검정\n","#\n","# [결과]\n","# 폭력범죄:\n","# · intervention: p=0.557 (유의하지 않음) → 즉각적 수준 변화 없음\n","# · time_after: p=0.261 → 추세 변화 없음\n","# · 해석: 코로나와 무관하게 이미 하락 추세였음\n","#\n","# 흉악범죄:\n","# · intervention: -2.33 (p=0.029) → 코로나 시작 시 수준 즉각 하락\n","# · time_after: +0.034 (p=0.009) → 코로나 이후 기울기 상승 전환\n","# · 해석: 코로나로 억제 → 해제 후 빠른 반동 상승 패턴\n","#\n","# 재산범죄:\n","# · intervention: -50.74 (p=0.000) → 가장 큰 즉각 수준 하락\n","# · time_after: +0.70 (p=0.000) → 코로나 이후 강한 상승 기울기\n","# · 해석: 코로나로 급락 후 강한 반동 → 현재까지 상승 지속\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 11. Random Forest + SHAP 변수 중요도\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법] Random Forest 학습 후 SHAP(SHapley Additive exPlanations) 계산\n","# → SHAP: 각 변수가 예측값에 기여하는 절대적 크기\n","#          단위에 무관하게 변수 간 중요도 비교 가능\n","#\n","# [SHAP 중요도 순위]\n","# 폭력범죄:\n","# · 1위: 실업률(3.60) → 사회경제 요인 주도\n","# · 2위: 불쾌지수(3.22) → 기상 효과도 유사한 수준\n","# · 3위: 코로나더미(1.46)\n","# · 열대야(0.018) → 폭력범죄에 기여 거의 없음\n","#\n","# 흉악범죄:\n","# · 1위: 불쾌지수(1.09) → 유일하게 기상변수가 1위\n","# · 2위: 실업률(0.42)\n","# · 3위: 일조시간(0.19)\n","# · 코로나더미(0.023) → 기여 미미\n","#\n","# 재산범죄:\n","# · 1위: 실업률(7.57) → 압도적 1위\n","# · 2위: 불쾌지수(3.91)\n","# · 열대야(0.001) → 거의 기여 없음\n","#\n","# [핵심 발견]\n","# → 흉악범죄만 유일하게 기상변수(불쾌지수)가 사회경제 변수 압도\n","# → 폭력·재산은 실업률이 1위 → 사회경제 요인 주도\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 12. SARIMAX 예측 + 백테스팅\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [방법]\n","# 1단계: 기상변수 4개 SARIMA 예측 (2025~2026)\n","# 2단계: 예측 기상값을 외생변수로 투입한 SARIMAX 범죄율 예측\n","# → 음수 예측값(강수량·열대야) → 0으로 클리핑\n","#\n","# [SARIMA 예측 품질]\n","# · 불쾌지수: 평균 오차율 2.4% ← 신뢰 가능\n","# · 일조시간: 평균 오차율 19.5% ← 품질 낮음\n","# · 강수량·열대야: 음수 발생 ← SARIMA 구조적 한계\n","#   (강수량: 장마 집중으로 분산 과대 / 열대야: 영과잉 구조)\n","# → 네 변수 모두 SARIMA 예측값 사용 (음수→0 클리핑으로 처리)\n","#\n","# [백테스팅 — 2014~2023 학습, 2024 예측]\n","# · MAPE(평균 절대 백분율 오차): 낮을수록 예측 정확\n","# · 폭력범죄: MAPE=8.78%  ← 양호 (10% 이하)\n","# · 흉악범죄: MAPE=25.97% ← 불량 (2022년 구조 변화 미반영)\n","# · 재산범죄: MAPE=7.83%  ← 양호 (10% 이하)\n","#\n","# [2025~2026 예측]\n","# · 폭력범죄: 40.20 → 38.94 (완만 하락)\n","# · 흉악범죄: 8.68 → 8.28  (소폭 하락, CI 매우 넓음 → 불확실성 큼)\n","# · 재산범죄: 194.83 → 214.26 (강한 상승 지속)\n","#\n","# [한계]\n","# · SARIMAX 기상 외생변수 대부분 유의하지 않음(p>0.05)\n","#   → 예측이 시계열 추세·계절성 주도, 기상변수 기여 제한적\n","# · 흉악범죄: 2022년 구조 변화(코로나 해제 반동)를\n","#   선형 모델이 완전히 포착 못함"],"metadata":{"id":"d9oT1xZMxUxG"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ╔══════════════════════════════════════════════════════════════╗\n","# ║         가설별 분석방법 선택 근거 요약                          ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H1. 기상변수가 높을수록 범죄 발생률이 증가하는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [상관계수] 두 변수 간 선형 관계의 방향과 강도를 가장 단순하게 확인\n","#            → 기상-범죄 관계가 존재하는지 1차 탐색용\n","#            → 단, 다른 요인의 영향을 포함하므로 순수 효과 아님\n","#\n","# [OLS 회귀] 실업률·코로나 등 교란변수를 동시에 통제한 상태에서\n","#            기상변수만의 순수 효과 크기와 방향을 추정\n","#            → 상관계수의 한계(허위 상관 가능성)를 보완\n","#\n","# [t검정]    열대야는 대부분 0이라 연속형 분석이 부적합\n","#            → 열대야 있는 달 vs 없는 달 두 그룹으로 나눠\n","#              범죄율 평균 차이가 우연인지 검정\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H2. 기상 효과는 1~3개월 시차로도 나타나는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [CCF]      회귀는 동시점(lag 0) 관계만 보지만\n","#            CCF는 특정 lag에서의 상관을 lag별로 분리해서 검정\n","#            → STL 잔차 기반으로 계절성 제거 후 검정하여\n","#              순수 기상 변동이 범죄 변동보다 선행하는지 확인\n","#\n","# [Granger]  CCF가 \"얼마나 관련 있는지\"를 보는 반면\n","#            Granger는 \"과거 기상값이 미래 범죄값 예측에\n","#            실질적으로 도움이 되는가\"를 F검정으로 확인\n","#            → 1차 차분으로 정상화하여 추세 효과 제거 후 검정\n","#            → 두 방법의 병행으로 시차 효과를 이중 확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H3. 폭력범죄가 기상에 더 민감한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [회귀계수 비교] 동일 독립변수의 계수 크기로 범죄 유형 간\n","#                기상 민감도를 직접 비교\n","#                → 단, 종속변수 스케일이 다르면 비교가 부정확\n","#\n","# [SHAP]     회귀는 선형 효과만 반영하고 변수 스케일 영향을 받음\n","#            → SHAP은 비선형 효과까지 포착하고\n","#              단위에 무관하게 예측 기여도를 계산\n","#            → 범죄 유형별 기상 민감도를 공정하게 비교 가능\n","#            → 두 방법의 결과가 다를 경우 SHAP을 우선 해석\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H4. 계절성 제거 후에도 순수 기상 효과가 존재하는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [STL + CCF] 단순 상관이나 회귀는 계절성이 포함된 원계열을 사용\n","#             → \"여름에 덥고 여름에 범죄가 많다\"는\n","#               단순 계절 패턴과 순수 기상 효과를 구분 불가\n","#             → STL로 추세·계절성을 분리한 잔차끼리 CCF를 돌려\n","#               계절 패턴 외 순수 기상 변동이 범죄 변동을\n","#               설명하는지 확인 → H1과 H4를 이중 검증하는 구조\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H5. 교란변수 통제 후에도 Granger 인과가 유의한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [Granger]  회귀는 동시점 관계이고 상관계수는 인과 방향을 알 수 없음\n","#            → Granger는 \"기상이 범죄보다 시간적으로 앞서 움직이는가\"\n","#              즉 방향성 있는 선행 관계를 검정\n","#            → 1차 차분으로 추세를 제거하여 허위 상관 최소화\n","#            → H2와 동일한 방법이지만 목적이 다름\n","#              H2: 시차의 존재 확인 / H5: 인과 방향성 확인\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H6. 임계점 초과 시 범죄율이 급증하는가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [Piecewise Regression] 일반 회귀는 기상 효과가 전 구간에서\n","#                        일정하다고 가정(선형)\n","#                        → 임계점 전후로 기울기가 달라지는\n","#                          비선형 관계를 구간별로 분리해서 추정\n","#                        → 불쾌지수 68 기준으로 이하/초과 구간의\n","#                          기울기 변화를 직접 비교\n","#\n","# [더미 회귀] Piecewise의 시각적 결과를 통계적으로 확인\n","#             → 임계점 초과 여부를 0/1 더미로 만들어\n","#               회귀계수 유의성 검정\n","#             → 두 방법의 병행으로 임계점 효과를 이중 검증\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# H7. 폭염 심화 시나리오에서 범죄율 예측이 가능한가?\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [SARIMA]   기상변수의 미래값을 먼저 예측해야 SARIMAX 투입 가능\n","#            → 시계열의 추세·계절성·자기상관을 반영한\n","#              가장 표준적인 시계열 예측 모델\n","#            → 불쾌지수는 오차율 2.4%로 신뢰 가능한 수준\n","#\n","# [SARIMAX]  단순 SARIMA는 기상변수를 반영하지 못함\n","#            → 기상변수를 외생변수(exogenous)로 포함하여\n","#              기상-범죄 관계를 예측에 반영\n","#            → d=1 내부 차분으로 비정상 시계열 처리\n","#\n","# [백테스팅] 미래 예측의 신뢰도를 사전에 검증하기 위해\n","#            2014~2023을 학습, 2024를 예측하여 실제값과 비교\n","#            → MAPE로 예측 정확도를 정량화\n","#            → 2025~2026 예측 결과의 신뢰 근거로 활용"],"metadata":{"id":"euOMBF864At4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ╔══════════════════════════════════════════════════════════════╗\n","# ║                  STEP 14 정책 제안                            ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 1. 불쾌지수 기반 치안 경보 시스템 도입\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [분석 근거]\n","# · 불쾌지수 → 전 범죄 Granger 인과 lag 1~4 전부 유의 (F=8~50)\n","#   → 불쾌지수 변화가 1~4개월 후 범죄율 변화를 시간적으로 선행\n","# · SHAP 흉악범죄 1위 변수 (중요도 1.09)\n","# · 회귀: 폭력범죄 coef=+0.44 (p=0.000)\n","#   → 불쾌지수 1 증가 시 폭력범죄율 0.44 증가\n","#\n","# [제안]\n","# · 기상청 불쾌지수 예보와 경찰청 치안 경보 연동 시스템 구축\n","#   - 불쾌지수 68 이상 예보 시 → 주의 단계: 취약지역 순찰 강화\n","#   - 불쾌지수 75 이상 지속 시 → 경계 단계: 순찰 인력 증원\n","# · 기상청이 이미 불쾌지수를 실시간 예보하므로\n","#   추가 데이터 수집 없이 즉시 연동 가능\n","#\n","# [기대효과]\n","# · 폭염 시작 1~4개월 전부터 선제적 치안 자원 배치\n","# · 흉악·폭력범죄 억제\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 2. 열대야 집중 야간 순찰 강화\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [분석 근거]\n","# · 열대야 유무 t검정: 흉악범죄 t=-7.25 (p=0.000)\n","#   → 열대야 있는 달 흉악범죄 중앙값 약 22% 높음\n","# · Granger: 열대야 → 폭력범죄 lag 2~4 유의 (F=4~5, p<0.01)\n","#   → 열대야 발생 후 2~4개월간 폭력범죄 증가 선행\n","# · 야간 고온 → 수면 부족 → 충동 조절 능력 저하 → 흉악범죄 경로\n","#\n","# [제안]\n","# · 열대야 발생 월(주로 7~8월) 야간(22시~익일 4시) 순찰 밀도 강화\n","#   - 저소득·고밀도·고령 취약 지역 우선 배치\n","#   - 열대야 연속 3일 이상 시 비상 근무 체계 전환\n","# · 무더위 쉼터 야간 개방 → 열대야 노출 시간 감소\n","#\n","# [기대효과]\n","# · 야간 흉악범죄 억제\n","# · 수면 부족으로 인한 충동성 완화\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 3. 폭염기 사회적 완충 인프라 확충\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [분석 근거]\n","# · SHAP: 실업률이 폭력(1위, 3.60)·재산(1위, 7.57) 범죄 최대 기여 변수\n","# · 회귀: 실업률 × 폭력 coef=+5.64 (p=0.000)\n","#         실업률 × 재산 coef=-12.76 (p=0.000)\n","#   → 기상 효과는 사회경제 요인과 복합 작용\n","#   → 경제적 스트레스 + 열 스트레스 동시 작용 시 범죄 위험 가중\n","#\n","# [제안]\n","# · 폭염 취약계층(노숙인·독거노인·저소득층) 대상\n","#   - 무더위 쉼터 확대 및 24시간 운영\n","#   - 폭염 수당·긴급 생계 지원으로 경제적 스트레스 완화\n","#   - 지역사회 모니터링 강화로 고립 예방\n","# · 폭염기 + 경기 침체 시기 중복 구간 집중 대응\n","#   (불쾌지수 고수준 + 실업률 상승 → 복합 위험 경보)\n","#\n","# [기대효과]\n","# · 열 스트레스 + 경제적 스트레스 복합 작용 차단\n","# · 폭력범죄 발생 억제\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 4. 재산범죄 장기 모니터링 및 사회안전망 강화\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [분석 근거]\n","# · 재산범죄 SARIMAX 예측: 194.83(2025) → 214.26(2026) 강한 상승 지속\n","#   백테스팅 MAPE=7.83% → 예측 신뢰 가능\n","# · SHAP: 실업률 1위(7.57), 기상변수 대부분 유의하지 않음\n","#   → 기상보다 사회구조적 요인(경기·소득) 주도\n","# · ITS: 코로나 해제 후 강한 반동 상승(time_after=+0.70, p=0.000)\n","#   → 외출·경제활동 재개가 재산범죄 증가로 이어짐\n","#\n","# [제안]\n","# · 재산범죄 월별 모니터링 대시보드 구축\n","#   - 경기 지표(실업률·소비심리)와 재산범죄 연동 모니터링\n","#   - 상승 추세 가속 시 경제 취약계층 집중 지원 체계 발동\n","# · 취약계층 사회안전망 강화\n","#   - 폭염기 생계 지원이 재산범죄 억제에도 간접 기여\n","#\n","# [기대효과]\n","# · 상승 추세 조기 감지 및 선제 대응\n","# · 경제적 동기 기반 재산범죄 억제\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 5. 기후-범죄 통합 데이터 플랫폼 구축 (후속 연구 기반)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [분석 근거]\n","# · 본 연구 한계: 전국 단위 월별 집계 → 지역별·일별 패턴 반영 불가\n","# · 서울 도심과 농촌의 기상-범죄 관계가 다를 수 있음\n","# · 암수범죄(미신고) 미반영 → 실제 발생과 괴리 가능\n","#\n","# [제안]\n","# · 기상청·경찰청·통계청 데이터를 시도 단위로 통합\n","#   - 시도별 기상-범죄 패널 데이터 구축\n","#   - 실시간 기상 예보와 범죄 신고 데이터 연계 분석 체계\n","# · 일별 단위 분석 가능하도록 데이터 세분화\n","#   - 월별 → 일별 전환 시 기상-범죄 시차 효과 더 정밀하게 포착 가능\n","#\n","# [기대효과]\n","# · 지역 맞춤형 치안 정책 근거 마련\n","# · 본 연구 한계 보완 → 후속 연구 기반\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 공통 정책 방향 요약\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 불쾌지수 예보 기반 자동 치안 경보 → 선제적 자원 배치\n","# · 열대야·폭염 집중 구간 야간 순찰 강화 → 흉악범죄 중심 대응\n","# · 폭염기 사회안전망 강화 → 기상·경제 복합 스트레스 동시 완화\n","# · 재산범죄 장기 추세 모니터링 → 예측 기반 선제 대응\n","# · 시도별 통합 플랫폼 구축 → 지역 맞춤형 정책 근거 마련"],"metadata":{"id":"9w9S80T4WQH3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 추가 분석 — 코로나 전후 기상-범죄 관계 변화\n","# 코로나 전(2014.01~2020.02) vs 코로나 후(2022.07~2024.12)\n","# 코로나 기간(2020.03~2022.06) 제외\n","import statsmodels.api as sm\n","\n","crime_vars  = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","\n","weather_vars = ['heat_index', 'tropical_nights', 'precip_mm', 'sunshine_hours']\n","control_vars = ['unemp_rate']\n","\n","X_vars = weather_vars + control_vars\n","\n","# 구간 분리\n","df_pre  = df[(df.index < '2020-03-01')].copy()                          # 코로나 전\n","df_post = df[(df.index >= '2022-07-01')].copy()                         # 코로나 후\n","df_full = df[(df.index < '2020-03-01') | (df.index >= '2022-07-01')].copy()  # 전체(코로나 제외)\n","\n","print(f\"코로나 전: {len(df_pre)}개월 ({df_pre.index[0].strftime('%Y.%m')}~{df_pre.index[-1].strftime('%Y.%m')})\")\n","print(f\"코로나 후: {len(df_post)}개월 ({df_post.index[0].strftime('%Y.%m')}~{df_post.index[-1].strftime('%Y.%m')})\")\n","\n","results_comparison = []\n","\n","for cvar, cname in zip(crime_vars, crime_names):\n","\n","    print(f\"\\n{'='*60}\")\n","    print(f\"  {cname}\")\n","    print(f\"{'='*60}\")\n","\n","    for label, df_sub in [('전체(코로나 제외)', df_full),\n","                           ('코로나 전', df_pre),\n","                           ('코로나 후', df_post)]:\n","\n","        X = df_sub[X_vars].copy()\n","        y = df_sub[cvar]\n","\n","        valid   = X.notna().all(axis=1) & y.notna()\n","        X, y    = X[valid], y[valid]\n","        X_const = sm.add_constant(X)\n","        model   = sm.OLS(y, X_const).fit(cov_type='HC3')\n","\n","        print(f\"\\n  [{label}] n={len(y)}, R²={model.rsquared:.3f}\")\n","        for v in weather_vars:\n","            sig = '✅' if model.pvalues[v] < 0.05 else '  '\n","            print(f\"  {sig} {v}: coef={model.params[v]:+.4f}  p={model.pvalues[v]:.3f}\")\n","\n","        results_comparison.append({\n","            '범죄유형': cname,\n","            '구간': label,\n","            'n': len(y),\n","            'R²': round(model.rsquared, 3),\n","            'heat_index_coef': round(model.params['heat_index'], 4),\n","            'heat_index_p': round(model.pvalues['heat_index'], 3),\n","            'tropical_coef': round(model.params['tropical_nights'], 4),\n","            'tropical_p': round(model.pvalues['tropical_nights'], 3),\n","            'precip_coef': round(model.params['precip_mm'], 4),\n","            'precip_p': round(model.pvalues['precip_mm'], 3),\n","            'sunshine_coef': round(model.params['sunshine_hours'], 4),\n","            'sunshine_p': round(model.pvalues['sunshine_hours'], 3),\n","        })\n","\n","# 시각화 — 불쾌지수 계수 전후 비교\n","fig, axes = plt.subplots(1, 3, figsize=(16, 6))\n","colors_bar = ['steelblue', 'crimson', 'seagreen']\n","\n","for i, (cvar, cname, color) in enumerate(zip(crime_vars, crime_names, colors_bar)):\n","\n","    subset = [r for r in results_comparison\n","              if r['범죄유형'] == cname]\n","\n","    labels = [r['구간'] for r in subset]\n","    coefs  = [r['heat_index_coef'] for r in subset]\n","    pvals  = [r['heat_index_p'] for r in subset]\n","\n","    bars = axes[i].bar(labels, coefs, color=color, alpha=0.7, edgecolor='white')\n","\n","    # 유의성 표시\n","    for bar, pval in zip(bars, pvals):\n","        sig = '***' if pval < 0.001 else '**' if pval < 0.01 else '*' if pval < 0.05 else 'n.s.'\n","        axes[i].text(bar.get_x() + bar.get_width()/2,\n","                     bar.get_height() + 0.002,\n","                     sig, ha='center', va='bottom', fontsize=11)\n","\n","    axes[i].axhline(0, color='black', linewidth=0.8)\n","    axes[i].set_title(f'{cname}\\n불쾌지수 회귀계수 비교', fontsize=11)\n","    axes[i].set_ylabel('불쾌지수 계수')\n","    axes[i].tick_params(axis='x', labelsize=9)\n","    axes[i].grid(axis='y', alpha=0.3)\n","\n","plt.suptitle('코로나 전후 불쾌지수 → 범죄율 회귀계수 변화', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# 추가 분석 결과 — 코로나 전후 기상-범죄 관계 변화\n","#\n","# 공통 패턴: 코로나 전후로 기상변수의 회귀계수가 전반적으로 감소\n","# → 코로나 이후 범죄율에서 기상의 상대적 기여도가 줄어들고\n","#   사회구조적 요인의 영향이 커지는 방향으로 변화\n","#\n","# 폭력범죄:\n","# · 불쾌지수 coef: 코로나 전 0.381(***) → 코로나 후 0.210(**)\n","# · 계수가 절반 수준으로 감소. 기상 민감도 약화\n","# · 해석: 코로나 이후 낮은 수준으로 정착 → 기상 변동에 덜 반응\n","#\n","# 흉악범죄:\n","# · 불쾌지수 coef: 코로나 전 0.101(***) → 코로나 후 0.068(*)\n","# · 코로나 전: heat_index + sunshine_hours 둘 다 유의\n","#   코로나 후: heat_index만 유의 → 기상 영향 구조 단순화\n","# · R²: 0.882 → 0.733 → 설명력 하락\n","# · 해석: 급등 후 높은 수준에서 기상의 상대적 기여 감소\n","#\n","# 재산범죄:\n","# · 전 구간 모든 기상변수 유의하지 않음 → 기상 효과 없음 일관\n","# · 코로나 후 R²=0.225 → 기상·실업률로 설명 안 되는 변동 다수\n","# · 해석: 코로나 이후 재산범죄 급등 원인이\n","#         기상·실업률 이외 구조적 요인 가능성\n","#         (e-커머스 확대, 비대면 사기 증가 등)\n","#\n","# 종합:\n","# · 기상-범죄 관계는 시간에 따라 변하는 비정상적 구조\n","# · 코로나라는 외부 충격이 범죄율의 기저 수준을 변화시키면서\n","#   기상변수의 상대적 기여도도 함께 변화\n","# · 전체 기간 분석만으로는 이 구조 변화를 포착 못함\n","#   → 코로나 전/후 분리 분석의 필요성 재확인"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"uW5t0-2X1tDg","executionInfo":{"status":"ok","timestamp":1780285674837,"user_tz":-540,"elapsed":643,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"5c9eb0d7-b006-4677-b3ef-09b4dd7ed665"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["코로나 전: 74개월 (2014.01~2020.02)\n","코로나 후: 30개월 (2022.07~2024.12)\n","\n","============================================================\n","  폭력범죄율\n","============================================================\n","\n","  [전체(코로나 제외)] n=104, R²=0.667\n","  ✅ heat_index: coef=+0.4446  p=0.000\n","  ✅ tropical_nights: coef=-0.5264  p=0.011\n","     precip_mm: coef=-0.0160  p=0.054\n","     sunshine_hours: coef=-0.0092  p=0.582\n","\n","  [코로나 전] n=74, R²=0.766\n","  ✅ heat_index: coef=+0.3810  p=0.000\n","  ✅ tropical_nights: coef=-0.6703  p=0.001\n","     precip_mm: coef=+0.0037  p=0.671\n","     sunshine_hours: coef=+0.0219  p=0.076\n","\n","  [코로나 후] n=30, R²=0.731\n","  ✅ heat_index: coef=+0.2103  p=0.001\n","     tropical_nights: coef=-0.4173  p=0.162\n","     precip_mm: coef=+0.0042  p=0.611\n","     sunshine_hours: coef=+0.0239  p=0.187\n","\n","============================================================\n","  흉악범죄율\n","============================================================\n","\n","  [전체(코로나 제외)] n=104, R²=0.736\n","  ✅ heat_index: coef=+0.0799  p=0.000\n","  ✅ tropical_nights: coef=-0.0835  p=0.037\n","  ✅ precip_mm: coef=+0.0037  p=0.032\n","  ✅ sunshine_hours: coef=+0.0126  p=0.000\n","\n","  [코로나 전] n=74, R²=0.882\n","  ✅ heat_index: coef=+0.1005  p=0.000\n","     tropical_nights: coef=-0.1183  p=0.060\n","     precip_mm: coef=+0.0029  p=0.102\n","  ✅ sunshine_hours: coef=+0.0090  p=0.000\n","\n","  [코로나 후] n=30, R²=0.733\n","  ✅ heat_index: coef=+0.0680  p=0.011\n","     tropical_nights: coef=-0.0107  p=0.906\n","     precip_mm: coef=+0.0003  p=0.918\n","     sunshine_hours: coef=+0.0063  p=0.355\n","\n","============================================================\n","  재산범죄율\n","============================================================\n","\n","  [전체(코로나 제외)] n=104, R²=0.450\n","     heat_index: coef=+0.1597  p=0.321\n","     tropical_nights: coef=-0.3552  p=0.590\n","     precip_mm: coef=+0.0397  p=0.060\n","  ✅ sunshine_hours: coef=+0.1170  p=0.010\n","\n","  [코로나 전] n=74, R²=0.255\n","     heat_index: coef=+0.2691  p=0.076\n","     tropical_nights: coef=-0.6456  p=0.288\n","     precip_mm: coef=+0.0316  p=0.183\n","     sunshine_hours: coef=+0.0695  p=0.064\n","\n","  [코로나 후] n=30, R²=0.225\n","     heat_index: coef=+0.6010  p=0.230\n","     tropical_nights: coef=+0.5618  p=0.648\n","     precip_mm: coef=-0.0386  p=0.423\n","     sunshine_hours: coef=+0.0144  p=0.912\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# STL 잔차 기반 회귀 예측\n","from statsmodels.tsa.seasonal import STL\n","from statsmodels.tsa.statespace.sarimax import SARIMAX\n","import statsmodels.api as sm\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","crime_vars  = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","colors      = ['steelblue', 'crimson', 'seagreen']\n","\n","weather_vars = ['heat_index', 'tropical_nights', 'precip_mm', 'sunshine_hours']\n","exog_vars    = weather_vars + ['unemp_rate']\n","\n","monthly_avg  = df.groupby('month')[exog_vars].mean()\n","future_index = pd.date_range('2025-01-01', periods=24, freq='MS')\n","\n","exog_future = pd.DataFrame({\n","    'heat_index':      forecast_dict['heat_index'].values,\n","    'tropical_nights': np.clip(forecast_dict['tropical_nights'].values, 0, None),\n","    'precip_mm':       np.clip(forecast_dict['precip_mm'].values, 0, None),\n","    'sunshine_hours':  forecast_dict['sunshine_hours'].values,\n","    'unemp_rate':      [monthly_avg.loc[m, 'unemp_rate'] for m in future_index.month],\n","}, index=future_index)\n","\n","fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n","\n","for ax, cvar, cname, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    series = df[cvar].dropna()\n","\n","    # ── 1단계: STL 분해 ──\n","    stl = STL(series, period=12, robust=True)\n","    res = stl.fit()\n","\n","    trend    = res.trend\n","    seasonal = res.seasonal\n","    resid    = res.resid\n","\n","    # ── 2단계: 추세 외삽 ──\n","    trend_model    = SARIMAX(trend.dropna(), order=(1,1,0),\n","                             enforce_stationarity=False,\n","                             enforce_invertibility=False)\n","    trend_fitted   = trend_model.fit(disp=False)\n","    trend_forecast = trend_fitted.get_forecast(steps=24).predicted_mean\n","\n","    # ── 3단계: 계절성 반복 ──\n","    seasonal_avg      = seasonal.groupby(series.index.month).mean()\n","    seasonal_forecast = pd.Series(\n","        [seasonal_avg[m] for m in future_index.month],\n","        index=future_index\n","    )\n","\n","    # ── 4단계: 잔차 → 기상변수 OLS 회귀 ──\n","    X_train     = df[exog_vars].loc[resid.index].dropna()\n","    y_resid     = resid.loc[X_train.index]\n","    X_const     = sm.add_constant(X_train)\n","    resid_model = sm.OLS(y_resid, X_const).fit(cov_type='HC3')\n","\n","    print(f\"\\n{'─'*50}\")\n","    print(f\"  {cname} — 잔차 회귀 결과\")\n","    print(f\"{'─'*50}\")\n","    print(f\"  R²={resid_model.rsquared:.4f}\")\n","    for v in exog_vars:\n","        sig = '✅' if resid_model.pvalues[v] < 0.05 else '  '\n","        print(f\"  {sig} {v}: coef={resid_model.params[v]:+.4f}  p={resid_model.pvalues[v]:.3f}\")\n","\n","    # 예측 시 const 컬럼 직접 추가\n","    exog_future_const = exog_future.copy()\n","    exog_future_const.insert(0, 'const', 1.0)\n","    resid_forecast = resid_model.predict(exog_future_const)\n","    resid_forecast.index = future_index\n","\n","    # ── 5단계: 합산 ──\n","    final_forecast = trend_forecast + seasonal_forecast + resid_forecast\n","    fitted_vals    = trend + seasonal + resid_model.fittedvalues\n","\n","    print(f\"  2025 예측 평균: {final_forecast[:12].mean():.2f}\")\n","    print(f\"  2026 예측 평균: {final_forecast[12:].mean():.2f}\")\n","\n","    ax.plot(series.index, series,\n","            color=color, alpha=0.4, linewidth=1.2, label='실제값')\n","    ax.plot(fitted_vals.index, fitted_vals,\n","            color=color, linewidth=1.5, alpha=0.8, label='적합값')\n","    ax.plot(final_forecast.index, final_forecast,\n","            color=color, linewidth=2.2, linestyle='--', label='예측값')\n","    ax.axvline(pd.Timestamp('2025-01-01'),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — STL 잔차 기반 회귀 예측 (2025~2026)')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('범죄율 STL 잔차 기반 회귀 예측\\n(추세 외삽 + 계절성 반복 + 기상변수 잔차 예측)', fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# 결과 해석하면:\n","# 잔차 회귀 R² 매우 낮음 (0.017~0.068)\n","# 이게 핵심 결과예요. STL 잔차는 추세·계절성을 모두 제거한 순수 변동인데, 기상변수로 설명되는 부분이 2~7%밖에 안 돼요. 이는 사실 좋은 소식과 나쁜 소식이 동시에 있어요.\n","# 좋은 소식: 흉악범죄 잔차에서 heat_index(p=0.007), precip_mm(p=0.036)이 유의 → SARIMAX에서 유의하지 않았던 기상변수가 여기서는 유의하게 나옴. AR 흡수 문제가 실제로 있었다는 확인.\n","# 나쁜 소식: R²=0.068이라는 건 계절성·추세 제거 후 기상변수가 설명하는 변동이 6.8%뿐. 즉 범죄율 변동의 대부분은 기상이 아닌 다른 요인에 의해 결정됨.\n","# 그래프 문제\n","# 폭력·흉악범죄 예측값이 톱니 모양으로 진동하는 게 보이는데, 잔차 예측값의 변동이 계절성 반복 패턴과 어긋나면서 생기는 거예요. 예측이 불안정해 보여서 시각적으로 좋지 않아요."],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"5JA-4UyN5Ohy","executionInfo":{"status":"ok","timestamp":1780285676998,"user_tz":-540,"elapsed":2159,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"618f3b1d-865c-4a76-e2e3-b64e1bcd140e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","──────────────────────────────────────────────────\n","  폭력범죄율 — 잔차 회귀 결과\n","──────────────────────────────────────────────────\n","  R²=0.0165\n","     heat_index: coef=+0.0219  p=0.187\n","     tropical_nights: coef=-0.0245  p=0.701\n","     precip_mm: coef=-0.0020  p=0.344\n","     sunshine_hours: coef=-0.0015  p=0.738\n","     unemp_rate: coef=+0.1566  p=0.494\n","  2025 예측 평균: 40.51\n","  2026 예측 평균: 40.27\n","\n","──────────────────────────────────────────────────\n","  흉악범죄율 — 잔차 회귀 결과\n","──────────────────────────────────────────────────\n","  R²=0.0683\n","  ✅ heat_index: coef=+0.0157  p=0.007\n","     tropical_nights: coef=-0.0100  p=0.614\n","  ✅ precip_mm: coef=-0.0014  p=0.036\n","     sunshine_hours: coef=-0.0007  p=0.617\n","     unemp_rate: coef=+0.0433  p=0.596\n","  2025 예측 평균: 8.49\n","  2026 예측 평균: 8.06\n","\n","──────────────────────────────────────────────────\n","  재산범죄율 — 잔차 회귀 결과\n","──────────────────────────────────────────────────\n","  R²=0.0534\n","     heat_index: coef=-0.0684  p=0.259\n","     tropical_nights: coef=+0.3695  p=0.066\n","     precip_mm: coef=-0.0080  p=0.292\n","     sunshine_hours: coef=-0.0106  p=0.371\n","     unemp_rate: coef=+0.6231  p=0.374\n","  2025 예측 평균: 193.98\n","  2026 예측 평균: 219.13\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1200 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["!pip install prophet"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uVK6dDvS6AxB","executionInfo":{"status