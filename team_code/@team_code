, cvar, cname, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    series     = df[cvar].dropna()\n","    exog_train = exog_actual.loc[series.index]\n","\n","    model = SARIMAX(series,\n","                    exog=exog_train,\n","                    order=(1, 1, 0),\n","                    seasonal_order=(1, 1, 0, 12),\n","                    enforce_stationarity=False,\n","                    enforce_invertibility=False)\n","    fitted = model.fit(disp=False)\n","\n","    forecast      = fitted.get_forecast(steps=24, exog=exog_future)\n","    forecast_mean = forecast.predicted_mean\n","    forecast_ci   = forecast.conf_int()\n","    fitted_vals   = fitted.fittedvalues\n","\n","    print(f\"\\n{'─'*45}\")\n","    print(f\"  {cname}\")\n","    print(f\"{'─'*45}\")\n","    print(f\"  AIC={fitted.aic:.2f}  BIC={fitted.bic:.2f}\")\n","    for v in exog_vars:\n","        sig = '✅' if fitted.pvalues[v] < 0.05 else '  '\n","        print(f\"  {sig} {v}: coef={fitted.params[v]:.4f}  \"\n","              f\"p={fitted.pvalues[v]:.4f}\")\n","    print(f\"  2025 예측 평균: {forecast_mean[:12].mean():.2f}\")\n","    print(f\"  2026 예측 평균: {forecast_mean[12:].mean():.2f}\")\n","\n","    ax.plot(series.index, series,\n","            color=color, alpha=0.4, linewidth=1.2, label='실제값')\n","    ax.plot(fitted_vals.index, fitted_vals,\n","            color=color, linewidth=1.5, alpha=0.8, label='적합값')\n","    ax.plot(forecast_mean.index, forecast_mean,\n","            color=color, linewidth=2.2, linestyle='--', label='예측값')\n","    ax.fill_between(forecast_mean.index,\n","                    forecast_ci.iloc[:, 0],\n","                    forecast_ci.iloc[:, 1],\n","                    color=color, alpha=0.15, label='95% CI')\n","    ax.axvline(pd.Timestamp('2025-01-01'),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — SARIMAX 예측 (2025~2026)')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n"