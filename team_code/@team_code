forecast_ci   = forecast.conf_int()\n","    fitted_vals   = fitted.fittedvalues\n","\n","    print(f\"\\n{'─'*45}\")\n","    print(f\"  {cname}\")\n","    print(f\"{'─'*45}\")\n","    print(f\"  AIC={fitted.aic:.2f}  BIC={fitted.bic:.2f}\")\n","    for v in exog_vars:\n","        print(f\"  {v}: coef={fitted.params[v]:.4f}  p={fitted.pvalues[v]:.4f}\")\n","    print(f\"  2025 예측 평균: {forecast_mean[:12].mean():.2f}\")\n","    print(f\"  2026 예측 평균: {forecast_mean[12:].mean():.2f}\")\n","\n","    ax.plot(series.index, series,\n","            color=color, alpha=0.4, linewidth=1.2, label='실제값')\n","    ax.plot(fitted_vals.index, fitted_vals,\n","            color=color, linewidth=1.5, alpha=0.8, label='적합값')\n","    ax.plot(forecast_mean.index, forecast_mean,\n","            color=color, linewidth=2.2, linestyle='--', label='예측값')\n","    ax.fill_between(forecast_mean.index,\n","                    forecast_ci.iloc[:, 0],\n","                    forecast_ci.iloc[:, 1],\n","                    color=color, alpha=0.15, label='95% CI')\n","    ax.axvline(pd.Timestamp('2025-01-01'),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — SARIMAX 예측 (2025~2026, 평년 기상 가정)')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('범죄율 SARIMAX 예측 (외생변수: 전체 기상+사회경제, 평년 기상 가정)', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# 유의한 변수\n","# 폭력범죄: heat_index만 p=0.016 유의\n","# 흉악범죄: covid_dummy만 p=0.021 유의\n","# 재산범죄: 전체 무의미\n","\n","# SARIMAX에서 외생변수가 대부분 유의하지 않은 이유는 차분(d=1, D=1)이 시계열의 대부분의 변동을 흡수해버려서 외생변수가 추가 설명할 여지가 줄어든 거예요. 이건 구조적 한계라 변수를 바꿔도 크게 달라지지 않아요.\n","# 그래도 예측 결과 자체는 활용 가능합니다\n","\n","# 범죄  2024실제(마지막)  2025예측  2026예측  방향\n","# 폭력  ~40수준           39.83     38.61     완만 하락\n","# 흉악  ~9수준            8.66      8.27      소폭 하락\n","# 재산  ~185수준          194.24    213.63    강한 상승"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":100