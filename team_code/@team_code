:{}},{"output_type":"stream","name":"stdout","text":["✅ ITS_result.png 저장 완료\n"]}]},{"cell_type":"code","source":["# STEP 11 Random Forest + SHAP (변수 중요도 분석)\n","from sklearn.ensemble import RandomForestRegressor\n","import shap\n","\n","crime_vars  = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","\n","feature_vars  = [\n","    'heat_index', 'tropical_nights', 'precip_mm', 'sunshine_hours',\n","    'unemp_rate', 'covid_dummy', 'holiday_cnt'\n","]\n","feature_names = [\n","    '불쾌지수', '열대야일수', '강수량', '일조시간',\n","    '실업률', '코로나더미', '공휴일수'\n","]\n","\n","df_rf = df[feature_vars + crime_vars].dropna().copy()\n","X     = df_rf[feature_vars].values\n","\n","fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n","colors_bar = ['steelblue', 'crimson', 'seagreen']\n","\n","for i, (cvar, cname) in enumerate(zip(crime_vars, crime_names)):\n","\n","    y = df_rf[cvar].values\n","\n","    rf = RandomForestRegressor(\n","        n_estimators=300,\n","        max_depth=5,\n","        random_state=42,\n","        n_jobs=-1\n","    )\n","    rf.fit(X, y)\n","\n","    # SHAP\n","    explainer   = shap.TreeExplainer(rf)\n","    shap_values = explainer.shap_values(X)\n","\n","    shap_importance = pd.DataFrame({\n","        '변수': feature_names,\n","        'SHAP 중요도': np.abs(shap_values).mean(axis=0)\n","    }).sort_values('SHAP 중요도', ascending=True)\n","\n","    print(f\"\\n{'─'*40}\")\n","    print(f\"  {cname} SHAP 중요도 순위\")\n","    print(f\"{'─'*40}\")\n","    print(shap_importance.sort_values('SHAP 중요도', ascending=False).to_string(index=False))\n","\n","    ax = axes[i]\n","    ax.barh(shap_importance['변수'],\n","            shap_importance['SHAP 중요도'],\n","            color=colors_bar[i], alpha=0.7)\n","    ax.set_title(f'{cname}', fontsize=12)\n","    ax.set_xlabel('SHAP 중요도 (mean |SHAP|)')\n","    ax.grid(axis='x', alpha=0.3)\n","\n","plt.suptitle('Random Forest — SHAP 변수 중요도', fontsize=15)\n","plt.tight_layout()\n","plt.show()\n","\n","# 폭력범죄\n","# 실업률(3.60) > 불쾌지수(3.22) > 코로나더미(1.46) 순\n","# 기상과 사회경제 요인이 거의 동등하게 중요. 코로나 효과도 유의미\n","# 열대야는 거의 무관(0.018) → STEP 8 회귀 결과와 일치\n","\n","# 흉악범죄\n","# 불쾌지수(1.09)가 압도적 1위, 실업률(0.42)이 2위\n","# 세 범죄 중 유일하게 기상변수가 사회경제 변수를 앞섬 → 흉악범죄가 기상에 가장 민감하다는 H3 부분 지지\n","# 코로나더미(0.023)는 거의 기여 없음 → ITS 결과(코로나 효과 유의)와 겉보기엔 모순이지만, ITS는 수준 변화를, SHAP은 전체 예측 기여도를 보는 거라 관점 차이\n","\n","# 재산범죄\n","# 실업률(7.57)이 압도적 1위, 불쾌지수(3.91)가 2위\n","# 실업률 SHAP이 다른 변수들을 크게 압도 → 재산범죄는 경기·사회경제 요인 주도\n","# 열대야(0.117)는 세 범죄 모두 하위권 → 단변량에서는 유의했지만 다변량에서 기여 미미\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [가설 검증 기여]\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · H3 (폭력범죄가 기상에 더 민감):\n","#   SHAP 기준 흉악범죄에서 불쾌지수가 유일하게 1위\n","#   폭력·재산은 실업률 1위\n","#   → \"흉악범죄가 기상에 가장 민감\"으로 H3 기각\n","#   판정: H3 기각 (흉악 > 폭력 > 재산 순으로 기상 민감)\n","#\n","# · H1 보완:\n","#   불쾌지수가 세 범죄 모두 상위권\n","#   → 기상변수가 예측에 기여함을 비선형 관점에서 재확인\n","#   판정: H1 지지 강화"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":930},"id":"larkUnezRBLY","executionInfo":{"status":"ok","timestamp":1780285650849,"user_tz":-540,"elapsed":8603,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"fc39f414-33e7-4fe1-e4cb-e98791053e29"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","────────────────────────────────────────\n","  폭력범죄율 SHAP 중요도 순위\n","────────────────────────────────────────\n","   변수  SHAP 중요도\n","  실업률  3.671105\n"," 불쾌지수  3.190135\n","코로나더미  1.390683\n","  강수량  0.422294\n"," 일조시간  0.223809\n"," 공휴일수  0.061993\n","열대야일수  0.020695\n","\n","────────────────────────────────────────\n","  흉악범죄율 SHAP 중요도 순위\n","────────────────────────────────────────\n","   변수  SHAP 중요도\n"," 불쾌지수  1.089396\n","  실업률  0.414960\n"," 일조시간  0.183742\n","  강수량  0.124524\n"," 공휴일수  0.063997\n","열대야일수  0.062656\n","코로나더미  0.042483\n","\n","────────────────────────────────────────\n","  재산범죄율 SHAP 중요도 순위\n",