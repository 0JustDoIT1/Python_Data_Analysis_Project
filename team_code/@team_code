crime_names, crime_colors):\n","\n","    model  = results_all[cvar]\n","    params = model.params[X_vars]\n","    ci     = model.conf_int().loc[X_vars]\n","    pvals  = model.pvalues[X_vars]\n","\n","    for j, (var, label) in enumerate(zip(X_vars, x_labels)):\n","        coef   = params[var]\n","        lo, hi = ci.loc[var]\n","        p      = pvals[var]\n","        sig_color = color if p < 0.05 else 'lightgray'\n","\n","        ax.plot([lo, hi], [j, j], color=sig_color, linewidth=2)\n","        ax.scatter(coef, j,\n","                   color=sig_color, s=80, zorder=5,\n","                   marker='D' if p < 0.05 else 'o')\n","\n","    ax.axvline(0, color='black', linewidth=1.0, linestyle='--')\n","    ax.set_yticks(range(len(X_vars)))\n","    ax.set_yticklabels(x_labels)\n","    ax.set_title(f'{cname}\\nR²={model.rsquared:.3f}', fontsize=11)\n","    ax.set_xlabel('회귀계수 (95% CI)')\n","    ax.grid(axis='x', alpha=0.3)\n","\n","plt.suptitle('다중회귀 회귀계수 Forest Plot\\n(색상=유의 p<0.05, 회색=유의하지 않음)',\n","             fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 8 다중회귀 최종 결과 (열대야 제거)\n","# 열대야: 영과잉(zero-inflated) 구조 → STEP 7 t검정으로 별도 검증\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# [폭력범죄율] R²=0.675\n","# · heat_index:   +0.382 (p=0.000) ✅\n","#   불쾌지수 1 증가 시 폭력범죄율 0.38 증가\n","# · precip_mm:    -0.015 (p=0.037) ✅\n","#   강수량 많을수록 폭력범죄 감소\n","#   → 비 오는 날 외출 억제 → 폭력 기회 감소\n","#   → 열대야 제거 후 강수량 효과가 드러남\n","# · sunshine_hours: p=0.793 유의하지 않음\n","# · unemp_rate:   +5.979 (p=0.000) ✅\n","#   실업률↑ → 폭력범죄↑ (경기악화-범죄 이론 일치)\n","# · covid_dummy:  -7.760 (p=0.000) ✅\n","#   코로나 구간 폭력범죄 약 7.8 감소\n","\n","# [흉악범죄율] R²=0.673\n","# · heat_index:     +0.075 (p=0.000) ✅\n","# · precip_mm:      p=0.117 유의하지 않음\n","#   → 강수량의 흉악범죄 효과는 계절 동시성 수준\n","# · sunshine_hours: +0.014 (p=0.000) ✅\n","#   일조시간↑ → 야외활동·사회접촉 증가 → 흉악범죄 기회 증가\n","# · unemp_rate:     -0.713 (p=0.000) ✅\