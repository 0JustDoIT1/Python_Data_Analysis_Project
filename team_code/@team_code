   X_const = sm.add_constant(X)\n","\n","    # 일반 OLS (HC3 없이) 잔차 추출\n","    ols = sm.OLS(y, X_const).fit()\n","\n","    # Breusch-Pagan\n","    bp_stat, bp_p, _, _ = het_breuschpagan(ols.resid, X_const)\n","\n","    # White\n","    wh_stat, wh_p, _, _ = het_white(ols.resid, X_const)\n","\n","    판정 = \"이분산 ✅ → HC3 필요\" if bp_p < 0.05 or wh_p < 0.05 else \"등분산 → HC3 불필요\"\n","    print(f\"{cname:<12} {bp_stat:>10.3f} {bp_p:>10.4f} {wh_stat:>12.3f} {wh_p:>10.4f} {판정:>18}\")\n","\n","print(\"\\n※ H0: 등분산 (잔차가 독립변수와 무관)\")\n","print(\"※ p<0.05 → H0 기각 → 이분산성 존재 → HC3 적용 정당\")\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 이분산성 검정 결과\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# [폭력범죄]\n","# · BP: p=0.662 → 유의하지 않음\n","# · White: p=0.006 → 유의 ✅\n","# · 판정: 이분산 → HC3 필요\n","# · 해석: Breusch-Pagan은 선형 이분산성만 검출하고\n","#         White는 비선형 이분산성까지 포착\n","#         → 폭력범죄의 이분산성은 비선형 구조\n","#           (단순히 분산이 독립변수에 비례하는 게 아니라\n","#            복잡한 패턴으로 분산이 변함)\n","\n","# [흉악범죄]\n","# · BP: p=0.020 → 유의 ✅\n","# · White: p=0.280 → 유의하지 않음\n","# · 판정: 이분산 → HC3 필요\n","# · 해석: BP가 유의 → 선형 이분산성 존재\n","#         (특정 독립변수 수준에서 분산이 체계적으로 달라짐)\n","#         두 검정 중 하나만 유의해도 이분산성 존재로 판단\n","\n","# [재산범죄]\n","# · BP: p=0.295 → 유의하지 않음\n","# · White: p=0.538 → 유의하지 않음\n","# · 판정: 등분산 → HC3 불필요\n","# · 해석: 두 검정 모두 유의하지 않음\n","#         → 통계적으로는 등분산\n","#         → 그러나 재산범죄는 Rolling Std에서\n","#           추세 상승과 함께 분산이 확대되는 패턴이 시각적으로 확인됨\n","#         → 두 가지 선택지:\n","#           A. HC3 적용 (보수적 접근, 일관성 유지)\n","#           B. HC3 미적용 (검정 결과 따름)\n","\n","# [최종 결정 — 보수적 접근으로 세 범죄 모두 HC3 적용]\n","# · 근거:\n","#   1. 폭력(White 유의)·흉악(BP 유의)에서 이분산성 확인\n","#   2. 재산은 검정 유의하지 않으나 시계열 특성상\n","#      추세 구간별 분산 구조가 다를 가능성 있음\n","#   3. HC3는 등분산에서도 일치 추정량 → 적용해도 손해 없음\n","#   4. 세 범죄를 동일 기준으로 처리하는 일관성\n","\n","# [발표 서술]\n","# \"Breusch-Pagan 및 White 검정 결과,\n","#  폭력범죄(White p=0.006)와 흉악범죄(BP p=0.020)에서\n","#  이분산성이 통계적으로 확인되었다.\n","#  재산범죄는 두 검정 모