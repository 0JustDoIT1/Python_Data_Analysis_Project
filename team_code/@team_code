rophet = pd.DataFrame({\n","        'ds': df.index,\n","        'y':  df[cvar].values\n","    }).dropna()\n","\n","    # 외생변수 추가\n","    for wvar in weather_vars:\n","        df_prophet[wvar] = df[wvar].values[:len(df_prophet)]\n","\n","    # ── 모델 설정 ──\n","    m = Prophet(\n","        yearly_seasonality=True,\n","        weekly_seasonality=False,\n","        daily_seasonality=False,\n","        seasonality_mode='additive',\n","        changepoint_prior_scale=0.05,   # 추세 변화 민감도\n","        uncertainty_samples=1000\n","    )\n","\n","    # 기상변수 외생변수 등록\n","    for wvar in weather_vars:\n","        m.add_regressor(wvar, standardize=True)\n","\n","    m.fit(df_prophet)\n","\n","    # 미래 데이터프레임 생성\n","    future = m.make_future_dataframe(periods=24, freq='MS')\n","\n","    # 미래 외생변수 채우기 (과거: 실제값, 미래: 예측값)\n","    for wvar in weather_vars:\n","        past_vals   = df[wvar].values\n","        future_vals = exog_future[wvar].values\n","        future[wvar] = np.concatenate([past_vals,\n","                                       future_vals])[:len(future)]\n","\n","    forecast = m.predict(future)\n","\n","    # 성능 지표 (인샘플)\n","    fitted   = forecast[forecast['ds'] <= df.index[-1]]['yhat'].values\n","    actual   = df_prophet['y'].values\n","    mape_is  = np.mean(np.abs((actual - fitted) / actual) * 100)\n","\n","    # 2025~2026 예측값\n","    pred_2025 = forecast[forecast['ds'].dt.year == 2025]['yhat']\n","    pred_2026 = forecast[forecast['ds'].dt.year == 2026]['yhat']\n","\n","    print(f\"\\n{'─'*50}\")\n","    print(f\"  {cname} — Prophet 결과\")\n","    print(f\"{'─'*50}\")\n","    print(f\"  In-sample MAPE: {mape_is:.2f}%\")\n","    print(f\"  2025 예측 평균: {pred_2025.mean():.2f}\")\n","    print(f\"  2026 예측 평균: {pred_2026.mean():.2f}\")\n","\n","    # 시각화\n","    ax = axes[i]\n","    past_forecast = forecast[forecast['ds'] <= df.index[-1]]\n","    futu_forecast = forecast[forecast['ds'] >  df.index[-1]]\n","\n","    ax.plot(df_prophet['ds'], df_prophet['y'],\n","            color=color, alpha=0.4, linewidth=1.2, label='실제값')\n","    ax.plot(pd.to_datetime(past_forecast['ds']),\n","            past_forecast['yhat'],\n","            color=color, linewidth=1.5, alpha=0.8, label='적합값')\n","    ax.plot(pd.to_datetime(futu_forecast['ds']),\n","            futu_forecast['yhat'],\n","            color=color, linewidth=2.2, linestyle='--', label='예측값')\n","    ax.fill_between(pd.to_datetime(futu_forecast['ds']),\n","                    futu_forecast['yhat_lower'],\n","                    futu_forecast['yhat_upper'],\n","                    color=color, alpha=0.15, label='불확실성 구간')\n","    ax.axvline(pd.Timestamp('2025-01-01'),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — Prophet 예측 (2025~2026)')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('범죄율 Prophet 예측 (외생변수: 기상변수 4개)', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# ── 컴포넌트 분해 플롯 (흉악범죄만) ──\n","print(\"\\n흉악범죄율 Prophet 컴포넌트 분해:\")\n","df_prophet_h = pd.DataFrame({\n","    'ds': df.index,\n","    'y':  df['heinous_rate_working'].values\n","}).dropna()\n","for wvar in weather_vars:\n","    df_prophet_h[wvar] = df[wvar].values[:len(df_prophet_h)]\n","\n","m_h = Prophet(yearly_seasonality=True, weekly_seasonality=False,\n","              daily_seasonality=False, seasonality_mode='additive',\n","              changepoint_prior_scale=0.05)\n","for wvar in weather_vars:\n","    m_h.add_regressor(wvar, standardize=True)\n","m_h.fit(df_prophet_h)\n","\n","future_h = m_h.make_future_dataframe(periods=24, freq='MS')\n","for wvar in weather_vars:\n","    future_h[wvar] = np.concatenate([\n","        df[wvar].values,\n","        exog_future[wvar].values\n","    ])[:len(future_h)]\n","\n","forecast_h = m_h.predict(future_h)\n","fig_comp = m_h.plot_components(forecast_h)\n","plt.suptitle('흉악범죄율 Prophet 컴포넌트 분해\\n(추세 / 계절성 / 기상변수별 기여)', fontsize=12)\n","plt.tight_layout()\n","plt.show()\n","\n","# ╔══════════════════════════════════════════════════════════════╗\n","# ║         Prophet 예측 결과 및 해석                              ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 모델 설정\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · yearly_seasonality=True → 연간 계절성 반영\n","# · seasonality_mode='additive' → 가법 모형 (계절 진폭 일정)\n","# · changepoint_prior_scale=0.05 → 추세 변화 민감도 (낮을수록 완만)\n","# · add_regressor(기상변수 4개, standardize=True)\n","#   → 기상변수를 표준화하여 외생변수로 투입\n","#   → SARIMAX와 달리 AR 항이 없으므로 기상변수 기여 흡수 없음\n","# · 미래 외생변수: 불쾌지수(SARIMA 예측값) / 나머지(평년값)\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# In-sample MAPE (전체 학습 기간 기준)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: 3.69% ← 양호\n","# · 흉악범죄: 6.13% ← 양호\n","# · 재산범죄: 3.32% ← 양호\n","#\n","# [주의] In-sample MAPE는 학습 데이터로 평가한 수치\n","#        → SARIMAX 백테스팅 MAPE(학습/테스트 분리)와 직접 비교 불가\n","#        → 단순 참고용. 동일 조건 비교는 별도 백테스팅 필요\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 2025~2026 예측값\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: 39.42(2025) → 38.28(2026) ← 완만 하락\n","# · 흉악범죄: 10.15(2025) → 10.58(2026) ← 상승 지속\n","# · 재산범죄: 183.03(2025) → 196.04(2026) ← 상승 지속\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# SARIMAX vs Prophet 예측 방향 비교\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","#              SARIMAX 2025  Prophet 2025  방향 일치\n","# 폭력범죄      40.20         39.42         ✅ 하락 일치\n","# 흉악범죄       8.68         10.15         ❌ 반대 (SARIMAX↓ vs Prophet↑)\n","# 재산범죄     194.83        183.03         ✅ 상승 일치 (수준 차이 존재)\n","#\n","# [흉악범죄 방향 불일치 해석]\n","# · SARIMAX: d=1 차분으로 2022~2024 상승 추세를 일시적으로 학습\n","#            → 2025년에는 조정(하락) 예측\n","# · Prophet: changepoint를 통해 2022년 이후 상승 추세 변화를 포착\n","#            → 상승 추세 지속으로 예측\n","# · 어느 모델이 맞는지는 실제 2025년 데이터로만 검증 가능\n","# · 두 모델 예측의 불일치 자체가 흉악범죄의 높은 불확실성을 반영\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 컴포넌트 분해 — 흉악범죄율 (핵심)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [추세 (trend)]\n","# · 2014~2020: 완만한 상승 (7.3 → 7.8)\n","# · 2021~: 급격한 상승 전환 (2022년 변화점 포착)\n","# · 2025~2026: 상승 추세 지속 예측 (10.5~10.8 수준)\n","# · SARIMAX가 놓쳤던 구조적 상승 추세를 Prophet이 명확하게 포착\n","#\n","# [계절성 (yearly)]\n","# · 3~4월: 양수 피크 (봄 상승)\n","# · 7월: 양수 피크 (여름 상승) ← 기상 효과와 일치\n","# · 12월~1월: 음수 저점 (겨울 감소)\n","# · 연간 진폭 약 ±4~5 수준\n","#\n","# [기상변수 합산 기여 (extra_regressors_additive)]\n","# · 범위: -1.5 ~ +0.5\n","# · 여름(7~8월): 양수 → 기상변수가 흉악범죄 증가에 기여\n","# · 겨울(1~2월): 음수 → 기상변수가 흉악범죄 감소에 기여\n","# · 2020~2021 코로나 구간: 기여값 0에 수렴\n","#   → 코로나로 외출·사회접촉 억제 시 기상 효과도 함께 억제됨\n","# · SARIMAX에서는 AR 항이 흡수했던 기상 기여분이\n","#   Prophet에서는 명확하게 분리되어 시각화됨\n","# · 단, 네 기상변수의 합산 기여이므로 변수별 분리는 별도 확인 필요\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# Prophet vs SARIMAX 종합 비교\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# Prophet 장점\n","# · 추세·계절성·기상변수 기여를 컴포넌트로 분리 시각화 가능\n","#   → \"기상이 얼마나 기여하는가\"를 직접 보여줄 수 있음\n","# · AR 흡수 문제 없어 기상변수 효과가 모델에 반영됨\n","# · 흉악범죄 예측에서 2022년 이후 구조 변화를 더 잘 반영\n","# · In-sample MAPE 전반적으로 낮음\n","#\n","# Prophet 단점\n","# · In-sample MAPE라 백테스팅과 직접 비교 불가\n","#   → 과적합(overfitting) 가능성 배제 불가\n","# · 흉악범죄 예측이 SARIMAX와 방향 반대 → 불확실성 높음\n","# · 학술 논문보다 실무 예측 도구 성격\n","#   → 방법론 정당화 시 추가 설명 필요\n","#\n","# 최종 전략\n","# · SARIMAX: 메인 예측 모델\n","#   (백테스팅으로 검증됨, 폭력·재산 MAPE 양호)\n","# · Prophet: 보조 모델\n","#   (컴포넌트 분해로 기상 기여 시각화 → 발표 자료 활용)\n","# · 두 모델 예측이 일치하는 폭력·재산은 방향성 신뢰 가능\n","# · 흉악범죄는 두 모델 불일치 → 불확실성 구간으로 서술\n","#   \"2022년 구조 변화로 인해 예측 불확실성이 높으며,\n","#    두 모델의 예측 방향이 상이함\"으로 한계 명시"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"1ph1s-p56Bg2","executionInfo":{"status":"ok","timestamp":1780285699156,"user_tz":-540,"elapsed":16033,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"83719727-14c8-40ae-c3ce-a8f5e7245e88"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","──────────────────────────────────────────────────\n","  폭력범죄율 — Prophet 결과\n","──────────────────────────────────────────────────\n","  In-sample MAPE: 3.69%\n","  2025 예측 평균: 39.42\n","  2026 예측 평균: 38.28\n","\n","──────────────────────────────────────────────────\n","  흉악범죄율 — Prophet 결과\n","──────────────────────────────────────────────────\n","  In-sample MAPE: 6.13%\n","  2025 예측 평균: 10.15\n","  2026 예측 평균: 10.58\n","\n","──────────────────────────────────────────────────\n","  재산범죄율 — Prophet 결과\n","──────────────────────────────────────────────────\n","  In-sample MAPE: 3.32%\n","  2025 예측 평균: 183.03\n","  2026 예측 평균: 196.04\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1200 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","흉악범죄율 Prophet 컴포넌트 분해:\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x900 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Prophet 백테스팅 — 평년값 대체 버전 (SARIMAX와 동일 조건)\n","from prophet import Prophet\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","crime_vars  = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","colors      = ['steelblue', 'crimson', 'seagreen']\n","\n","weather_vars = ['heat_index', 'tropical_nights', 'precip_mm', 'sunshine_hours']\n","\n","train_end  = '2023-12-01'\n","test_start = '2024-01-01'\n","test_end   = '2024-12-01'\n","\n","df_train = df[df.index <= train_end]\n","df_test  = df[(df.index >= test_start) & (df.index <= test_end)]\n","\n","# ── 불쾌지수만 SARIMA 예측, 나머지는 평년값 ──\n","heat_model  = SARIMAX(df_train['heat_index'].dropna(),\n","                      order=(1, 0, 0),\n","                      seasonal_order=(1, 1, 0, 12),\n","                      enforce_stationarity=False,\n","                      enforce_invertibility=False)\n","heat_fitted = heat_model.fit(disp=False)\n","heat_pred   = heat_fitted.get_forecast(steps=12).predicted_mean\n","\n","future_index_bt   = pd.date_range(test_start, periods=12, freq='MS')\n","monthly_avg_train = df_train.groupby('month')[weather_vars].mean()\n","\n","exog_future_bt = pd.DataFrame({\n","    'heat_index':      heat_pred.values,\n","    'tropical_nights': [monthly_avg_train.loc[m, 'tropical_nights']\n","                        for m in future_index_bt.month],\n","    'precip_mm':       [monthly_avg_train.loc[m, 'precip_mm']\n","                        for m in future_index_bt.month],\n","    'sunshine_hours':  [monthly_avg_train.loc[m, 'sunshine_hours']\n","                        for m in future_index_bt.month],\n","}, index=future_index_bt)\n","\n","fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n","metrics_prophet = []\n","\n","for ax, cvar, cname, color in zip(axes, crime_vars, crime_names, colors):\n","\n","    df_prophet_train = pd.DataFrame({\n","        'ds': df_train.index,\n","        'y':  df_train[cvar].values\n","    }).dropna()\n","    for wvar in weather_vars:\n","        df_prophet_train[wvar] = df_train[wvar].values[:len(df_prophet_train)]\n","\n","    m = Prophet(\n","        yearly_seasonality=True,\n","        weekly_seasonality=False,\n","        daily_seasonality=False,\n","        seasonality_mode='additive',\n","        changepoint_prior_scale=0.05,\n","        uncertainty_samples=1000\n","    )\n","    for wvar in weather_vars:\n","        m.add_regressor(wvar, standardize=True)\n","    m.fit(df_prophet_train)\n","\n","    future = m.make_future_dataframe(periods=12, freq='MS')\n","    for wvar in weather_vars:\n","        past_vals   = df_train[wvar].values\n","        future_vals = exog_future_bt[wvar].values\n","        future[wvar] = np.concatenate([past_vals, future_vals])[:len(future)]\n","\n","    forecast    = m.predict(future)\n","    pred_2024   = forecast[forecast['ds'].dt.year == 2024]['yhat'].values\n","    actual_2024 = df_test[cvar].values[:12]\n","\n","    mae  = np.mean(np.abs(actual_2024 - pred_2024))\n","    rmse = np.sqrt(np.mean((actual_2024 - pred_2024)**2))\n","    mape = np.mean(np.abs((actual_2024 - pred_2024) / actual_2024) * 100)\n","\n","    metrics_prophet.append({\n","        '범죄유형': cname,\n","        'MAE': round(mae, 3),\n","        'RMSE': round(rmse, 3),\n","        'MAPE(%)': round(mape, 2)\n","    })\n","\n","    print(f\"\\n{'─'*45}\")\n","    print(f\"  {cname} Prophet 백테스팅\")\n","    print(f\"{'─'*45}\")\n","    print(f\"  MAE={mae:.3f}  RMSE={rmse:.3f}  MAPE={mape:.2f}%\")\n","\n","    past_fc = forecast[forecast['ds'] <= pd.Timestamp(train_end)]\n","    futu_fc = forecast[forecast['ds'] >  pd.Timestamp(train_end)]\n","\n","    ax.plot(df[cvar].index, df[cvar],\n","            color=color, alpha=0.3, linewidth=1.2, label='전체 실제값')\n","    ax.plot(df_test[cvar].index, df_test[cvar],\n","            color=color, linewidth=2, label='2024 실제값')\n","    ax.plot(pd.to_datetime(futu_fc['ds']), futu_fc['yhat'],\n","            color='black', linewidth=2, linestyle='--', label='2024 예측값')\n","    ax.fill_between(pd.to_datetime(futu_fc['ds']),\n","                    futu_fc['yhat_lower'], futu_fc['yhat_upper'],\n","                    color='black', alpha=0.1, label='불확실성 구간')\n","    ax.axvline(pd.Timestamp(test_start),\n","               color='red', linestyle='--', linewidth=1.2, label='예측 시작')\n","    ax.set_title(f'{cname} — Prophet 백테스팅 MAPE={mape:.2f}%')\n","    ax.set_ylabel('범죄율 (10만명당)')\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('Prophet 백테스팅 — 2024년 예측 vs 실제값\\n'\n","             '(불쾌지수: SARIMA 예측 / 나머지: 평년값)',\n","             fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# 최종 비교 테이블\n","print(\"\\n=== SARIMAX vs Prophet 백테스팅 MAPE 비교 (동일 조건) ===\")\n","print(f\"{'범죄유형':<12} {'SARIMAX':>10} {'Prophet':>10} {'우수':>8}\")\n","sarimax_mapes = {'폭력범죄율': 7.04, '흉악범죄율': 27.02, '재산범죄율': 7.97}\n","for met in metrics_prophet:\n","    s = sarimax_mapes[met['범죄유형']]\n","    p = met['MAPE(%)']\n","    better = 'Prophet ✅' if p < s else 'SARIMAX ✅'\n","    print(f\"{met['범죄유형']:<12} {s:>9.2f}% {p:>9.2f}% {better:>10}\")\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# SARIMAX vs Prophet 백테스팅 최종 비교 (동일 조건)\n","# 불쾌지수: SARIMA 예측 / 나머지: 평년값\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","#              SARIMAX    Prophet    우수\n","# 폭력범죄      7.04%      3.90%     Prophet ✅\n","# 흉악범죄     27.02%     16.34%     Prophet ✅\n","# 재산범죄      7.97%      9.25%     SARIMAX ✅\n","\n","# [이전 조건(클리핑) vs 현재 조건(평년값) Prophet 비교]\n","#              이전(클리핑)  현재(평년값)  변화\n","# 폭력범죄      3.34%        3.90%       소폭 악화\n","# 흉악범죄     13.42%       16.34%       소폭 악화\n","# 재산범죄      9.12%        9.25%       거의 동일\n","# → 클리핑 버전이 Prophet에서 약간 유리했으나\n","#   차이가 크지 않아 동일 조건 유지가 더 중요\n","\n","# [폭력범죄] Prophet 우세 (3.90% vs 7.04%)\n","# · Prophet이 2024년 하락 추세를 더 정확하게 포착\n","# · changepoint 감지로 2020년 이후 수준 변화를 잘 학습\n","\n","# [흉악범죄] Prophet 우세하나 둘 다 불량\n","# · Prophet 16.34% vs SARIMAX 27.02%\n","# · Prophet이 약 1.7배 개선됐으나 16%도 높은 수준\n","# · 두 모델 모두 2022년 구조 변화 이후 과대 예측\n","# · → 방향성만 참고, 수치 신뢰도 낮음\n","\n","# [재산범죄] SARIMAX 소폭 우세 (7.97% vs 9.25%)\n","# · 차이 1.28%p로 미미\n","# · SARIMAX 차분 기반이 강한 상승 추세를 더 잘 포착\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [최종 모델 전략]\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: Prophet 메인 (MAPE 3.90%)\n","# · 흉악범죄: Prophet 메인 (MAPE 16.34%, 둘 다 불량이나 Prophet이 우수)\n","# · 재산범죄: SARIMAX 메인 (MAPE 7.97%)\n","#\n","# · 흉악범죄는 두 모델 모두 예측 정확도 낮음\n","#   → \"방향성(하락 조정) 참고 수준\"으로 해석 권장\n","#\n","# · SARIMAX 기상변수 유의성 문제 보완:\n","#   Prophet 컴포넌트 분해에서\n","#   기상변수(extra_regressors) 기여가 시각적으로 확인됨\n","#   → \"기상이 예측에 기여한다\"는 보완 근거로 활용"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"zesZT3Oh66by","executionInfo":{"status":"ok","timestamp":1780285701236,"user_tz":-540,"elapsed":2077,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"e5ccdc90-4624-42ec-dc1b-d144c7d26e9d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","─────────────────────────────────────────────\n","  폭력범죄율 Prophet 백테스팅\n","─────────────────────────────────────────────\n","  MAE=1.573  RMSE=1.748  MAPE=3.90%\n","\n","─────────────────────────────────────────────\n","  흉악범죄율 Prophet 백테스팅\n","─────────────────────────────────────────────\n","  MAE=1.499  RMSE=1.589  MAPE=16.34%\n","\n","─────────────────────────────────────────────\n","  재산범죄율 Prophet 백테스팅\n","─────────────────────────────────────────────\n","  MAE=16.361  RMSE=17.684  MAPE=9.25%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1200 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","=== SARIMAX vs Prophet 백테스팅 MAPE 비교 (동일 조건) ===\n","범죄유형            SARIMAX    Prophet       우수\n","폭력범죄율             7.04%      3.90%  Prophet ✅\n","흉악범죄율            27.02%     16.34%  Prophet ✅\n","재산범죄율             7.97%      9.25%  SARIMAX ✅\n"]}]},{"cell_type":"code","source":["# SARIMAX vs Prophet 백테스팅 성능 비교 시각화\n","fig, ax = plt.subplots(figsize=(10, 5))\n","\n","crime_labels = ['폭력범죄', '흉악범죄', '재산범죄']\n","sarimax_mapes = [7.04, 27.02, 7.97]\n","prophet_mapes = [3.90, 16.34, 9.25]\n","\n","x     = np.arange(len(crime_labels))\n","width = 0.35\n","\n","bars1 = ax.bar(x - width/2, sarimax_mapes, width,\n","               label='SARIMAX', color='steelblue', alpha=0.8)\n","bars2 = ax.bar(x + width/2, prophet_mapes, width,\n","               label='Prophet', color='darkorange', alpha=0.8)\n","\n","# 값 표시\n","for bar in bars1:\n","    ax.text(bar.get_x