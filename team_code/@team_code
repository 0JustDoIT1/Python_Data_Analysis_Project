_lag,\n","                verbose=False\n","            )\n","\n","            for lag in range(1, max_lag + 1):\n","                f_stat = result[lag][0]['ssr_ftest'][0]\n","                p_val  = result[lag][0]['ssr_ftest'][1]\n","\n","                records.append({\n","                    '기상변수': wname,\n","                    '범죄변수': cname,\n","                    'Lag': lag,\n","                    'F통계량': f_stat,\n","                    'p값': p_val,\n","                    '유의': '✅' if p_val < 0.05 else ''\n","                })\n","\n","        except Exception as e:\n","            print(f\"오류: {wname} → {cname}: {e}\")\n","\n","granger_df = pd.DataFrame(records)\n","\n","# 유의한 것만 출력\n","sig_df = granger_df[granger_df['유의'] == '✅'].reset_index(drop=True)\n","\n","print(\"=== Granger 인과 검정 — 유의한 결과 (p<0.05) ===\")\n","print(sig_df.to_string(index=False))\n","\n","print(\"\\n=== 전체 결과 ===\")\n","print(granger_df.to_string(index=False))\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# STEP 9 Granger 인과 검정 결과\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","\n","# [max_lag=3 설정 근거]\n","# · VAR AIC/BIC 통계적 최적 lag = 6\n","# · 단, 월별 데이터에서 여름 시즌(6~9월) 내 시차는 최대 3개월\n","#   lag 4부터는 계절 전환(가을)으로 기상 단독 효과 해석 어려움\n","# · CCF에서도 lag 0~3을 주력 해석 범위로 설정한 것과 일관성 유지\n","# · → 이론적 타당성 기준 max_lag=3으로 제한\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [불쾌지수 → 세 범죄] ← 가장 강하고 일관된 신호\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력·흉악·재산 모두 lag 1~3 전부 유의 (p<0.001)\n","# · F통계량: 8.7~50.2로 매우 강함\n","# · lag 1부터 유의 → 불쾌지수가 다음 달 범죄율을\n","#   예측하는 즉각적 선행성 존재\n","# · lag 3까지 일관되게 유의 → 여름 시즌 전체에서 효과 지속\n","# · 해석: \"불쾌지수가 높았던 달\"은 이후 1~3개월간\n","#   범죄율 예측에 지속적으로 기여\n","# · 기상변수 4개 중 유일하게 세 범죄 모두 lag 1~3 전부 유의\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# [열대야 → 폭력범죄] lag 2~3 유의\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\