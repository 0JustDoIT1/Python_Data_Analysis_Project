\n","        # 여름(6~9월) 평균 비교\n","        summer_months = [6, 7, 8, 9]\n","        year_summer   = year_data[year_data.index.isin(summer_months)].mean()\n","        normal_summer = normal_data[normal_data.index.isin(summer_months)].mean()\n","        diff_pct      = (year_summer - normal_summer) / normal_summer * 100\n","\n","        bar = ax.bar(j, diff_pct,\n","                     color=color if diff_pct > 0 else 'gray',\n","                     alpha=0.7, width=0.5)\n","        ax.text(j, diff_pct + (0.3 if diff_pct > 0 else -0.8),\n","                f'{diff_pct:+.1f}%',\n","                ha='center', fontsize=11, fontweight='bold')\n","\n","    ax.axhline(0, color='black', linewidth=0.8)\n","    ax.set_xticks(range(len(anomaly_years)))\n","    ax.set_xticklabels(list(anomaly_years.keys()), fontsize=9)\n","    ax.set_title(f'{cname}\\n이상치 연도 여름(6~9월) 평년 대비 변화율', fontsize=10)\n","    ax.set_ylabel('평년 대비 변화율 (%)')\n","    ax.grid(axis='y', alpha=0.3)\n","\n","plt.suptitle('기상 이상치 연도 — 여름철 범죄율 평년 대비 변화율\\n(2018 폭염 / 2020 장마 / 2022 코로나해제+폭염)', fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","\n","# 수치 출력\n","print(\"=== 기상 이상치 연도 여름(6~9월) 범죄율 평년 대비 변화율 ===\\n\")\n","for label, year in anomaly_years.items():\n","    print(f\"[{label.replace(chr(10), ' ')}]\")\n","    for cvar, cname in zip(crime_vars, crime_names):\n","        year_summer   = df[df['year']==year].groupby('month')[cvar].mean()\n","        year_summer   = year_summer[year_summer.index.isin([6,7,8,9])].mean()\n","        normal_summer = monthly_avg_crime[cvar][[6,7,8,9]].mean()\n","        diff_pct      = (year_summer - normal_summer) / normal_summer * 100\n","        sig = '↑' if diff_pct > 0 else '↓'\n","        print(f\"  {cname}: 평년 {normal_summer:.1f} → {year}년 {year_summer:.1f} ({diff_pct:+.1f}% {sig})\")\n","    print()\n","\n","# 추가 분석 2 — 기상 이상치 연도 결과 해석\n","#\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 2018년 (역대급 폭염) 여름(6~9월) 평년 대비\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: +6.0% ↑ ← 폭염이 폭력범죄 증가로 이어짐\n","# · 흉악범죄: -4.9% ↓ ← 예상과 반대. 극도의 더위에 외출 억제 효과?\n","# · 재산범죄: -6.8% ↓ ← 역시 감소. 외출 억제 → 사회접촉 감소 가능성\n","#\n","# [해석]\n","# 2018년 폭염은 폭력범죄만 증가시키고 흉악·재산은 오히려 감소\n","# → 극단적 폭염(불쾌지수 75↑ 구간)에서 외출 자체가 줄어\n","#   흉악·재산범죄 기회가 감소한 것으로 해석 가능\n","# → STEP 7 Piecewise에서 불쾌지수 68 초과 시\n","#   폭력범죄 기울기가 역전되는 현상과 일치하지 않음\n","#   (폭력은 오히려 증가) → 폭력은 실내·가정 내 발생이\n","#   많아서 외출 억제 효과가 덜 적용된 것으로 해석 가능\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 2020년 (역대급 장마) 여름(6~9월) 평년 대비\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: -6.9% ↓\n","# · 흉악범죄: -11.9% ↓ ← 가장 큰 감소\n","# · 재산범죄: +1.6% ↑ ← 소폭 증가 (온라인 사기 등 비대면 범죄 가능성)\n","#\n","# [해석]\n","# 2020년은 코로나 + 역대급 장마가 동시에 발생\n","# → 폭력·흉악 감소는 코로나 거리두기 효과인지\n","#   장마(외출 억제) 효과인지 분리 불가\n","# → 재산범죄만 소폭 증가 → 코로나 기간 온라인 활동 증가와\n","#   연관된 비대면 재산범죄 증가 가능성\n","# → 코로나와 기상이 동시 작용한 복합 구간이므로\n","#   장마 단독 효과로 해석 시 주의 필요\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 2022년 (코로나 해제 + 폭염) 여름(6~9월) 평년 대비\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 폭력범죄: -9.9% ↓ ← 낮은 수준 유지 (코로나 이후 구조 변화)\n","# · 흉악범죄: +21.2% ↑ ← 압도적 증가. 전체에서 가장 큰 변화\n","# · 재산범죄: +5.6% ↑\n","#\n","# [해석]\n","# 흉악범죄 +21.2%는 이 분석 전체에서 가장 극적인 수치\n","# → ITS 분석(코로나 해제 반동)과 정확히 일치\n","# → 코로나 해제로 외출·사회접촉 급증 + 폭염 동시 작용\n","#   → 두 효과의 시너지로 흉악범죄 급등\n","# → 단, 기상 단독 효과인지 코로나 해제 효과인지 분리 불가\n","#   \"코로나 해제 + 폭염이 겹친 2022년에 흉악범죄가\n","#    평년 대비 21.2% 급등했으며, 이는 두 요인의 복합 효과로 해석\"\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 종합 인사이트\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 1. 기상 효과는 단순히 \"더우면 범죄 증가\"가 아님\n","#    → 폭염 강도와 사회적 조건에 따라 범죄 유형별 반응이 다름\n","#    → 극단적 폭염: 폭력↑ / 흉악·재산↓ (외출 억제 효과 우세)\n","#    → 코로나 해제 + 폭염: 흉악↑↑ (사회접촉 급증 + 열스트레스)\n","#\n","# 2. 기상 효과는 사회적 맥락(코로나, 거리두기 등)과 상호작용\n","#    → 같은 폭염이라도 사회 상황에 따라 효과 방향이 달라짐\n","#    → 기상변수 단독보다 기상 × 사회적 조건 상호작용 분석 필요\n","#      (후속 연구 방향으로 제시 가능)\n","#\n","# 3. 발표 활용\n","#    \"2018년 역대급 폭염에서 폭력범죄 +6%, 흉악범죄 -5%라는\n","#     상반된 결과는 기상-범죄 관계가 단순하지 않음을 보여준다.\n","#     반면 2022년 코로나 해제와 폭염이 겹친 시기에는\n","#     흉악범죄가 평년 대비 21.2% 급등하여 기상과 사회적 요인의\n","#     복합 작용이 범죄 급증의 핵심 조건임을 시사한다.\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":581},"id":"be6YXkT08TLi","executionInfo":{"status":"ok","timestamp":1780285708689,"user_tz":-540,"elapsed":2746,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"a0700976-2e12-4c7c-a5da-9cc865b3ac00"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["=== 기상 이상치 연도 여름(6~9월) 범죄율 평년 대비 변화율 ===\n","\n","[2018년 (역대급 폭염)]\n","  폭력범죄율: 평년 52.4 → 2018년 55.6 (+6.0% ↑)\n","  흉악범죄율: 평년 9.5 → 2018년 9.1 (-4.9% ↓)\n","  재산범죄율: 평년 144.3 → 2018년 134.4 (-6.8% ↓)\n","\n","[2020년 (역대급 장마)]\n","  폭력범죄율: 평년 52.4 → 2020년 48.8 (-6.9% ↓)\n","  흉악범죄율: 평년 9.5 → 2020년 8.4 (-11.9% ↓)\n","  재산범죄율: 평년 144.3 → 2020년 146.6 (+1.6% ↑)\n","\n","[2022년 (코로나해제+폭염)]\n","  폭력범죄율: 평년 52.4 → 2022년 47.2 (-9.9% ↓)\n","  흉악범죄율: 평년 9.5 → 2022년 11.6 (+21.2% ↑)\n","  재산범죄율: 평년 144.3 → 2022년 152.4 (+5.6% ↑)\n","\n"]}]},{"cell_type":"code","source":["# 추가 분석 1 — 범죄 유형 간 상관관계 시계열 변화\n","# 코로나 전/후로 세 범죄 간 상관이 달라졌는지 확인\n","\n","crime_vars  = ['violent_rate_working', 'heinous_rate_working', 'property_rate_working']\n","crime_names = ['폭력범죄율', '흉악범죄율', '재산범죄율']\n","\n","# 구간 분리\n","df_pre  = df[df.index < '2020-03-01']\n","df_post = df[df.index >= '2022-07-01']\n","df_full = df\n","\n","periods = {\n","    '전체 기간\\n(2014~2024)': df_full,\n","    '코로나 전\\n(2014~2020.02)': df_pre,\n","    '코로나 후\\n(2022.07~2024)': df_post\n","}\n","\n","fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n","\n","for ax, (label, df_sub) in zip(axes, periods.items()):\n","\n","    corr = df_sub[crime_vars].corr()\n","    corr.index   = crime_names\n","    corr.columns = crime_names\n","\n","    sns.heatmap(corr, ax=ax,\n","                annot=True, fmt='.3f',\n","                cmap='coolwarm',\n","                vmin=-1, vmax=1,\n","                linewidths=0.5,\n","                annot_kws={'size': 12})\n","    ax.set_title(f'{label}\\nn={len(df_sub)}', fontsize=11)\n","\n","plt.suptitle('범죄 유형 간 상관관계 — 코로나 전후 비교', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# 수치 출력\n","print(\"=== 범죄 유형 간 상관계수 코로나 전후 비교 ===\\n\")\n","pairs = [\n","    ('violent_rate_working', 'heinous_rate_working', '폭력 × 흉악'),\n","    ('violent_rate_working', 'property_rate_working', '폭력 × 재산'),\n","    ('heinous_rate_working', 'property_rate_working', '흉악 × 재산')\n","]\n","\n","for v1, v2, pname in pairs:\n","    r_full = df_full[[v1, v2]].corr().iloc[0, 1]\n","    r_pre  = df_pre[[v1, v2]].corr().iloc[0, 1]\n","    r_post = df_post[[v1, v2]].corr().iloc[0, 1]\n","    print(f\"[{pname}]\")\n","    print(f\"  전체: r={r_full:.3f}\")\n","    print(f\"  코로나 전: r={r_pre:.3f}\")\n","    print(f\"  코로나 후: r={r_post:.3f}\")\n","    print(f\"  변화: {r_pre:.3f} → {r_post:.3f} ({r_post-r_pre:+.3f})\\n\")\n","\n","# 롤링 상관계수 시각화 (12개월 이동 상관)\n","fig, axes = plt.subplots(3, 1, figsize=(14, 10))\n","pair_colors = ['purple', 'darkorange', 'teal']\n","\n","for ax, (v1, v2, pname), color in zip(axes, pairs, pair_colors):\n","\n","    rolling_corr = df[v1].rolling(window=12).corr(df[v2])\n","\n","    ax.plot(df.index, rolling_corr,\n","            color=color, linewidth=1.8, label=pname)\n","    ax.axhline(0, color='black', linewidth=0.8, linestyle='--')\n","    ax.axhline(0.5, color='gray', linewidth=0.8,\n","               linestyle=':', alpha=0.7, label='r=0.5 기준선')\n","    ax.axhline(-0.5, color='gray', linewidth=0.8,\n","               linestyle=':', alpha=0.7)\n","    ax.axvspan('2020-03-01', '2022-06-30',\n","               color='gray', alpha=0.15, label='코로나 구간')\n","    ax.set_title(f'{pname} — 12개월 롤링 상관계수')\n","    ax.set_ylabel('상관계수')\n","    ax.set_ylim(-1, 1)\n","    ax.legend(fontsize=9)\n","    ax.grid(alpha=0.3)\n","\n","plt.suptitle('범죄 유형 간 롤링 상관계수 (12개월)', fontsize=14)\n","plt.tight_layout()\n","plt.show()\n","\n","# 추가 분석 1 — 범죄 유형 간 상관관계 코로나 전후 변화 해석\n","#\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 전체 기간 상관 vs 구간별 상관의 역설\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 전체 기간(n=132)에서 폭력×흉악 r=0.235로 낮아 보이지만\n","# 코로나 전(r=0.852), 코로나 후(r=0.900) 모두 강한 양의 상관\n","# → 전체 r이 낮은 이유: 코로나 구간에서 폭력↓ 흉악↑로\n","#   두 변수가 반대 방향으로 움직이면서 전체 상관을 희석\n","# → 이는 심슨의 역설(Simpson's Paradox)과 유사한 현상\n","#   구간을 나누지 않으면 잘못된 해석 가능\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 폭력 × 흉악 (코로나 전 0.852 → 코로나 후 0.900)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 코로나 전후 모두 강한 양의 상관 유지 (+0.049 소폭 증가)\n","# · 롤링 그래프: 코로나 구간(2020~2022)에서 급락(0.5 수준)\n","#   후 회복 → 코로나가 일시적으로 두 범죄의 동조화를 깨뜨린 것\n","# · 해석: 폭력·흉악범죄는 기본적으로 동일한 사회적 요인에\n","#   반응하는 유사한 성격의 범죄\n","#   코로나 구간에서 폭력은 억제되고 흉악은 반동 상승하면서\n","#   일시적으로 상관이 낮아졌으나 이후 다시 동조화\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 폭력 × 재산 (코로나 전 0.480 → 코로나 후 0.089)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 코로나 전: r=0.480 → 중간 수준의 양의 상관\n","# · 코로나 후: r=0.089 → 사실상 무관계\n","# · 변화폭 -0.391로 가장 큰 변화\n","# · 해석: 코로나 전에는 폭력·재산범죄가 유사한 계절 패턴으로\n","#   함께 움직였으나, 코로나 이후 폭력은 낮은 수준 유지하고\n","#   재산은 강한 상승 추세로 완전히 다른 방향으로 분리\n","#   → 코로나가 두 범죄의 구조적 디커플링(decoupling)을 유발\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 흉악 × 재산 (코로나 전 0.556 → 코로나 후 0.091)\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# · 코로나 전: r=0.556 → 중간 수준의 양의 상관\n","# · 코로나 후: r=0.091 → 사실상 무관계\n","# · 변화폭 -0.465로 전체 쌍 중 가장 큰 변화\n","# · 롤링 그래프: 2022년 흉악 급등 시점에 상관이 0 이하로 급락\n","#   → 흉악은 2022년 이후 독자적 상승 패턴\n","#      재산은 2019년 이후 독자적 상승 패턴으로 서로 다른 원인\n","# · 해석: 코로나 이후 흉악·재산범죄가 각각 독립적인\n","#   구조적 요인에 의해 상승하면서 상관 소멸\n","\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 종합 인사이트\n","# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n","# 1. 코로나 이전: 세 범죄 유형이 유사한 계절·사회적 요인에\n","#    동조화되어 함께 움직이는 패턴\n","#    → 공통 원인(기상, 실업률 등)이 지배적\n","#\n","# 2. 코로나 이후: 폭력·흉악 동조화는 유지되나\n","#    재산범죄가 나머지 두 범죄와 완전히 분리\n","#    → 재산범죄는 코로나 이후 독자적 구조 변화(온라인 범죄,\n","#      경제적 양극화 등)에 의해 주도되는 것으로 해석\n","#\n","# 3. 기상 연구 관점에서의 함의:\n","#    기상변수가 세 범죄에 동일하게 작용한다는 가정이\n","#    코로나 이후에는 성립하지 않을 수 있음\n","#    → 특히 재산범죄에 대한 기상 효과 분석 시\n","#      코로나 이후 구간을 분리해서 해석 필요\n","#\n","# 4. 발표 활용:\n","#    \"코로나 이전에는 세 범죄가 기상·사회경제 요인에\n","#     함께 반응하는 동조화 패턴을 보였으나,\n","#     코로나 이후 재산범죄가 나머지 두 범죄와 완전히 분리되어\n","#     독자적 상승 추세를 나타냈다. 이는 코로나가 범죄 구조 자체를\n","#     변화시켰음을 시사하며, 코로나 이후 재산범죄의 기상 민감도가\n","#     낮아진 것과 일관된 결과다.\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"nq9TA5_B81yw","executionInfo":{"status":"ok","timestamp":1780285713897,"user_tz":-540,"elapsed":5197,"user":{"displayName":"허병철","userId":"16229972422120924818"}},"outputId":"e688ad14-1179-422c-d012-3b3d7bfcc44f"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x600 with 6 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["=== 범죄 유형 간 상관계수 코로나 전후 비교 ===\n","\n","[폭력 × 흉악]\n","  전체: r=0.235\n","  코로나 전: r=0.852\n","  코로나 후: r=0.900\n","  변화: 0.852 → 0.900 (+0.049)\n","\n","[폭력 × 재산]\n","  전체: r=-0.180\n","  코로나 전: r=0.480\n","  코로나 후: r=0.089\n","  변화: 0.480 → 0.089 (-0.391)\n","\n","[흉악 × 재산]\n","  전체: r=0.557\n","  코로나 전: r=0.556\n","  코로나 후: r=0.091\n","  변화: 0.556 → 0.091 (-0.465)\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]}]}